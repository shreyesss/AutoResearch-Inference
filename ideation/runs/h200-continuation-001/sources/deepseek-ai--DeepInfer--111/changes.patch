From f4789d7591948657520932765ed22de0ca96a9f0 Mon Sep 17 00:00:00 2001
From: Jahidul Hossain Mekat <jahidulhossainmekat@gmail.com>
Date: Tue, 20 Oct 2026 16:11:33 +0000
Subject: [PATCH 1/4] Look up many aborted requests with a hash instead of one
 scan per id

abort_sequence scanned `running` and `waiting` once per request id, so
aborting k requests cost k * (running + waiting) string comparisons. A burst of
aborts into a deep queue is when that hurts most (clients giving up on an
overloaded engine), and the engine does nothing else while it runs. With 1024
running sequences, aborting 1000 requests took 113 ms with 10k sequences
waiting and 1.4 s with 100k.

For more than 8 ids, build a hash of the ids and look each sequence up in it:
one pass over each queue. The sequences come back in the order the per-id scan
produced, by id, running before waiting, then queue order, and a repeated,
finished or unknown id aborts nothing. A handful of ids still use the plain
scan, which is cheaper than hashing every sequence. 1000 ids now take 1.9 ms
with 10k waiting and 7.6 ms with 100k.

The test aborts the same ids in one call and one by one and compares what comes
back, the statuses and the abort count, on both sides of the threshold.
---
 csrc/engine/scheduler.hpp             |  62 +++++++++++--
 tests/engine/test_scheduler_queues.py | 129 ++++++++++++++++++++++++++
 2 files changed, 181 insertions(+), 10 deletions(-)
 create mode 100644 tests/engine/test_scheduler_queues.py

diff --git a/csrc/engine/scheduler.hpp b/csrc/engine/scheduler.hpp
index ed6e897..f9cae1b 100644
--- a/csrc/engine/scheduler.hpp
+++ b/csrc/engine/scheduler.hpp
@@ -78,6 +78,8 @@ struct SchedulerOutputs {
 
 struct Scheduler {
     static constexpr float GPU_CACHE_PREFILL_WATERMARK = 0.9f;
+    /// abort_sequence looks a sequence up per id up to this many ids, and through a hash of the ids beyond that.
+    static constexpr size_t ABORT_SCAN_PER_ID_MAX_IDS = 8;
 
     Scheduler(int block_size, std::shared_ptr<BlockManager> block_manager, std::shared_ptr<BlockManager> state_manager, int eos_token_id,
         std::shared_ptr<c10d::ProcessGroup> dp_group, const py::object &scheduler_config, int truncate_len, int lookahead_tokens,
@@ -143,21 +145,61 @@ struct Scheduler {
 
     std::vector<SequencePtr> abort_sequence(std::vector<std::string> &request_ids) {
         std::vector<SequencePtr> abort_seqs;
+        auto abort_seq = [&](const SequencePtr &seq) {
+            // NOTE: We do NOT abort in PE, so we don't need to maintain
+            // store ids of aborted seqs to release in scheduler.
+            seq->schedule.status = SequenceStatus::FINISHED_ABORTED;
+            num_aborted += 1;
+            abort_seqs.push_back(seq);
+        };
         // 多模态处理失败的 seq 会带着 schedule.schedulable=false 滞留在 waiting，两个队列都要扫。
-        auto abort_in_queue = [&](auto &queue, auto &request_id) {
+        if (request_ids.size() <= ABORT_SCAN_PER_ID_MAX_IDS) {
+            auto abort_in_queue = [&](auto &queue, auto &request_id) {
+                for (auto &seq : queue) {
+                    if (seq->request.request_id == request_id && !seq->is_finished()) {
+                        abort_seq(seq);
+                    }
+                }
+            };
+            for (auto &request_id : request_ids) {
+                abort_in_queue(running, request_id);
+                abort_in_queue(waiting, request_id);
+            }
+            return abort_seqs;
+        }
+
+        // Scanning both queues once per id costs O(ids * (running + waiting)), a second or more for a burst of aborts with a deep
+        // queue. Look every sequence up in a hash of the ids instead. The result is ordered as above: by id, running before waiting,
+        // then queue order.
+        std::unordered_map<std::string_view, size_t> id_position;
+        id_position.reserve(request_ids.size());
+        for (size_t i = 0; i < request_ids.size(); ++i) {
+            id_position.emplace(request_ids[i], i); // a repeated id keeps its first position and finds nothing left to abort
+        }
+        struct Hit {
+            size_t id_position;
+            int queue; // 0: running, 1: waiting
+            const SequencePtr *seq;
+        };
+        std::vector<Hit> hits;
+        auto find_in_queue = [&](auto &queue, int which) {
             for (auto &seq : queue) {
-                if (seq->request.request_id == request_id && !seq->is_finished()) {
-                    // NOTE: We do NOT abort in PE, so we don't need to maintain
-                    // store ids of aborted seqs to release in scheduler.
-                    seq->schedule.status = SequenceStatus::FINISHED_ABORTED;
-                    num_aborted += 1;
-                    abort_seqs.push_back(seq);
+                if (seq->is_finished()) {
+                    continue;
+                }
+                if (auto it = id_position.find(seq->request.request_id); it != id_position.end()) {
+                    hits.push_back({it->second, which, &seq});
                 }
             }
         };
-        for (auto &request_id : request_ids) {
-            abort_in_queue(running, request_id);
-            abort_in_queue(waiting, request_id);
+        find_in_queue(running, 0);
+        find_in_queue(waiting, 1);
+        std::stable_sort(hits.begin(), hits.end(),
+            [](const Hit &a, const Hit &b) { return a.id_position != b.id_position ? a.id_position < b.id_position : a.queue < b.queue; });
+        for (const auto &hit : hits) {
+            if (!(*hit.seq)->is_finished()) { // the same sequence can sit in both queues
+                abort_seq(*hit.seq);
+            }
         }
         return abort_seqs;
     }
diff --git a/tests/engine/test_scheduler_queues.py b/tests/engine/test_scheduler_queues.py
new file mode 100644
index 0000000..ff3478c
--- /dev/null
+++ b/tests/engine/test_scheduler_queues.py
@@ -0,0 +1,129 @@
+"""Queue handling of the scheduler: aborting many requests in one call.
+
+Drives the real C++ scheduler on a CPU process group; no GPU or model is needed, only the compiled extension.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Generator
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+import torch.distributed as dist
+
+from deepinfer._C.engine import BlockManager, Scheduler, Sequence, SequenceMetadataPool, process_MTPInfo
+from deepinfer.sampling_params import SamplingParams
+
+pytestmark = [pytest.mark.ci, pytest.mark.ci_npu]
+
+EOS = 1
+VOCAB_SIZE = 1000
+GENERATED_TOKEN = 5  # never EOS, so requests end by max_tokens
+
+
+@pytest.fixture(scope="module")
+def cpu_group(tmp_path_factory: pytest.TempPathFactory) -> Generator[dist.ProcessGroup]:
+    initialized_here = not dist.is_initialized()
+    if initialized_here:
+        rendezvous = Path(tmp_path_factory.mktemp("rendezvous")) / "store"
+        dist.init_process_group("gloo", init_method=f"file://{rendezvous}", rank=0, world_size=1)
+    yield dist.new_group(ranks=[0], backend="gloo")
+    if initialized_here:
+        dist.destroy_process_group()
+
+
+class _Engine:
+    """schedule -> free finished sequences -> process outputs, without speculative decoding or zero-overhead scheduling."""
+
+    def __init__(self, group: dist.ProcessGroup, monkeypatch: pytest.MonkeyPatch, *, max_num_seqs: int = 4) -> None:
+        monkeypatch.setenv("DEEPINFER_USE_NEXTN_DECODE", "0")  # read by the C++ scheduler when it is built
+        self.block_size = 4
+        self.block_manager = BlockManager(4096)
+        config = SimpleNamespace(
+            max_model_len=64,
+            runtime_max_model_len=80,
+            max_num_batched_tokens=64,
+            max_num_seqs=max_num_seqs,
+            stop_preempted_request=False,
+            chunked_prefill=True,
+            engine_type=0,  # EngineType.NORMAL
+            prefill_attempt_interval=1,
+            prefill_any_attempt_interval=2,
+        )
+        self.scheduler = Scheduler(
+            self.block_size, self.block_manager, None, EOS, group, config, 0, 0, 2**30, None, [], 1, VOCAB_SIZE, False
+        )
+        self.pool = SequenceMetadataPool()
+        self.sequences: dict[str, Sequence] = {}
+
+    def make_request(self, request_id: str, max_tokens: int = 3, prompt_len: int = 6) -> Sequence:
+        prompt = np.full(prompt_len, 7, dtype=np.int32)
+        seq = Sequence(
+            seq_id=len(self.sequences), prompt_token_ids=prompt, compressed_prompt_token_ids=prompt, multi_modal_data=None,
+            block_size=self.block_size, request_id=request_id, user_id="user",
+            sampling_params=SamplingParams(max_tokens=max_tokens, eos_id=EOS), arrival_time=0.0, golden_token_ids=None,
+        )  # fmt: skip
+        self.sequences[request_id] = seq
+        return seq
+
+    def add_request(self, request_id: str, **kwargs: int) -> Sequence:
+        seq = self.make_request(request_id, **kwargs)
+        self.scheduler.add_sequence(seq)
+        return seq
+
+    def step(self) -> None:
+        seq_metadata_list, outputs = self.scheduler.schedule(self.pool)
+        for seq in outputs.finished_seqs:
+            self.scheduler.free_seq(seq)
+        n = len(outputs.scheduled_seqs)
+        process_MTPInfo(outputs, False, torch.zeros((n, 0), dtype=torch.int32), None)
+        self.scheduler.process_outputs(
+            outputs, torch.empty(0, dtype=torch.int32), torch.full((n,), GENERATED_TOKEN, dtype=torch.int32), None
+        )
+        self.pool.release(seq_metadata_list)
+
+    def waiting_ids(self) -> list[str]:
+        return [seq.request_id for seq in self.scheduler.waiting]
+
+    def statuses(self) -> dict[str, str]:
+        return {request_id: seq.status.name for request_id, seq in self.sequences.items()}
+
+
+def _engine_with_running_and_waiting(group: dist.ProcessGroup, monkeypatch: pytest.MonkeyPatch) -> _Engine:
+    """4 sequences decoding (max_num_seqs) and 36 waiting behind them; one of the running ones is already finished."""
+    engine = _Engine(group, monkeypatch)
+    engine.add_request("done", max_tokens=1)
+    for i in range(3):
+        engine.add_request(f"run{i}", max_tokens=50)
+    for _ in range(4):
+        engine.step()
+    assert engine.sequences["done"].status.name == "FINISHED_LENGTH_CAPPED"
+    for i in range(36):
+        engine.add_request(f"wait{i}", max_tokens=50)
+    return engine
+
+
+@pytest.mark.parametrize("num_ids", [1, 8, 9, 40])
+def test_aborting_many_ids_at_once_aborts_what_aborting_them_one_by_one_does(
+    cpu_group: dist.ProcessGroup, monkeypatch: pytest.MonkeyPatch, num_ids: int
+) -> None:
+    at_once = _engine_with_running_and_waiting(cpu_group, monkeypatch)
+    one_by_one = _engine_with_running_and_waiting(cpu_group, monkeypatch)
+    live = [f"run{i}" for i in range(3)] + [f"wait{i}" for i in range(36)]
+    rng = np.random.default_rng(num_ids)
+    # Live requests in any order, a repeated one, a finished one and some nobody knows: the last three must change nothing.
+    ids = [live[i] for i in rng.permutation(len(live))[: num_ids - 3 if num_ids > 4 else num_ids]]
+    if num_ids > 4:
+        ids += [ids[0], "done", "unknown"]
+
+    aborted = [seq.request_id for seq in at_once.scheduler.abort_sequence(list(ids))]
+    expected = [seq.request_id for request_id in ids for seq in one_by_one.scheduler.abort_sequence([request_id])]
+
+    assert aborted == expected
+    assert sorted(set(aborted)) == sorted(set(live) & set(ids))
+    assert at_once.statuses() == one_by_one.statuses()
+    assert at_once.scheduler.get_num_aborted_seqs() == one_by_one.scheduler.get_num_aborted_seqs() == len(aborted)
+    assert at_once.statuses()["done"] == "FINISHED_LENGTH_CAPPED"

From ef4386965be723a11a369e04a50ee800f9598e31 Mon Sep 17 00:00:00 2001
From: Jahidul Hossain Mekat <jahidulhossainmekat@gmail.com>
Date: Tue, 20 Oct 2026 16:13:09 +0000
Subject: [PATCH 2/4] Walk the waiting queue for finished sequences only when
 one can be in it

_schedule_decode walked the whole `waiting` queue on every decode step for
sequences that are already finished (aborted, or failed before they were
queued) so that they can be handed back. Each element is a pointer chase to a
separately allocated Sequence, so with a deep queue this is the largest part of
the step: with 1024 running sequences, the scheduler took 0.9 ms per step with
10k waiting and 2.0 ms with 100k, against 0.6 ms with none.

A finished sequence can only get into `waiting` through add_sequence (the
request failed before it was queued), abort_sequence and fork_seq. They now
raise a flag, and the walk is skipped unless it is up. It still runs on every
step while the queue is at most 1024 long, so ordinary queues behave as before,
and otherwise every 64 steps, as a safety net for a sequence that is finished
by some other means. A step now takes 0.7 ms with 10k waiting and 0.8 ms with
100k.

The tests check that a sequence aborted in a queue longer than 1024 (one id and
many), one added already finished, and one whose status is assigned behind the
scheduler's back (at the latest after a period) are all gone from the queue.
