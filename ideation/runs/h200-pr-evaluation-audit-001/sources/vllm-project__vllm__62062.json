    "locked": false,
    "title": "[Bugfix][Spec Decode] Keep data_parallel_index in DFlash/DSpark draft configs",
    "user": {
      "login": "faresobeid",
      "id": 111092724,
      "node_id": "U_kgDOBp8j9A",
      "avatar_url": "https://avatars.githubusercontent.com/u/111092724?v=4",
