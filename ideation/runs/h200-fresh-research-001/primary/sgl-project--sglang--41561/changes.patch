+inline cudaError_t make_tma_2d_tiled(
+    CUtensorMap* out,
+    const void* ptr, int rows, int cols, int box_rows, int box_cols,
+    int elem_bytes, CUtensorMapDataType dtype,
+    CUtensorMapSwizzle swizzle = CU_TENSOR_MAP_SWIZZLE_128B,
