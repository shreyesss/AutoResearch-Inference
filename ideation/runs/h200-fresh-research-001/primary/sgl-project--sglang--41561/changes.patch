+  // (cell.kv.hicache / data.kvMooncake), mirroring the generator's kv.py.
+  const LINKER_FLAGS = ["--enable-unified-cache-external-linker", "--unified-cache-external-linker-backend", "--hicache-storage-backend-extra-config"];
