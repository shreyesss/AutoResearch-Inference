+            );
+            let response = build_router(ctx.clone())
+                .oneshot(chat(false))
+                .await
+                .unwrap();
+            assert_eq!(response.status(), status);
+            assert_eq!(
+                [hit(&a), hit(&b)].iter().filter(|hit| **hit).count(),
+                1,
+                "reorg={reorg} status={status}"
+            );
+            assert_eq!(retries(&ctx), 0);
