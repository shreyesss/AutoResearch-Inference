+// This file is @generated by prost-build.
+/// A token-id sequence. int64 matches the servers' token id width (Rust
+/// `TokenIds = Vec<i64>`, Python `array("q")`).
+#[derive(Clone, PartialEq, Eq, Hash, ::prost::Message)]
+pub struct TokenIds {
+    #[prost(int64, repeated, tag = "1")]
+    pub ids: ::prost::alloc::vec::Vec<i64>,
+}
+/// Scalar-or-list carriers: `/generate` accepts every per-request field as one
+/// value (single request) or a list (batch). JSON flattens via the one_or_many
+/// option; gRPC clients pick the variant explicitly.
+#[derive(Clone, PartialEq, Eq, Hash, ::prost::Message)]
+pub struct StringOrList {
+    #[prost(oneof = "string_or_list::Value", tags = "1, 2")]
+    pub value: ::core::option::Option<string_or_list::Value>,
+}
+/// Nested message and enum types in `StringOrList`.
+pub mod string_or_list {
+    #[derive(Clone, PartialEq, Eq, Hash, ::prost::Oneof)]
+    pub enum Value {
+        #[prost(string, tag = "1")]
+        One(::prost::alloc::string::String),
+        #[prost(message, tag = "2")]
+        Many(super::StringList),
+    }
+}
+#[derive(Clone, PartialEq, Eq, Hash, ::prost::Message)]
+pub struct StringList {
+    #[prost(string, repeated, tag = "1")]
+    pub items: ::prost::alloc::vec::Vec<::prost::alloc::string::String>,
+}
+/// A flat string list for one request, or one list per batch entry. JSON:
+/// `\["a", "b"\]` is `one`; `\[["a"\], \["b", "c"]\]` is `many` (first element
+/// decides, `\[\]` is an empty `one`).
+#[derive(Clone, PartialEq, ::prost::Message)]
+pub struct StringListOrList {
+    #[prost(oneof = "string_list_or_list::Value", tags = "1, 2")]
+    pub value: ::core::option::Option<string_list_or_list::Value>,
+}
+/// Nested message and enum types in `StringListOrList`.
+pub mod string_list_or_list {
+    #[derive(Clone, PartialEq, ::prost::Oneof)]
+    pub enum Value {
+        #[prost(message, tag = "1")]
+        One(super::StringList),
+        #[prost(message, tag = "2")]
+        Many(super::StringListList),
+    }
+}
+#[derive(Clone, PartialEq, ::prost::Message)]
+pub struct StringListList {
+    #[prost(message, repeated, tag = "1")]
+    pub items: ::prost::alloc::vec::Vec<StringList>,
+}
+#[derive(Clone, PartialEq, Eq, Hash, ::prost::Message)]
+pub struct BoolOrList {
+    #[prost(oneof = "bool_or_list::Value", tags = "1, 2")]
+    pub value: ::core::option::Option<bool_or_list::Value>,
+}
+/// Nested message and enum types in `BoolOrList`.
+pub mod bool_or_list {
+    #[derive(Clone, PartialEq, Eq, Hash, ::prost::Oneof)]
+    pub enum Value {
+        #[prost(bool, tag = "1")]
+        One(bool),
+        #[prost(message, tag = "2")]
+        Many(super::BoolList),
+    }
+}
+#[derive(Clone, PartialEq, Eq, Hash, ::prost::Message)]
+pub struct BoolList {
+    #[prost(bool, repeated, tag = "1")]
+    pub items: ::prost::alloc::vec::Vec<bool>,
+}
+#[derive(Clone, PartialEq, Eq, Hash, ::prost::Message)]
+pub struct Int64OrList {
+    #[prost(oneof = "int64_or_list::Value", tags = "1, 2")]
+    pub value: ::core::option::Option<int64_or_list::Value>,
+}
+/// Nested message and enum types in `Int64OrList`.
+pub mod int64_or_list {
+    #[derive(Clone, PartialEq, Eq, Hash, ::prost::Oneof)]
+    pub enum Value {
+        #[prost(int64, tag = "1")]
+        One(i64),
+        #[prost(message, tag = "2")]
+        Many(super::Int64List),
+    }
+}
+#[derive(Clone, PartialEq, Eq, Hash, ::prost::Message)]
+pub struct Int64List {
+    #[prost(int64, repeated, tag = "1")]
+    pub items: ::prost::alloc::vec::Vec<i64>,
+}
+#[derive(Clone, PartialEq, ::prost::Message)]
+pub struct TokenIdsOrList {
+    #[prost(oneof = "token_ids_or_list::Value", tags = "1, 2")]
+    pub value: ::core::option::Option<token_ids_or_list::Value>,
+}
+/// Nested message and enum types in `TokenIdsOrList`.
+pub mod token_ids_or_list {
+    #[derive(Clone, PartialEq, ::prost::Oneof)]
+    pub enum Value {
+        #[prost(message, tag = "1")]
+        One(super::TokenIds),
+        #[prost(message, tag = "2")]
+        Many(super::TokenIdsList),
+    }
+}
+#[derive(Clone, PartialEq, ::prost::Message)]
+pub struct TokenIdsList {
+    #[prost(message, repeated, tag = "1")]
+    pub items: ::prost::alloc::vec::Vec<TokenIds>,
+}
+/// List variants whose ELEMENTS may be JSON null (PD bootstrap columns: a
+/// batch mixes bootstrapped and plain requests). Proto carries element
