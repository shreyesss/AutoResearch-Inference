From a3bcf3ae00b75a2954a7a2331f05e8b13bbe3b6c Mon Sep 17 00:00:00 2001
From: mgoin <mgoin64@gmail.com>
Date: Thu, 15 Oct 2026 17:18:17 +0000
Subject: [PATCH] [Perf][DeepSeek V4] Default to block FP8 MoE activations on
 Hopper with EP

DeepSeek V4 MXFP4 experts run on Humming with BF16 activations on SM90
unless VLLM_HUMMING_INPUT_QUANT_CONFIG is set. With expert parallel the
per-rank expert GEMMs are full size, and block FP8 (group 128)
activations are faster there. Default to them in that case; the env
override still takes precedence.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: mgoin <mgoin64@gmail.com>
---
 .../test_humming_mxfp4_block_fp8.py           | 39 +++++++++++++++++++
 .../layers/quantization/mxfp4.py              | 12 ++++++
 2 files changed, 51 insertions(+)

diff --git a/tests/quantization/test_humming_mxfp4_block_fp8.py b/tests/quantization/test_humming_mxfp4_block_fp8.py
index 74c266e0bfe5..96be6900596e 100644
--- a/tests/quantization/test_humming_mxfp4_block_fp8.py
+++ b/tests/quantization/test_humming_mxfp4_block_fp8.py
@@ -124,3 +124,42 @@ def test_default_activation_quant_config_defers_to_humming():
     )
     assert not qc.is_block_quantized
     assert qc.per_act_token_quant
+
+
+@pytest.mark.parametrize(
+    "routing,use_ep,expected",
+    [
+        ("DeepseekV4", True, kFp8Dynamic128Sym),
+        ("DeepseekV4", False, None),
+        ("TopK", True, None),
+    ],
+)
+def test_deepseek_v4_hopper_ep_defaults_to_block_fp8(
+    monkeypatch, routing, use_ep, expected
+):
+    """DeepSeek V4 MXFP4 experts on Humming default to block FP8 activations on
+    SM90 only with EP, where the full-size expert GEMMs gain from them."""
+    import dataclasses
+
+    from tests.kernels.moe.utils import make_dummy_moe_config
+    from vllm.model_executor.layers.fused_moe.config import RoutingMethodType
+    from vllm.model_executor.layers.fused_moe.oracle.mxfp4 import Mxfp4MoeBackend
+    from vllm.model_executor.layers.quantization import mxfp4
+    from vllm.platforms import current_platform
+
+    monkeypatch.setattr(
+        mxfp4,
+        "select_deepseek_v4_mxfp4_moe_backend",
+        lambda moe: (Mxfp4MoeBackend.HUMMING, None),
+    )
+    monkeypatch.setattr(
+        current_platform, "is_device_capability_family", lambda cap: cap == 90
+    )
+    moe = make_dummy_moe_config()
+    moe = dataclasses.replace(
+        moe,
+        routing_method=getattr(RoutingMethodType, routing),
+        moe_parallel_config=dataclasses.replace(moe.moe_parallel_config, use_ep=use_ep),
+    )
+
+    assert mxfp4.Mxfp4MoEMethod(moe).activation_key == expected
diff --git a/vllm/model_executor/layers/quantization/mxfp4.py b/vllm/model_executor/layers/quantization/mxfp4.py
index 8f42f2397046..8cb92f8987c4 100644
--- a/vllm/model_executor/layers/quantization/mxfp4.py
+++ b/vllm/model_executor/layers/quantization/mxfp4.py
@@ -17,6 +17,7 @@
 )
 from vllm.model_executor.layers.fused_moe import modular_kernel as mk
 from vllm.model_executor.layers.fused_moe.config import (
+    RoutingMethodType,
     mxfp4_w4a16_moe_quant_config,
 )
 from vllm.model_executor.layers.fused_moe.moe_output import UnfinalizedMoEOutput
@@ -41,6 +42,7 @@
 from vllm.model_executor.layers.quantization.utils.quant_utils import (
     QuantKey,
     is_layer_skipped,
+    kFp8Dynamic128Sym,
 )
 from vllm.model_executor.utils import (
     is_weights_pre_processed,
@@ -576,6 +578,16 @@ def __init__(self, moe: FusedMoEConfig, activation_key: QuantKey | None = None):
             self.mxfp4_backend, self.experts_cls = select_deepseek_v4_mxfp4_moe_backend(
                 moe
             )
+        if (
+            self.activation_key is None
+            and self.mxfp4_backend == Mxfp4MoeBackend.HUMMING
+            and moe.routing_method == RoutingMethodType.DeepseekV4
+            and moe.moe_parallel_config.use_ep
+            and current_platform.is_device_capability_family(90)
+        ):
+            # Full-size DeepSeek V4 experts under EP run faster on Hopper with
+            # block FP8 activations than with Humming's default BF16.
+            self.activation_key = kFp8Dynamic128Sym
 
         self.max_capture_size = moe.max_capture_size
 
