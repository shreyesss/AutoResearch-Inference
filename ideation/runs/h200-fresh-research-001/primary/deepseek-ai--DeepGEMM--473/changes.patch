+                            ptx::red_add_rel(pending_arrival_ptr, pending_arrival_add);
+                            pending_arrival_ptr = nullptr;
+                            trace_dispatch(9, 1ull | (static_cast<uint64_t>(token_idx) << 8));   // PUBLISH (aux = rows | token_idx << 8)
