+        if self._failed or self._encoder is None:
+            return None
+        try:
+            self._encoder.close()
+        except Exception:
+            self._fail()
+            return None
+        logger.info(f"Output saved to {CYAN}{self.save_file_path}{RESET}")
+        return [self.save_file_path]
+
+    def abort(self) -> None:
+        if self._encoder is not None:
+            self._encoder.abort()
