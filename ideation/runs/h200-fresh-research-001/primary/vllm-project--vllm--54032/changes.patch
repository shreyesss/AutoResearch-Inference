 def _user_moe_activation_override() -> QuantKey | None:
@@ -695,6 +704,7 @@ def mxfp4_round_up_hidden_size_and_intermediate_size(
     elif backend in (
         Mxfp4MoeBackend.FLASHINFER_CUTLASS_MXFP4_BF16,
