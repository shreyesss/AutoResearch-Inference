+        assert _same_selection(got, _ref_select(sc, comp_lens, topk_tokens), sc), f"seq{si}: consumer top-k differs beyond ties"
+
+    # ---- decode: last token of each sequence plus an MTP twin of seq1 (row 2 = position L-2)
+    rows_seq = [0, 1, 1]
