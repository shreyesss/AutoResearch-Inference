From dcbb047275eb816e91e374aad5b187dda4caad16 Mon Sep 17 00:00:00 2001
From: Shuolei Wang <shuoleiwang123@gmail.com>
Date: Wed, 14 Oct 2026 01:03:37 +0800
Subject: [PATCH] [Perf][Kernel] Tune fused mHC post + pre-norm for SM90 at up
 to 8 tokens

Signed-off-by: Shuolei Wang <shuoleiwang123@gmail.com>
---
 tests/kernels/mhc/test_mhc_jit_warmup.py      | 41 ++++++++++++++-----
 .../kernels/mhc/tilelang_kernels.py           | 33 ++++++++++++---
 2 files changed, 58 insertions(+), 16 deletions(-)

diff --git a/tests/kernels/mhc/test_mhc_jit_warmup.py b/tests/kernels/mhc/test_mhc_jit_warmup.py
index 512b3e6ba53a..b70d2b871d9f 100644
--- a/tests/kernels/mhc/test_mhc_jit_warmup.py
+++ b/tests/kernels/mhc/test_mhc_jit_warmup.py
@@ -114,21 +114,24 @@ def test_mhc_pre_big_fuse_dispatch_matches_legacy_runtime_config(
     )
 
 
+IS_SM90 = current_platform.is_cuda() and current_platform.is_device_capability(90)
+
+
 @pytest.mark.parametrize(
-    ("num_tokens", "hidden_size", "expected_tile_n", "expected_n_splits"),
+    ("num_tokens", "hidden_size", "expected", "expected_sm90"),
     [
-        (1, 4096, 2, 8),
-        (4, 8192, 2, 8),
-        (8, 5120, 2, 8),
-        (16, 5120, 6, 8),
-        (32, 7168, 6, 8),
+        (1, 4096, (2, 8, 128), (12, 8, 256)),
+        (4, 8192, (2, 8, 128), (12, 16, 256)),
+        (8, 5120, (2, 8, 128), (12, 10, 256)),
+        (16, 5120, (6, 8, 128), (6, 8, 128)),
+        (32, 7168, (6, 8, 128), (6, 8, 128)),
     ],
 )
 def test_mhc_fused_dispatch_matches_the_launch_config(
     num_tokens: int,
     hidden_size: int,
-    expected_tile_n: int,
-    expected_n_splits: int,
+    expected: tuple[int, int, int],
+    expected_sm90: tuple[int, int, int],
 ) -> None:
     """The compile key must be the config the launch will actually use.
 
@@ -140,7 +143,7 @@ def test_mhc_fused_dispatch_matches_the_launch_config(
         num_tokens, hidden_size, hc_mult=4
     )
 
-    assert (tile_n, n_splits) == (expected_tile_n, expected_n_splits)
+    assert (tile_n, n_splits, n_thr) == (expected_sm90 if IS_SM90 else expected)
     assert kernel.dispatch(
         num_tokens=num_tokens,
         hidden_size=hidden_size,
@@ -286,6 +289,17 @@ def test_mhc_fused_declines_shapes_it_cannot_tile() -> None:
                 n_thr=128,
             ),
         ),
+        pytest.param(
+            MhcFusedTileLangKernel(),
+            MhcFusedTileLangKernel.CompileKey(
+                hidden_size=5120,
+                hc_mult=4,
+                n_splits=10,
+                tile_n=12,
+                n_thr=256,
+            ),
+            marks=pytest.mark.skipif(not IS_SM90, reason="SM90-only band"),
+        ),
         (
             HcHeadFusedTileLangKernel(),
             HcHeadFusedTileLangKernel.CompileKey(
@@ -317,9 +331,14 @@ def test_tilelang_warmup_inputs_reproduce_compile_key(
     monkeypatch.setattr(
         jit_warmup_tilelang_helper,
         "compile_tilelang",
-        lambda jit_impl, *args, **kwargs: compiled.append(jit_impl),
+        lambda jit_impl, *args, **kwargs: compiled.append((jit_impl, kwargs)),
     )
 
     kernel.compile(compile_key)
 
-    assert compiled == [expected_kernel]
+    assert [jit_impl for jit_impl, _ in compiled] == [expected_kernel]
+    if isinstance(kernel, MhcFusedTileLangKernel):
+        # The warmup must compile the key's own variant, not one of a neighbour.
+        assert compiled[0][1] == dict(
+            n_thr=compile_key.n_thr, tile_n=compile_key.tile_n
+        )
diff --git a/vllm/model_executor/kernels/mhc/tilelang_kernels.py b/vllm/model_executor/kernels/mhc/tilelang_kernels.py
index f7f560f50dd9..cc4a4d7b18b6 100644
--- a/vllm/model_executor/kernels/mhc/tilelang_kernels.py
+++ b/vllm/model_executor/kernels/mhc/tilelang_kernels.py
@@ -59,9 +59,12 @@ def compute_num_split(block_k: int, k: int | None, grid_size: int) -> int:
 # (hc_mult 4, hidden_size 5120 and 7168) against the separate post + split-k
 # GEMM it replaces; the bands are coarse because the loss against a per-shape
 # optimum is ~1-2%, while one fixed config gives up to 18% at the top of the
-# range.
+# range. SM90 (H20, hidden 4096-7168) takes two projection tiles over 512-wide
+# k-slices up to 8 tokens: every tile redoes the post mapping over its k-slice,
+# and two 256-thread round trips per block beat twelve tiles of four to seven.
 _FUSED_POST_PRE_N_THR = 128
 _FUSED_POST_PRE_MAX_TOKENS = 32
+_SM90_FUSED_POST_PRE_MAX_TOKENS = 8
 
 
 def mhc_fused_post_pre_split_config(
@@ -76,6 +79,15 @@ def mhc_fused_post_pre_split_config(
     """
     if num_tokens > _FUSED_POST_PRE_MAX_TOKENS:
         return None
+    mix_size = hc_mult * (hc_mult + 2)
+    if (
+        num_tokens <= _SM90_FUSED_POST_PRE_MAX_TOKENS
+        and mix_size % 12 == 0
+        and hidden_size % 512 == 0
+        and current_platform.is_cuda()
+        and current_platform.is_device_capability(90)
+    ):
+        return 12, hidden_size // 512, 256
     n_thr = _FUSED_POST_PRE_N_THR
     if hidden_size % n_thr:
         return None
@@ -87,7 +99,6 @@ def mhc_fused_post_pre_split_config(
     else:
         tile_n, n_splits = 6, 8
     # The kernel drops projection tiles and k-slices it cannot fill evenly.
-    mix_size = hc_mult * (hc_mult + 2)
     while tile_n > 1 and mix_size % tile_n:
         tile_n -= 1
     while n_splits > 1 and hidden_size % (n_splits * n_thr):
@@ -1437,10 +1448,15 @@ def get_warmup_keys(
         )
         return self._trace_dispatch(self.dispatch)(
             warmup_cases,
+            # Every fused token count, so every split the fused GEMM picks.
             num_tokens=WarmupIntRange(
                 1,
                 max_tokens + 1,
-                advance=lambda value: 8 if value < 8 else cdiv(value, 64) * 64 + 1,
+                advance=lambda value: (
+                    value + 1
+                    if value < _FUSED_POST_PRE_MAX_TOKENS
+                    else cdiv(value, 64) * 64 + 1
+                ),
             ),
             n_splits=1,
             hidden_size=hidden_size,
@@ -1456,7 +1472,7 @@ def get_warmup_keys(
             if broadcast_norm_eps is not None
             else norm_eps,
             _when=lambda *, use_fused_tilelang, num_tokens: (
-                not use_fused_tilelang or num_tokens <= 16
+                not use_fused_tilelang or num_tokens <= _FUSED_POST_PRE_MAX_TOKENS
             ),
         )
 
@@ -1706,9 +1722,16 @@ def get_warmup_keys(
         )
 
     def warmup_inputs(self, compile_key: CompileKey) -> dict[str, Any]:
-        num_tokens = 1 if compile_key.tile_n == 2 else 16
         hidden_size = compile_key.hidden_size
         hc_mult = compile_key.hc_mult
+        # __call__ derives the config from the token count, so warm with one
+        # that selects this key's config.
+        config = (compile_key.tile_n, compile_key.n_splits, compile_key.n_thr)
+        num_tokens = next(
+            t
+            for t in range(1, _FUSED_POST_PRE_MAX_TOKENS + 1)
+            if mhc_fused_post_pre_split_config(t, hidden_size, hc_mult) == config
+        )
         hc_mult3 = hc_mult * (2 + hc_mult)
         comb_mix = make_tilelang_warmup_tensor(
             torch.float32, num_tokens, hc_mult, hc_mult
