    "title": "perf: Use full-rate FADD relu in SM90 FP8 MQA logits epilogue",
    "user": {
      "login": "Chtholly-Boss",
      "id": 111423039,
      "node_id": "U_kgDOBqQuPw",
      "avatar_url": "https://avatars.githubusercontent.com/u/111423039?v=4",
