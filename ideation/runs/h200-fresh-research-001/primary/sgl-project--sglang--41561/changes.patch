+    tri_sub_pool_specs,
+)
+
+register_cpu_ci(est_time=10, suite="base-a-test-cpu")
+
+
+def build_geometry(ps, ratio, lazy, pattern, gate):
+    fs, ss, ms = tri_sub_pool_specs(
+        full_layer_num=ratio[0],
