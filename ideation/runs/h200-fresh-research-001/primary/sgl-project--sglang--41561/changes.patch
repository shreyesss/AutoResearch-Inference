+    layer = RowParallelLinear(
+        12288, 3072, bias=True, quant_config=config, prefix="blocks.0.ffn.net.2"
+    )
+    assert isinstance(layer.quant_method, ConvRotInt8JitLinearMethod)
+    assert config.selected == ["blocks.0.ffn.net.2"]
