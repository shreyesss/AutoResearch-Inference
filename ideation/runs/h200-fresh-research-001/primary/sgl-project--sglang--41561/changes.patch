+    batch = Req(sampling_params=params)
+    batch.extra[SR_VIDEO_KEY] = video.clone()
+    batch.extra[SR_TILING_SCALE_KEY] = 2
+    batch.extra[SR_REQUESTED_HW_KEY] = (video.shape[-2], video.shape[-1])
