  "title": "[Bugfix][Spec Decode] Keep a full uniform-decode batch reachable by FULL graphs",
  "user": {
    "login": "abmfy",
    "id": 20623941,
    "node_id": "MDQ6VXNlcjIwNjIzOTQx",
    "avatar_url": "https://avatars.githubusercontent.com/u/20623941?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/abmfy",
    "html_url": "https://github.com/abmfy",
    "followers_url": "https://api.github.com/users/abmfy/followers",
    "following_url": "https://api.github.com/users/abmfy/following{/other_user}",
    "gists_url": "https://api.github.com/users/abmfy/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/abmfy/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/abmfy/subscriptions",
    "organizations_url": "https://api.github.com/users/abmfy/orgs",
    "repos_url": "https://api.github.com/users/abmfy/repos",
    "events_url": "https://api.github.com/users/abmfy/events{/privacy}",
