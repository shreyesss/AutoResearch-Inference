+def _metrics(request_id: str) -> SimpleNamespace:
+    return SimpleNamespace(
+        request_id=request_id,
+        stages={"DenoisingStage": 1.0},
+        denoising_stages={"DenoisingStage"},
+        steps=[1.0],
+        memory_snapshots={},
