+  // ==== 2. Shell formatting ====
+  const quote = (v) => {
+    const s = String(v);
+    if (/^[A-Za-z0-9_@%+=:,./-]+$/.test(s)) return s;
+    if (/^[A-Za-z0-9_@%+=:,./${}-]+$/.test(s)) return `"${s}"`; // keep $PLACEHOLDERS expandable
