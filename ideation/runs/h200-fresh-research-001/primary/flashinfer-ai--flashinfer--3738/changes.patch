+
+    x_fp32 = torch.randn(m, k, dtype=torch.float32, device=device) * 0.05
+    x = x_fp32.to(torch.float8_e4m3fn)
+    w1 = torch.randint(0, 256, (e, 2 * n, k // 2), device=device, dtype=torch.uint8)
