+import torch
+from kandinsky6_sr_release_configs import (
+    DISTILLED_MODEL_INDEX,
+    DISTILLED_SCHEDULER_CONFIG,
+    DISTILLED_TRANSFORMER_CONFIG,
+    FLOW_MODEL_INDEX,
+    FLOW_SCHEDULER_CONFIG,
