+        self.assertIsNone(
+            self._run(
+                [(40, {"type": "stop"})],
+                stream=True,
+                prefill_finished_time=produced,
+            )
+        )
+        # Non-streaming: decode runs from the scheduler's first-token time.
+        self.assertGreater(
+            self._run([(40, {"type": "stop"})], prefill_finished_time=produced),
+            0.0,
+        )
