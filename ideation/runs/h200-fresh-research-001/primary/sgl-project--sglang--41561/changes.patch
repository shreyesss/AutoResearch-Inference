+            bs = int(self.rpi.numel())
+            for reader in (self.target, self.fused_draft):
+                # What a packed stream gathers from, and a captured table.
+                reader.read_source(plan, req_pool_indices=self.rpi, bs=bs + 1)
+                reader.read_table(plan)
