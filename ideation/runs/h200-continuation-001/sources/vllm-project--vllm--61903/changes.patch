-    mask = 0xFFFF0000
-    bits = w.to(tl.uint32, bitcast=True)
-    rem = w - (bits & mask).to(tl.float32, bitcast=True)
-    rem_bits = rem.to(tl.uint32, bitcast=True)
-    lo = rem - (rem_bits & mask).to(tl.float32, bitcast=True)
