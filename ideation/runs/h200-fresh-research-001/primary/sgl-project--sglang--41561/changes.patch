+register_cuda_ci(est_time=240, stage="weekly", runner_config="4-gpu-h100")
+
+
+class TestBCGWithMTP(PCGSpecBase, unittest.TestCase):
+    """BCG (default prefill backend) + MTP (NEXTN) on Qwen3.5-35B-A3B, FP8."""
