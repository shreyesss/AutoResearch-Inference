+"""Helpers for the SM90 block32 FP8 GEMM tests and microbenchmarks.
+
+Operand formats follow DeepInfer: activations 1x32 with packed UE8M0 int32 scales (MN-major,
+TMA-aligned) and weights with 32x32 UE8M0 block scales (fp32 here, as the HF loader keeps
+them in ``param.sf``). The torch quantizer repeats the official reference's ``act_quant``
+(block 32, ``scale_fmt="ue8m0"``): power-of-two scale of max(amax, 1e-4) / 448.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import struct
+import sys
+from typing import Any
+
+import torch
+
+# Checkpoint directory (weights + the official `inference/` reference); real-weight and reference
+# checks are skipped when unset.
+HF_DIR = os.environ.get("DEEPINFER_HF_MODEL_DIR", "")
+
+# Every non-expert FP8 linear of V4.1 Flash as DeepInfer builds it (DP8: no TP split):
+# name -> (N, K, [(hf weight names concatenated along N)])
+REAL_SHAPES = {
+    "q_a_kv_swa": (1792, 5120, ["layers.{L}.attn.wq_a.weight", "layers.{L}.attn.wkv.weight"]),
+    "dflash_main_kv": (1536, 5120, ["mtp.0.attn.wkv.weight", "mtp.1.attn.wkv.weight", "mtp.2.attn.wkv.weight"]),
+    "q_b": (32768, 1280, ["layers.{L}.attn.wq_b.weight"]),
+    "q_b_index": (36864, 1280, ["layers.2.attn.wq_b.weight", "layers.2.attn.indexer.wq_b.weight"]),
+    "wo_b": (5120, 8192, ["layers.{L}.attn.wo_b.weight"]),
+    "shared_gate_up": (4608, 5120, ["layers.{L}.ffn.shared_experts.w1.weight", "layers.{L}.ffn.shared_experts.w3.weight"]),
+    "shared_down": (5120, 2304, ["layers.{L}.ffn.shared_experts.w2.weight"]),
+    "engram_kv": (25600, 6144, ["layers.1.engram.wkv.weight"]),
+    "mtp_projection": (5120, 15360, ["mtp.0.main_proj.weight"]),
+}
+# wo_a: einsum "bhr,hdr->bhd" over 8 groups of [1024, 4096]
+WO_A = (8, 1024, 4096, "layers.{L}.attn.wo_a.weight")
+
+FP8_MAX = 448.0
+
+
+def ue8m0_round(sf: torch.Tensor) -> torch.Tensor:
+    bits = sf.contiguous().view(torch.int32)
+    e = ((bits >> 23) & 255) + ((bits & 0x7FFFFF) != 0).to(torch.int32)
+    return (e << 23).view(torch.float32)
+
+
+def quant_act_1x32(x: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """bf16 [M, K] -> (e4m3 [M, K], fp32 power-of-two scales [M, K / 32])."""
+    m, k = x.shape
+    xf = x.float().view(m, k // 32, 32)
+    amax = xf.abs().amax(-1).clamp_min(1e-4)
+    scale = ue8m0_round(amax * torch.tensor(1.0 / FP8_MAX, dtype=torch.float32))
+    q = (xf / scale[..., None]).clamp(-FP8_MAX, FP8_MAX).to(torch.float8_e4m3fn)
+    return q.view(m, k), scale
+
+
+def quant_weight_32x32(w: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """bf16 [N, K] -> (e4m3 [N, K], fp32 power-of-two block scales [N / 32, K / 32])."""
+    n, k = w.shape
+    wf = w.float().view(n // 32, 32, k // 32, 32)
+    amax = wf.abs().amax(dim=(1, 3)).clamp_min(1e-4)
+    scale = ue8m0_round(amax * torch.tensor(1.0 / FP8_MAX, dtype=torch.float32))
+    q = (wf / scale[:, None, :, None]).clamp(-FP8_MAX, FP8_MAX).to(torch.float8_e4m3fn)
+    return q.view(n, k), scale
+
+
+def pack_ue8m0_mn_major(scale: torch.Tensor) -> torch.Tensor:
+    """fp32 power-of-two [M, K / 32] -> DeepInfer packed int32 [M, K / 128], strides (1, Mpad)."""
+    m, g = scale.shape
+    assert g % 4 == 0
+    e = (scale.contiguous().view(torch.int32) >> 23).to(torch.uint8)
+    words = e.view(m, g // 4, 4).contiguous().view(torch.int32).view(m, g // 4)
+    mpad = (m + 3) // 4 * 4
+    buf = torch.zeros((g // 4, mpad), dtype=torch.int32, device=scale.device)
+    buf[:, :m].copy_(words.t())
+    return buf[:, :m].t()
+
+
+def unpack_ue8m0(words: torch.Tensor) -> torch.Tensor:
+    """packed int32 [M, K / 128] (any strides) -> fp32 [M, K / 32]."""
+    m, kb = words.shape
+    b = words.contiguous().view(torch.uint8).view(m, kb * 4).to(torch.int32)
+    return (b << 23).view(torch.float32)
+
+
+def mn_major_fp32(scale: torch.Tensor) -> torch.Tensor:
+    """fp32 [M, G] -> same values, MN-major TMA-aligned (strides (1, Mpad))."""
+    m, g = scale.shape
+    mpad = (m + 3) // 4 * 4
+    buf = torch.zeros((g, mpad), dtype=torch.float32, device=scale.device)
+    buf[:, :m].copy_(scale.t())
+    return buf[:, :m].t()
+
+
+def dequant_act(q: torch.Tensor, scale: torch.Tensor) -> torch.Tensor:
+    m, k = q.shape
+    return (q.float().view(m, k // 32, 32) * scale[..., None]).view(m, k)
+
+
+def dequant_weight(q: torch.Tensor, scale: torch.Tensor) -> torch.Tensor:
+    n, k = q.shape
+    return (q.float().view(n // 32, 32, k // 32, 32) * scale[:, None, :, None]).view(n, k)
+
+
+def cosine(a: torch.Tensor, b: torch.Tensor) -> float:
+    a = a.double().flatten()
+    b = b.double().flatten()
+    return float((a @ b) / (a.norm() * b.norm()).clamp_min(1e-300))
+
+
+def rel_err(out: torch.Tensor, ref: torch.Tensor) -> float:
+    """Relative L2 error ||out - ref|| / ||ref|| (catches scale errors that the cosine ignores)."""
+    d = out.double().flatten() - ref.double().flatten()
+    return float(d.norm() / ref.double().norm().clamp_min(1e-300))
+
+
+def err_stats(out: torch.Tensor, ref: torch.Tensor) -> dict:
+    d = (out.float() - ref.float()).abs()
+    scale = ref.float().abs().max().clamp_min(1e-30)
+    return {
+        "cos": cosine(out, ref),
+        "max_abs": float(d.max()) if d.numel() else 0.0,
+        "max_rel_to_absmax": float(d.max() / scale) if d.numel() else 0.0,
+        "bitwise_frac": float(
+            (
+                out.view(torch.int16 if out.element_size() == 2 else torch.uint8)
+                == ref.to(out.dtype).view(torch.int16 if out.element_size() == 2 else torch.uint8)
+            )
+            .float()
+            .mean()
+        )
+        if out.dtype == ref.dtype
+        else None,
+    }
+
+
+# ------------------------------------------------------------------ real checkpoint weights
+_index_cache: dict = {}
+
+
+def _weight_map() -> dict:
+    if "map" not in _index_cache:
+        with open(os.path.join(HF_DIR, "model.safetensors.index.json")) as f:
+            _index_cache["map"] = json.load(f)["weight_map"]
+    return _index_cache["map"]
+
+
+def _read_tensor(name: str) -> torch.Tensor:
+    shard = os.path.join(HF_DIR, _weight_map()[name])
+    with open(shard, "rb") as fh:
+        n = struct.unpack("<Q", fh.read(8))[0]
+        hdr = json.loads(fh.read(n))
+        meta = hdr[name]
+        start, end = meta["data_offsets"]
+        fh.seek(8 + n + start)
+        raw = fh.read(end - start)
+    dt = {"F8_E4M3": torch.float8_e4m3fn, "F8_E8M0": torch.uint8, "BF16": torch.bfloat16, "F32": torch.float32}[meta["dtype"]]
+    return torch.frombuffer(bytearray(raw), dtype=dt).view(meta["shape"])
+
+
+def load_real_fp8(names: list[str], layer: int = 3, device: str = "cuda") -> tuple[torch.Tensor, torch.Tensor]:
+    """FP8 weight [N, K] and fp32 block scales [N / 32, K / 32] (rows concatenated in order)."""
+    ws, ss = [], []
+    for nm in names:
+        nm = nm.format(L=layer)
+        w = _read_tensor(nm)
+        s = _read_tensor(nm[: -len("weight")] + "scale")
+        ws.append(w)
+        ss.append((s.to(torch.int32) << 23).view(torch.float32))
+    return torch.cat(ws).to(device).contiguous(), torch.cat(ss).to(device).contiguous()
+
+
+def official_kernel_module() -> Any:
+    """The official reference's inference/kernel.py (TileLang), or None if unavailable."""
+    if not HF_DIR:
+        return None
+    path = os.path.join(HF_DIR, "inference")
+    if not os.path.exists(os.path.join(path, "kernel.py")):
+        return None
+    if path not in sys.path:
+        sys.path.insert(0, path)
+    try:
+        import kernel  # type: ignore
+
+        return kernel
+    except Exception as e:  # noqa: BLE001
+        print(f"official kernel unavailable: {e!r}")
+        return None
diff --git a/examples/sm90/bench_fp8_block32_gemm.py b/examples/sm90/bench_fp8_block32_gemm.py
new file mode 100644
index 0000000..70be961
--- /dev/null
+++ b/examples/sm90/bench_fp8_block32_gemm.py
@@ -0,0 +1,335 @@
+"""Microbenchmark: SM90 block32 FP8 GEMM (DeepInfer formats), optionally against the SM90 block32
+``fp8_gemm_nt(recipe=(1, 32, 32))`` of the public ``sgl-deep-gemm`` package (PyPI, >= 0.2.2; it installs
+as ``deep_gemm``, so ``--sgl`` needs an environment where that package provides ``deep_gemm``).
+
+Each timing is a CUDA-graph replay of back-to-back calls that rotate over enough weight copies
+to defeat L2 (decode-sized M), divided by the number of calls. ``--real`` uses checkpoint weights
+from ``DEEPINFER_HF_MODEL_DIR``.
+
+    python examples/sm90/bench_fp8_block32_gemm.py [--m 1 8 64 512 4096 16384] [--shapes ...] [--sgl]
+    python examples/sm90/bench_fp8_block32_gemm.py --sweep --shapes q_b --m 64   # config search
+"""
+
+from __future__ import annotations
+
+import argparse
+import functools
+import json
+import sys
+from pathlib import Path
+from typing import Any
+
+import torch
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(REPO_ROOT))
+
+from deepinfer.model_executor.layers.sm90_ops.fp8_block32_gemm import (
+    Block32Config,
+    fp8_block32_gemm,
+    num_tiles,
+)
+from examples.sm90 import _block32_utils as U
+
+L2_DEFEAT_BYTES = 256 << 20
+
+
+def time_graph(fns: list, reps: int = 0, replays: int = 5) -> float:
+    """us per call of a CUDA graph cycling through ``fns``."""
+    reps = reps or max(len(fns), 20)
+    for f in fns:
+        f()
+    torch.cuda.synchronize()
+    stream = torch.cuda.Stream()
+    stream.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(stream):
+        for f in fns:  # warm inside the side stream too
+            f()
+        g = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(g, stream=stream):
+            for i in range(reps):
+                fns[i % len(fns)]()
+    torch.cuda.current_stream().wait_stream(stream)
+    g.replay()
+    torch.cuda.synchronize()
+    start, end = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    best = float("inf")
+    for _ in range(replays):
+        start.record()
+        g.replay()
+        end.record()
+        end.synchronize()
+        best = min(best, start.elapsed_time(end) * 1e3 / reps)
+    return best
+
+
+def make_case(name: str, m: int, real: bool, group: bool = False) -> dict:
+    gen = torch.Generator(device="cuda").manual_seed(0)
+    if group:
+        g, d, r, hf = U.WO_A
+        n, k, kx = g * d, r, g * r
+        names = [hf]
+    else:
+        n, k, names = U.REAL_SHAPES[name]
+        kx = k
+    if real:
+        wq, ws = U.load_real_fp8(names)
+    else:
+        wq, ws = U.quant_weight_32x32((torch.randn((n, k), generator=gen, device="cuda") * 0.02).to(torch.bfloat16))
+    copies = 1 if m >= 4096 else max(1, min(32, -(-L2_DEFEAT_BYTES // wq.numel())))
+    wqs = [wq] + [wq.clone() for _ in range(copies - 1)]
+    wss = [ws] + [ws.clone() for _ in range(copies - 1)]
+    x = (torch.randn((m, kx), generator=gen, device="cuda")).to(torch.bfloat16)
+    xq, xs = U.quant_act_1x32(x)
+    return dict(n=n, k=k, kx=kx, wqs=wqs, wss=wss, xq=xq, xs=xs, words=U.pack_ue8m0_mn_major(xs), xs_mn=U.mn_major_fp32(xs))
+
+
+def bench_ours(case: dict, m: int, cfg: Block32Config | None = None, group_n: int = 0) -> float:
+    n = case["n"]
+    if group_n:
+        out = torch.empty((m, n), dtype=torch.float8_e4m3fn, device="cuda")
+        mpad = (m + 3) // 4 * 4
+        out_sf = torch.empty_strided((m, n // 128), (1, mpad), dtype=torch.int32, device="cuda")
+    else:
+        out = torch.empty((m, n), dtype=torch.bfloat16, device="cuda")
+        out_sf = None
+    fns = [
+        (lambda w=w, s=s: fp8_block32_gemm(case["xq"], case["words"], w, s, out, out_sf=out_sf, group_n=group_n, config=cfg))
+        for w, s in zip(case["wqs"], case["wss"], strict=True)
+    ]
+    return time_graph(fns)
+
+
+def bench_sgl(case: dict, m: int, dg: Any) -> float:
+    out = torch.empty((m, case["n"]), dtype=torch.bfloat16, device="cuda")
+    fns = [
+        (lambda w=w, s=s: dg.fp8_gemm_nt((case["xq"], case["xs_mn"]), (w, s), out, recipe=(1, 32, 32)))
+        for w, s in zip(case["wqs"], case["wss"], strict=True)
+    ]
+    return time_graph(fns)
+
+
+def bench_sgl_wo_a(case: dict, m: int, dg: Any, g: int = 8, d: int = 1024, r: int = 4096) -> float:
+    """wo_a as one sgl-deep-gemm block32 GEMM per group, run back to back, with bf16 output."""
+    outs = [torch.empty((m, d), dtype=torch.bfloat16, device="cuda") for _ in range(g)]
+    xs_g = [U.mn_major_fp32(case["xs"][:, i * r // 32 : (i + 1) * r // 32]) for i in range(g)]
+
+    def run(w: torch.Tensor, s: torch.Tensor):
+        for i in range(g):
+            dg.fp8_gemm_nt(
+                (case["xq"][:, i * r : (i + 1) * r], xs_g[i]),
+                (w[i * d : (i + 1) * d], s[i * d // 32 : (i + 1) * d // 32]),
+                outs[i],
+                recipe=(1, 32, 32),
+            )
+
+    fns = [(lambda w=w, s=s: run(w, s)) for w, s in zip(case["wqs"], case["wss"], strict=True)]
+    return time_graph(fns)
+
+
+def bench_bf16_wo_a(case: dict, m: int, g: int = 8, d: int = 1024, r: int = 4096) -> float:
+    """wo_a as a bf16 batched matmul on the dequantized weight (input already quantized-dequantized)."""
+    xb = U.dequant_act(case["xq"], case["xs"]).to(torch.bfloat16).view(m, g, r).transpose(0, 1)
+    ws = [U.dequant_weight(w, s).to(torch.bfloat16).view(g, d, r) for w, s in zip(case["wqs"][:4], case["wss"][:4], strict=True)]
+    out = torch.empty((g, m, d), dtype=torch.bfloat16, device="cuda")
+    fns = [(lambda w=w: torch.bmm(xb, w.transpose(1, 2), out=out)) for w in ws]
+    return time_graph(fns)
+
+
+def check_accuracy(case: dict, m: int, group: bool, official: Any) -> dict:
+    """Ours vs the fp32 product of the dequantized operands, and vs the official reference ``fp8_gemm``
+    (``inference/kernel.py`` of the checkpoint) when it is available (not for wo_a)."""
+    wq, ws = case["wqs"][0], case["wss"][0]
+    a, w = U.dequant_act(case["xq"], case["xs"]), U.dequant_weight(wq, ws)
+    if group:
+        g, d, r, _ = U.WO_A
+        ref = torch.einsum("bgr,gdr->bgd", a.view(m, g, r), w.view(g, d, r)).reshape(m, g * d)
+        out = torch.empty((m, g * d), dtype=torch.float8_e4m3fn, device="cuda")
+        out_sf = torch.empty_strided((m, g * d // 128), (1, (m + 3) // 4 * 4), dtype=torch.int32, device="cuda")
+        fp8_block32_gemm(case["xq"], case["words"], wq, ws, out, out_sf=out_sf, group_n=d)
+        out = U.dequant_act(out, U.unpack_ue8m0(out_sf))
+    else:
+        ref = a @ w.t()
+        out = torch.empty((m, case["n"]), dtype=torch.bfloat16, device="cuda")
+        fp8_block32_gemm(case["xq"], case["words"], wq, ws, out)
+    res = {f"ref_{k}": v for k, v in U.err_stats(out, ref).items() if k != "bitwise_frac"}
+    if official is not None and not group:
+        prev = torch.get_default_dtype()
+        torch.set_default_dtype(torch.bfloat16)  # the reference allocates its output in the default dtype
+        try:
+            off = official.fp8_gemm(case["xq"], case["xs"].contiguous(), wq, ws, torch.float32, block_size=32)
+        finally:
+            torch.set_default_dtype(prev)
+        st = U.err_stats(out, off)
+        res.update({"off_cos": st["cos"], "off_max_abs": st["max_abs"], "off_bitwise": st["bitwise_frac"]})
+    return res
+
+
+_TILES = [(8, 0), (16, 0), (32, 0), (32, 16), (64, 0), (64, 32), (128, 0)]
+
+
+def _smem_ok(cfg: Block32Config) -> bool:
+    bt = cfg.bt1 + cfg.bt2
+    slots = sum(128 * max(1, 32 // b) for b in (cfg.bt1, cfg.bt2) if b)
+    smem = cfg.stages * (cfg.bw * 128 + bt * 128 + slots) + bt * cfg.bw * 2 + 1024
+    return smem <= 227 * 1024
+
+
+def _nreg_options(bt: int, banks: int) -> list[int]:
+    need = bt * 3 // 2 + 24 if banks == 2 else bt + 24
+    return [r for r in (64, 72, 80, 96, 128, 168, 232) if r >= need * 0.8][:2]
+
+
+@functools.cache
+def _num_sms() -> int:
+    return torch.cuda.get_device_properties(torch.cuda.current_device()).multi_processor_count
+
+
+def _split_options(n: int, m: int, cfg: Block32Config, nkb: int) -> list[int]:
+    sms = _num_sms()
+    tiles = num_tiles(n, m, cfg)
+    out = [1]
+    for sp in (2, 3, 4, 5, 6, 8, 10, 12, 16):
+        if nkb // sp < 2 or tiles > 512 or tiles * sp > 16 * sms:
+            continue
+        out.append(sp)
+    return out
+
+
+def _heuristic_split(n: int, m: int, cfg: Block32Config, nkb: int) -> int:
+    sms = _num_sms()
+    tiles = num_tiles(n, m, cfg)
+    opts = _split_options(n, m, cfg, nkb)
+    return min(opts, key=lambda sp: abs(tiles * sp - 3 * sms) + (0 if tiles * sp >= sms else 4 * sms))
+
+
+def _stage1(m: int, n: int, k: int) -> list[Block32Config]:
+    nkb = k // 128
+    if m > 1024:
+        cands = [Block32Config(64, 128, 0, st, 1, r, 1) for st in (2, 3) for r in (120, 128)]
+        cands += [Block32Config(64, 64, 0, 4, 1, 80, 1), Block32Config(64, 64, 0, 3, 1, 128, 2), Block32Config(64, 64, 0, 4, 1, 128, 2)]
+        return cands
+    fit = [t for t in _TILES if sum(t) >= m]
+    tiles = [fit[0] if fit else _TILES[-1]]
+    i = _TILES.index(tiles[0])
+    if i > 0 and m > 8:
+        tiles.append(_TILES[i - 1])
+    if m >= 256 and (128, 0) not in tiles:
+        tiles.append((128, 0))
+    out = []
+    for bt1, bt2 in tiles:
+        bt = bt1 + bt2
+        for banks in (2,) if bt <= 32 else (1, 2):
+            for r in _nreg_options(bt, banks):
+                for st in (2, 3):
+                    cfg = Block32Config(64, bt1, bt2, st, 1, r, banks)
+                    out.append(cfg._replace(split=_heuristic_split(n, m, cfg, nkb)))
+    if m >= 256:
+        out += [Block32Config(128, 64, 0, 4, 1, 168, 2), Block32Config(128, 128, 0, 3, 1, 168, 1)]
+    return [c for c in out if _smem_ok(c)]
+
+
+def sweep(case: dict, m: int, group_n: int, log: Any) -> list[tuple[float, Block32Config]]:
+    n, k = case["n"], case["k"]
+    nkb = k // 128
+    seen: dict = {}
+
+    def run(cfg: Block32Config) -> None:
+        if cfg in seen or not _smem_ok(cfg):
+            return
+        try:
+            seen[cfg] = bench_ours(case, m, cfg, group_n=group_n)
+        except Exception as e:  # noqa: BLE001
+            seen[cfg] = float("inf")
+            log(f"  {tuple(cfg)} failed: {type(e).__name__}: {str(e)[:120]}")
+
+    for cfg in _stage1(m, n, k):
+        run(cfg)
+    ranked = sorted(seen, key=seen.get)
+    if m <= 1024:
+        for cfg in ranked[:3]:
+            for sp in _split_options(n, m, cfg, nkb):
+                run(cfg._replace(split=sp))
+        best = min(seen, key=seen.get)
+        for st in (2, 3, 4, 6):
+            run(best._replace(stages=st))
+    return sorted(((t, c) for c, t in seen.items()), key=lambda a: a[0])
+
+
+def _kernel_cache():
+    from deepinfer.model_executor.layers.sm90_ops import fp8_block32_gemm as mod
+
+    return mod._block32_gemm_kernel.device_caches[torch.cuda.current_device()][0]
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--m", type=int, nargs="*", default=[1, 8, 64, 512, 4096, 16384])
+    ap.add_argument("--shapes", nargs="*", default=list(U.REAL_SHAPES) + ["wo_a"])
+    ap.add_argument("--real", action="store_true")
+    ap.add_argument("--sgl", action="store_true", help="also time the public sgl-deep-gemm block32 GEMM (must provide deep_gemm)")
+    ap.add_argument(
+        "--check",
+        action="store_true",
+        help="also report accuracy vs the dequantized fp32 product (and the official reference kernel when available)",
+    )
+    ap.add_argument("--sweep", action="store_true")
+    ap.add_argument("--top", type=int, default=3)
+    ap.add_argument("--json", default=None)
+    ap.add_argument(
+        "--cfg", nargs="*", default=[], help="explicit configs 'bw,bt1,bt2,stages,split,maxnreg[,banks]' timed with regs/spills"
+    )
+    args = ap.parse_args()
+    dg = None
+    if args.sgl:
+        try:
+            import deep_gemm as dg
+        except ImportError as e:
+            raise SystemExit(f"--sgl needs the sgl-deep-gemm package (pip install sgl-deep-gemm): {e}") from e
+
+    official = U.official_kernel_module() if args.check else None
+    rows = []
+    for name in args.shapes:
+        for m in args.m:
+            group = name == "wo_a"
+            case = make_case(name, m, args.real, group=group)
+            n, k = case["n"], case["k"]
+            row = {"name": name, "M": m, "N": n, "K": k}
+            for spec in args.cfg:
+                cfg = Block32Config(*[int(v) for v in spec.split(",")])
+                try:
+                    t = bench_ours(case, m, cfg, group_n=1024 if group else 0)
+                except Exception as e:  # noqa: BLE001
+                    print(f"  {cfg} failed: {type(e).__name__}: {str(e)[:160]}", flush=True)
+                    continue
+                kern = list(_kernel_cache().values())[-1]
+                print(
+                    f"  {tuple(cfg)} {t:.1f} us {2 * m * n * k / t / 1e6:.1f} TFLOPS regs {kern.n_regs} spills {kern.n_spills}", flush=True
+                )
+            if args.sweep:
+                res = sweep(case, m, 1024 if group else 0, lambda msg: print(msg, flush=True))
+                row["best"] = [(round(t, 2), list(c)) for t, c in res[: args.top]]
+                row["n_cfgs"] = len(res)
+            if args.check:
+                row.update(check_accuracy(case, m, group, official))
+            row["ours_us"] = round(bench_ours(case, m, group_n=1024 if group else 0), 2)
+            if dg is not None:
+                if group:
+                    row["sgl_dg_per_group_us"] = round(bench_sgl_wo_a(case, m, dg), 2)
+                    row["bf16_bmm_us"] = round(bench_bf16_wo_a(case, m), 2)
+                else:
+                    row["sgl_dg_us"] = round(bench_sgl(case, m, dg), 2)
+            flops = 2 * m * n * k
+            row["ours_tflops"] = round(flops / row["ours_us"] / 1e6, 1)
+            rows.append(row)
+            print(json.dumps(row), flush=True)
+            del case
+            torch.cuda.empty_cache()
+    if args.json:
+        with open(args.json, "w") as f:
+            json.dump(rows, f, indent=1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/sm90/test_fp8_block32_gemm.py b/tests/sm90/test_fp8_block32_gemm.py
new file mode 100644
index 0000000..a623cbd
--- /dev/null
+++ b/tests/sm90/test_fp8_block32_gemm.py
@@ -0,0 +1,197 @@
+"""SM90 block32 FP8 GEMM (DeepInfer formats) vs a dequantized torch reference and the official
+reference kernel ``fp8_gemm`` (inference/kernel.py), on every non-expert FP8 linear shape of
+V4.1 Flash and the wo_a einsum (synthetic weights). The official reference is used when
+``DEEPINFER_HF_MODEL_DIR`` contains its ``inference/kernel.py``. Timings and checkpoint-weight checks:
+``examples/sm90/bench_fp8_block32_gemm.py``.
+"""
+
+from __future__ import annotations
+
+import itertools
+from typing import Any
+
+import pytest
+import torch
+
+from deepinfer import PLATFORM
+from examples.sm90 import _block32_utils as U
+
+pytestmark = [
+    pytest.mark.gpu,
+    pytest.mark.skipif(not torch.cuda.is_available() or not PLATFORM.is_sm90, reason="SM90 only"),
+]
+
+
+def _cases(grid: list[tuple], ci: set[tuple]) -> list:
+    """Parameter sets of ``grid``; those in ``ci`` (a fast subset) also run with ``-m ci``."""
+    return [pytest.param(*c, marks=pytest.mark.ci if c in ci else ()) for c in grid]
+
+
+def _gemm():
+    from deepinfer.model_executor.layers.sm90_ops.fp8_block32_gemm import fp8_block32_gemm
+
+    return fp8_block32_gemm
+
+
+def _weights(name: str, gen: torch.Generator):
+    n, k, _ = U.REAL_SHAPES[name]
+    w = torch.randn((n, k), generator=gen, device="cuda", dtype=torch.float32).mul_(0.02)
+    # A few hot 32x32 blocks so block scales differ.
+    w.view(n // 32, 32, k // 32, 32)[::7, :, ::5, :] *= 16
+    return U.quant_weight_32x32(w.to(torch.bfloat16))
+
+
+def _act(m: int, k: int, gen: torch.Generator) -> torch.Tensor:
+    x = torch.randn((m, k), generator=gen, device="cuda", dtype=torch.float32)
+    x[:, ::97] *= 40  # outlier channels -> per-32 scales vary along K
+    x[::5] *= 0.01  # and across rows
+    return x.to(torch.bfloat16)
+
+
+def check_linear(
+    name: str,
+    m: int,
+    seed: int = 0,
+    config: Any = None,
+    add_c: bool = False,
+    k_major_sf: bool = False,
+    official: Any = None,
+) -> dict:
+    gemm = _gemm()
+    gen = torch.Generator(device="cuda").manual_seed(seed)
+    n, k, _ = U.REAL_SHAPES[name]
+    wq, ws = _weights(name, gen)
+    xq, xs = U.quant_act_1x32(_act(m, k, gen))
+    words = U.pack_ue8m0_mn_major(xs)
+    if k_major_sf:
+        words = words.contiguous()
+    ref = U.dequant_act(xq, xs) @ U.dequant_weight(wq, ws).t()
+    out = torch.empty((m, n), dtype=torch.bfloat16, device="cuda")
+    c = None
+    if add_c:
+        c = torch.randn((m, n), generator=gen, device="cuda", dtype=torch.float32).to(torch.bfloat16)
+        ref = ref + c.float()
+        out.copy_(c)
+        c = out  # in place, as ReplicatedLinear(out_acc=...) calls it
+    gemm(xq, words, wq, ws, out, c=c, config=config)
+    torch.cuda.synchronize()
+    res = {"name": name, "M": m, "N": n, "K": k, "add_c": add_c}
+    res.update({f"ref_{a}": b for a, b in U.err_stats(out, ref).items() if a != "bitwise_frac"})
+    if official is not None and not add_c:
+        prev = torch.get_default_dtype()
+        torch.set_default_dtype(torch.bfloat16)  # the reference allocates its output in the default dtype
+        try:
+            off = official.fp8_gemm(xq, xs.contiguous(), wq, ws, torch.float32, block_size=32)
+        finally:
+            torch.set_default_dtype(prev)
+        torch.cuda.synchronize()
+        st = U.err_stats(out, off)
+        res.update({"off_cos": st["cos"], "off_max_abs": st["max_abs"], "off_bitwise": st["bitwise_frac"]})
+        res["off_ref_cos"] = U.cosine(off, ref)
+    return res
+
+
+def check_wo_a(m: int, seed: int = 0, config: Any = None) -> dict:
+    """DeepInfer wo_a: fp8_einsum("bhr,hdr->bhd") with FP8 + packed-UE8M0 output, against the
+    official model.py path (QDQ input, bf16 dequantized wo_a, bf16 einsum, act_quant for wo_b)."""
+    gemm = _gemm()
+    g, d, r, _ = U.WO_A
+    gen = torch.Generator(device="cuda").manual_seed(seed)
+    w = torch.randn((g * d, r), generator=gen, device="cuda").mul_(0.02).to(torch.bfloat16)
+    wq, ws = U.quant_weight_32x32(w)
+    o = _act(m, g * r, gen)
+    xq, xs = U.quant_act_1x32(o)  # == act_quant(o, 32, "ue8m0") of the reference
+    words = U.pack_ue8m0_mn_major(xs)
+    out = torch.empty((m, g * d), dtype=torch.float8_e4m3fn, device="cuda")
+    mpad = (m + 3) // 4 * 4
+    out_sf = torch.empty_strided((m, g * d // 128), (1, mpad), dtype=torch.int32, device="cuda")
+    gemm(xq, words, wq, ws, out, out_sf=out_sf, group_n=d, config=config)
+    # Reference: bf16 einsum of the QDQ input with the bf16-dequantized weight, then act_quant.
+    o_qdq = U.dequant_act(xq, xs).to(torch.bfloat16).view(m, g, r)
+    w_bf16 = U.dequant_weight(wq, ws).to(torch.bfloat16).view(g, d, r)
+    y_bf16 = torch.einsum("bgr,gdr->bgd", o_qdq, w_bf16).reshape(m, g * d)
+    y_fp32 = torch.einsum("bgr,gdr->bgd", o_qdq.float(), w_bf16.float()).reshape(m, g * d)
+    ref_q, ref_s = U.quant_act_1x32(y_bf16)
+    torch.cuda.synchronize()
+    our_s = U.unpack_ue8m0(out_sf)
+    deq = U.dequant_act(out, our_s)
+    ref_deq = U.dequant_act(ref_q, ref_s)
+    return {
+        "name": "wo_a",
+        "M": m,
+        "N": g * d,
+        "K": r,
+        "ref_cos": U.cosine(deq, y_fp32),
+        "refq_cos": U.cosine(ref_deq, y_fp32),
+        "fp8_bitwise": float((out.view(torch.uint8) == ref_q.view(torch.uint8)).float().mean()),
+        "sf_bitwise": float((our_s == ref_s).float().mean()),
+        "deq_vs_refq_cos": U.cosine(deq, ref_deq),
+    }
+
+
+# ----------------------------------------------------------------------------- pytest
+@pytest.fixture(scope="module")
+def official() -> Any:
+    return U.official_kernel_module()
+
+
+@pytest.mark.parametrize("name,m", _cases(list(itertools.product(U.REAL_SHAPES, [1, 17, 333, 4096])), {("q_a_kv_swa", 17), ("wo_b", 333)}))
+def test_linear_shapes(name: str, m: int, official: Any) -> None:
+    res = check_linear(name, m, official=official)
+    assert res["ref_cos"] > 0.99999, res
+    assert res["ref_max_rel_to_absmax"] < 2e-2, res
+    if official is not None:
+        assert res["off_cos"] > 0.99999, res
+
+
+@pytest.mark.parametrize("m", [pytest.param(5, marks=pytest.mark.ci), 300])
+def test_add_c(m: int) -> None:
+    res = check_linear("shared_down", m, add_c=True)
+    assert res["ref_cos"] > 0.99999, res
+    assert res["ref_max_rel_to_absmax"] < 2e-2, res
+
+
+@pytest.mark.ci
+def test_k_major_scales_bitwise() -> None:
+    gemm = _gemm()
+    gen = torch.Generator(device="cuda").manual_seed(1)
+    wq, ws = _weights("wo_b", gen)
+    xq, xs = U.quant_act_1x32(_act(37, 8192, gen))
+    words = U.pack_ue8m0_mn_major(xs)
+    a = torch.empty((37, 5120), dtype=torch.bfloat16, device="cuda")
+    b = torch.empty_like(a)
+    gemm(xq, words, wq, ws, a)
+    gemm(xq, words.contiguous(), wq, ws, b)
+    assert torch.equal(a, b)
+
+
+@pytest.mark.ci
+def test_split_k_matches_split1() -> None:
+    """Split-K (8 K-slices reduced in fp32) matches the unsplit kernel up to fp32 summation order."""
+    from deepinfer.model_executor.layers.sm90_ops.fp8_block32_gemm import Block32Config
+
+    gemm = _gemm()
+    gen = torch.Generator(device="cuda").manual_seed(0)
+    m, (n, k, _) = 8, U.REAL_SHAPES["q_a_kv_swa"]
+    wq, ws = _weights("q_a_kv_swa", gen)
+    xq, xs = U.quant_act_1x32(_act(m, k, gen))
+    words = U.pack_ue8m0_mn_major(xs)
+    ref = U.dequant_act(xq, xs) @ U.dequant_weight(wq, ws).t()
+    outs = []
+    for split in (1, 8):
+        out = torch.empty((m, n), dtype=torch.bfloat16, device="cuda")
+        gemm(xq, words, wq, ws, out, config=Block32Config(64, 8, 0, 4, split, 128))
+        st = U.err_stats(out, ref)
+        assert st["cos"] > 0.99999 and st["max_rel_to_absmax"] < 2e-2, (split, st)
+        outs.append(out.float())
+    # Both round an fp32 sum of the same products to bf16: at most one bf16 ulp apart (2**-7 relative),
+    # plus a small absolute slack for sums that cancel.
+    torch.testing.assert_close(outs[1], outs[0], rtol=2**-7, atol=1e-3 * float(ref.abs().max()))
+
+
+@pytest.mark.parametrize("m", [1, pytest.param(13, marks=pytest.mark.ci), 256, 2048])
+def test_wo_a_fp8_out(m: int) -> None:
+    res = check_wo_a(m)
+    assert res["ref_cos"] > 0.999, res
+    assert res["fp8_bitwise"] > 0.99, res
+    assert res["sf_bitwise"] > 0.999, res
diff --git a/tests/sm90/test_fp8_block32_gemm_split_k.py b/tests/sm90/test_fp8_block32_gemm_split_k.py
new file mode 100644
index 0000000..14aeae0
--- /dev/null
+++ b/tests/sm90/test_fp8_block32_gemm_split_k.py
@@ -0,0 +1,86 @@
+"""SM90 block32 FP8 GEMM: split-K calls without per-weight tile counters.
+
+Such calls zero counters of their own, so concurrent calls on different streams cannot share them (a shared
+counter lets one call's CTAs complete another call's tiles), and graph replays start from zeroed counters.
+
+    pytest tests/sm90/test_fp8_block32_gemm_split_k.py
+"""
+
+from __future__ import annotations
+
+import pytest
+import torch
+
+from deepinfer import PLATFORM
+from examples.sm90 import _block32_utils as U
+
+pytestmark = [
+    pytest.mark.gpu,
+    pytest.mark.skipif(not torch.cuda.is_available() or not PLATFORM.is_sm90, reason="SM90 only"),
+]
+
+# 8 tiles x split 4 = 32 CTAs per call, so calls on several streams run fully concurrently on H20's 78 SMs.
+M, N, K = 16, 512, 7168
+
+
+def _setup(num_inputs: int):  # noqa: ANN202
+    from deepinfer.model_executor.layers.sm90_ops.fp8_block32_gemm import Block32Config, fp8_block32_gemm
+
+    cfg = Block32Config(bw=64, bt1=16, bt2=0, stages=3, split=4, maxnreg=72, banks=2)
+    gen = torch.Generator(device="cuda").manual_seed(0)
+    wq, ws = U.quant_weight_32x32((torch.randn((N, K), generator=gen, device="cuda") * 0.02).bfloat16())
+    xs = []
+    for _ in range(num_inputs):
+        xq, sx = U.quant_act_1x32(torch.randn((M, K), generator=gen, device="cuda").bfloat16())
+        xs.append((xq, U.pack_ue8m0_mn_major(sx)))
+
+    def gemm(x: tuple[torch.Tensor, torch.Tensor], out: torch.Tensor) -> None:
+        fp8_block32_gemm(x[0], x[1], wq, ws, out, config=cfg)
+
+    refs = []
+    for x in xs:
+        refs.append(torch.empty((M, N), dtype=torch.bfloat16, device="cuda"))
+        gemm(x, refs[-1])
+    torch.cuda.synchronize()
+    return gemm, xs, refs
+
+
+def test_split_k_without_counters_on_concurrent_streams() -> None:
+    gemm, xs, refs = _setup(4)
+    iters = 50
+    streams = [torch.cuda.Stream() for _ in xs]
+    outs = [[torch.empty_like(refs[0]) for _ in range(iters)] for _ in xs]
+    torch.cuda.synchronize()
+    # Hold every stream behind one gate so that all calls are queued before any starts and the streams overlap.
+    gate, opened = torch.cuda.Stream(), torch.cuda.Event()
+    with torch.cuda.stream(gate):
+        torch.cuda._sleep(int(2e8))
+        opened.record()
+    for stream in streams:
+        stream.wait_event(opened)
+    for i in range(iters):
+        for stream, x, out in zip(streams, xs, outs, strict=True):
+            with torch.cuda.stream(stream):
+                gemm(x, out[i])
+    torch.cuda.synchronize()
+    for j, (ref, out) in enumerate(zip(refs, outs, strict=True)):
+        for i, o in enumerate(out):
+            assert torch.equal(o.view(torch.int16), ref.view(torch.int16)), f"stream {j}, call {i}: differs from the serial result"
+
+
+def test_split_k_without_counters_in_cuda_graph() -> None:
+    gemm, xs, refs = _setup(1)
+    out = torch.empty_like(refs[0])
+    side = torch.cuda.Stream()
+    side.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(side):
+        gemm(xs[0], out)  # warm-up (JIT) outside the capture
+    torch.cuda.current_stream().wait_stream(side)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        gemm(xs[0], out)
+    for _ in range(3):
+        out.zero_()
+        graph.replay()
+        torch.cuda.synchronize()
+        assert torch.equal(out.view(torch.int16), refs[0].view(torch.int16))

From 23a1290490035a4bc677e539e3d9a5800df32f63 Mon Sep 17 00:00:00 2001
From: DarkraiHL <16268229+DarkraiHL@users.noreply.github.com>
Date: Tue, 20 Oct 2026 23:54:00 +0900
Subject: [PATCH 05/12] model: route FP8 linears and wo_a to the SM90 GEMM

On SM90, ReplicatedLinear keeps the checkpoint's fp32 32x32 block
scales (DeepGEMM's transform_sf_into_required_layout rejects 32-wide
scales there) and calls sm90_ops.fp8_block32_gemm, including the
out_acc accumulation. Attention's wo_a keeps its FP8 output with
packed-UE8M0 scales for wo_b through fp8_einsum_bhr_hdr_bhd instead of
deep_gemm.fp8_einsum. Split-K tile counters are allocated per weight at
construction, outside CUDA-graph capture. DEEPINFER_BATCH_INVARIANT
selects the deterministic split-1 launches of these GEMMs (the worker
still rejects batch invariance on SM90 as a whole).

Gated on PLATFORM.is_sm90; SM100 paths are unchanged.
tests/sm90/test_sm90_linear_integration.py runs ReplicatedLinear and the
wo_a wrapper through tile_kernels' activation quantizer (cosine and
relative-error bounds against an fp32 reference), CUDA-graph replay
(bitwise equal to eager) and the batch invariance of deterministic
mode; a format-compatible stand-in quantizer, isolated per test, covers
the plumbing when tile_kernels is not installed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
