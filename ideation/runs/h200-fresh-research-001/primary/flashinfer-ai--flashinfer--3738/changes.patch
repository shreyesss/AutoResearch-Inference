+def _assert_close_with_error_stats(
+    actual: torch.Tensor,
+    expected: torch.Tensor,
+    *,
+    label: str,
+    rtol: float,
+    atol: float,
+    max_bad: int = 0,
+    print_stats: bool = False,
+) -> None:
+    actual_f = actual.to(torch.float32)
+    expected_f = expected.to(torch.float32)
