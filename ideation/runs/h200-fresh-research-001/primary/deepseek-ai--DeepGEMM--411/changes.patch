+                            const uint32_t token_0 =
+                                chunk * 8 + col_idx * 2;
+                            const uint32_t token_1 = token_0 + 1;
+                            #pragma unroll
+                            for (uint32_t half = 0;
+                                 half < kSwapABWeightHalves; ++ half) {
