+TRITON_HIP_USE_ASYNC_COPY=0 \
+ROCM_QUICK_REDUCE_QUANTIZATION=NONE \
+HSA_NO_SCRATCH_RECLAIM=0 \
+GPU_MAX_HW_QUEUES=2 \
+sglang serve \
+  --model-path deepseek-ai/DeepSeek-V4.1-Flash \
+  --trust-remote-code \
