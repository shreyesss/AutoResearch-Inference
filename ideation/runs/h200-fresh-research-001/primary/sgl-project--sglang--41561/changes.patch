+    )
+    vae = Kandinsky6SRVAE(vae_config).eval()
+    _randomize(vae, 1)
+    dit_config = Kandinsky6SRDitConfig()
+    dit_config.update_model_arch(dict(dit_arch))
+    dit = Kandinsky6SRTransformer3DModel(dit_config, dict(dit_arch)).eval()
+    _randomize(dit, 2)
