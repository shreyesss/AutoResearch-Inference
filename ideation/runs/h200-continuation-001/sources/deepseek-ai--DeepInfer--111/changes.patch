--- /dev/null
+++ b/tests/engine/test_stats_logger.py
@@ -0,0 +1,83 @@
+"""The per-step statistics must not walk the scheduler's queues on steps that are not logged."""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+from unittest import mock
+
+import pytest
+
+from deepinfer.engine.stats_logger import Aggregates, StatsLogger
+
+pytestmark = [pytest.mark.ci, pytest.mark.ci_npu]
+
+
+class _Scheduler:
+    """Counts the calls that walk a queue (the waiting queue is walked in full, and so is the chunked-prefill count)."""
+
+    def __init__(self) -> None:
+        self.queue_walks = 0
+
+    def get_num_free_gpu_blocks(self) -> int:
+        return 60
+
+    def get_sum_prompt_len_waiting(self) -> tuple[int, int]:
+        self.queue_walks += 1
+        return 7, 70
+
+    def get_sum_prompt_len_running(self) -> tuple[int, int]:
+        self.queue_walks += 1
+        return 5, 50
+
+    def get_sum_prompt_len_chunked(self) -> tuple[int, int]:
+        self.queue_walks += 1
+        return 1, 10
+
+    def get_num_preempted_seqs(self) -> int:
+        return 2
+
+    def get_num_aborted_seqs(self) -> int:
+        return 3
+
+
+def _collect(*, should_log: bool) -> tuple[Aggregates, _Scheduler]:
+    scheduler = _Scheduler()
+    engine = SimpleNamespace(
+        scheduler=scheduler,
+        state_manager=None,
+        generate_step=10,
+        step_start=0.0,
+        last_step_interval=1.0,
+        get_num_pendings=lambda: scheduler.get_sum_prompt_len_waiting()[0],
+    )
+    # The window helpers are not what is tested: they get canned answers.
+    self = mock.MagicMock()
+    self._engine = engine
+    self._cache_config = SimpleNamespace(num_gpu_blocks=101, num_state_seqs=1)
+    self._last_logging_time = 0.0
+    self._last_logging_step = 0
+    self._throughput.return_value = (0.0, 0)
+    self._mfu.return_value = 0.0
+    self._moe_lb_ratio.return_value = 0.0
+    self._finished_payload_stats.return_value = (0.0, 0.0, 0.0)
+    step_stats = SimpleNamespace(first_token_latencies=[])
+    aggregates = Aggregates()
+    StatsLogger._collect(self, step_stats, 1.0, [1, 2, 3], should_log, aggregates)
+    return aggregates, scheduler
+
+
+def test_steps_that_are_not_logged_do_not_walk_the_queues() -> None:
+    aggregates, scheduler = _collect(should_log=False)
+
+    assert scheduler.queue_walks == 0
+    # What is cheap is still collected on every step.
+    assert aggregates.gpu_cache_usage == pytest.approx(0.4)
+    assert aggregates.cur_tps == pytest.approx(6.0)
+
+
+def test_logged_steps_report_the_queue_sizes() -> None:
+    aggregates, scheduler = _collect(should_log=True)
+
+    assert scheduler.queue_walks == 3
+    assert (aggregates.num_pendings, aggregates.num_runnings, aggregates.num_chunked) == (7, 5, 1)
+    assert (aggregates.num_preempted, aggregates.num_aborted) == (2, 3)

From a76442a61c59e05c4e19bcdc0bc7e7be69456b77 Mon Sep 17 00:00:00 2001
From: Jahidul Hossain Mekat <jahidulhossainmekat@gmail.com>
Date: Tue, 20 Oct 2026 16:11:33 +0000
Subject: [PATCH 4/4] Clone and group a step's RequestOutputs in one call in
 LLM._run_engine

The offline run loop cloned the outputs of a step one RequestOutput.clone call
at a time, read each request_id back to find its list and appended to it: about
1.1 us per output, 4.4 ms per step for 1024 sequences with MTP (4 outputs each),
during which the GPU is idle unless the step is overlapped.

RequestOutput.clone_grouped does the same for the whole array of pointers in
C++ and returns ({request_id: [RequestOutput, ...]}, number of finished
outputs), so the loop merges one list per request instead of handling one
output at a time. The outputs of a request are adjacent, so a group is only
looked up when the request changes. 2.2 ms per step for the same batch.

The test compares it with cloning every pointer one by one on the outputs of
real scheduler steps (several outputs per request, finished ones), and runs
LLM._run_engine on an engine whose steps return such pointers.
---
 csrc/engine/pybind_output.cpp             |  31 ++++
 deepinfer/_C/engine.pyi                   |   3 +
 deepinfer/entrypoints/llm.py              |  12 +-
 tests/engine/test_request_output_clone.py | 180 ++++++++++++++++++++++
 4 files changed, 220 insertions(+), 6 deletions(-)
 create mode 100644 tests/engine/test_request_output_clone.py

diff --git a/csrc/engine/pybind_output.cpp b/csrc/engine/pybind_output.cpp
index 995fd42..d1b91e6 100644
--- a/csrc/engine/pybind_output.cpp
+++ b/csrc/engine/pybind_output.cpp
@@ -16,6 +16,37 @@ void pybind_engine_output(pybind11::module &engine) {
     py::class_<RequestOutput>(engine, "RequestOutput")
         .def_static(
             "clone", [](uint64_t ptr) { return std::make_unique<RequestOutput>(*reinterpret_cast<RequestOutput *>(ptr)); }, py::arg("ptr"))
+        .def_static(
+            "clone_grouped",
+            [](const py::array_t<uint64_t, py::array::c_style | py::array::forcecast> &ptrs) {
+                // clone() of every pointer, grouped by request id, in one call: returns ({request_id: [RequestOutput, ...]},
+                // number of finished outputs). Doing this from Python costs about 1.2 us per output, 5 ms for a step of 1024
+                // sequences with MTP.
+                const uint64_t *raw = ptrs.data();
+                const ssize_t size = ptrs.size();
+                py::dict grouped;
+                py::list current;
+                const std::string *current_id = nullptr;
+                int num_finished = 0;
+                for (ssize_t i = 0; i < size; ++i) {
+                    const auto *output = reinterpret_cast<const RequestOutput *>(raw[i]);
+                    // The outputs of a request are adjacent; a group only has to be looked up when the request changes.
+                    if (current_id == nullptr || *current_id != output->request_id) {
+                        py::str request_id(output->request_id);
+                        if (grouped.contains(request_id)) {
+                            current = grouped[request_id];
+                        } else {
+                            current = py::list();
+                            grouped[request_id] = current;
+                        }
+                        current_id = &output->request_id;
+                    }
+                    current.append(RequestOutput(*output));
+                    num_finished += output->finished;
+                }
+                return py::make_tuple(std::move(grouped), num_finished);
+            },
+            py::arg("ptrs"))
         .DEF_OUTPUT_FIELD(request_id)
         .DEF_OUTPUT_FIELD(prompt_len)
         .DEF_OUTPUT_FIELD(token_id)
