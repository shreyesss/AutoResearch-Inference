From c741154d21b7fb9d8dc3bb0ecfb7af7d468835ea Mon Sep 17 00:00:00 2001
From: Yangmin Li <yangminl@nvidia.com>
Date: Tue, 20 Oct 2026 12:08:13 -0700
Subject: [PATCH 2/3] [Perf] DSpark: Gate the simulated-acceptance fast paths
 behind SGLANG_DSPARK_SIMULATE_ACC_FAST_PATH

One platform-independent switch, default off, for the three fast paths
under SGLANG_SIMULATE_ACC_LEN (skip the discarded accept sampling, greedy
temperature-only rows, the folded accept). SGLANG_SIMULATE_ACC_GREEDY and
SGLANG_DSPARK_SIMULATE_FOLD still turn the last two off individually.
---
 python/sglang/srt/environ.py                           | 10 +++++++---
 .../srt/speculative/dspark_components/dspark_verify.py |  7 ++++++-
 .../speculative/dspark_components/dspark_worker_v2.py  |  7 +++++--
 3 files changed, 18 insertions(+), 6 deletions(-)

diff --git a/python/sglang/srt/environ.py b/python/sglang/srt/environ.py
index ae5082207154..9897c0c32511 100644
--- a/python/sglang/srt/environ.py
+++ b/python/sglang/srt/environ.py
@@ -522,11 +522,15 @@ class Envs:
     SGLANG_SIMULATE_ACC_LEN = EnvFloat(-1)
     SGLANG_SIMULATE_ACC_METHOD = EnvStr("match-expected")
     SGLANG_SIMULATE_ACC_TOKEN_MODE = EnvStr("fixed")
-    # DSpark on HIP: with SGLANG_SIMULATE_ACC_LEN set, temperature-only sampling requests
+    # DSpark: with SGLANG_SIMULATE_ACC_LEN set, skip the accept sampling whose result the
+    # simulated length overwrites, and enable SGLANG_SIMULATE_ACC_GREEDY /
+    # SGLANG_DSPARK_SIMULATE_FOLD below. Off by default on every platform.
+    SGLANG_DSPARK_SIMULATE_ACC_FAST_PATH = EnvBool(False)
+    # DSpark fast path: with SGLANG_SIMULATE_ACC_LEN set, temperature-only sampling requests
     # run the greedy draft/accept path and only the bonus token is temperature-sampled.
     SGLANG_SIMULATE_ACC_GREEDY = EnvBool(True)
-    # DSpark on HIP: apply the simulated correct_len / bonus inside the folded verify epilogue
-    # (hip graph) instead of falling back to the eager accept + commit path.
+    # DSpark fast path: apply the simulated correct_len / bonus inside the folded verify
+    # epilogue (graph) instead of falling back to the eager accept + commit path.
     SGLANG_DSPARK_SIMULATE_FOLD = EnvBool(True)
     SGLANG_SIMULATE_UNIFORM_EXPERTS = EnvBool(False)
     SGLANG_SIMULATE_ROUND_ROBIN_EXPERTS = EnvBool(False)
diff --git a/python/sglang/srt/speculative/dspark_components/dspark_verify.py b/python/sglang/srt/speculative/dspark_components/dspark_verify.py
index 86de26a3b592..c5a3a7ab7afd 100644
--- a/python/sglang/srt/speculative/dspark_components/dspark_verify.py
+++ b/python/sglang/srt/speculative/dspark_components/dspark_verify.py
@@ -26,6 +26,7 @@
     simulated_bonus_sample,
     simulated_bonus_sample_graph,
 )
+from sglang.srt.environ import envs
 from sglang.srt.layers.logits_processor import LogitsProcessorOutput
 from sglang.srt.managers.schedule_batch import ScheduleBatch
 from sglang.srt.model_executor.forward_batch_info import CaptureHiddenMode, ForwardMode
@@ -166,7 +167,11 @@ def accept_and_finalize(
         simulate = self._simulated_correct_len is not None
         # Simulated acceptance overwrites correct_len below, so a sampling accept
         # (draft/target softmax + rejection) would be computed only to be discarded.
-        accept_sampling_info = None if simulate else sampling_info
+        accept_sampling_info = (
+            None
+            if simulate and envs.SGLANG_DSPARK_SIMULATE_ACC_FAST_PATH.get()
+            else sampling_info
+        )
         correct_len, bonus, cap_trim_lens = accept_draft_tokens(
             candidates=verify_ids_2d,
             target_logits=target_logits,
diff --git a/python/sglang/srt/speculative/dspark_components/dspark_worker_v2.py b/python/sglang/srt/speculative/dspark_components/dspark_worker_v2.py
index 4c9d524522e6..68a72d9748bc 100644
--- a/python/sglang/srt/speculative/dspark_components/dspark_worker_v2.py
+++ b/python/sglang/srt/speculative/dspark_components/dspark_worker_v2.py
@@ -361,7 +361,8 @@ def __init__(
                 tp_sync=self._tp_sync,
                 fused_argmax=target_is_dsv41,
                 simulated_correct_len=self._simulated_correct_len,
-                simulate_fold=envs.SGLANG_DSPARK_SIMULATE_FOLD.get(),
+                simulate_fold=envs.SGLANG_DSPARK_SIMULATE_ACC_FAST_PATH.get()
+                and envs.SGLANG_DSPARK_SIMULATE_FOLD.get(),
                 commit_ctx=CommitInjectCtx(
                     draft_model=self.draft_model,
                     block_pos_offsets=self._block_pos_offsets,
@@ -377,7 +378,9 @@ def __init__(
             )
 
         self._simulate_acc_greedy = (
-            self._simulate_acc_len > 0 and envs.SGLANG_SIMULATE_ACC_GREEDY.get()
+            envs.SGLANG_DSPARK_SIMULATE_ACC_FAST_PATH.get()
+            and self._simulate_acc_len > 0
+            and envs.SGLANG_SIMULATE_ACC_GREEDY.get()
         )
         if (
             self._simulate_acc_len > 0

