From 85d4d14fb033413cd53a00ba7736517e9daaac27 Mon Sep 17 00:00:00 2001
From: chaunceyjiang <chaunceyjiang@gmail.com>
Date: Fri, 14 Aug 2026 18:41:55 +0800
Subject: [PATCH 1/4] [Perf][DSV4] Prefer Humming over Marlin for MXFP4 MoE on
 SM90

Signed-off-by: chaunceyjiang <chaunceyjiang@gmail.com>
Co-authored-by: Missyinlll <liang.yin@daocloud.io>
---
 vllm/model_executor/layers/fused_moe/oracle/mxfp4.py | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/vllm/model_executor/layers/fused_moe/oracle/mxfp4.py b/vllm/model_executor/layers/fused_moe/oracle/mxfp4.py
index 4a8c72327862..9e2090fc8662 100644
--- a/vllm/model_executor/layers/fused_moe/oracle/mxfp4.py
+++ b/vllm/model_executor/layers/fused_moe/oracle/mxfp4.py
@@ -45,7 +45,7 @@
 )
 from vllm.model_executor.layers.quantization.utils.w8a8_utils import all_close_1d
 from vllm.platforms import current_platform
-from vllm.utils.import_utils import has_triton_kernels
+from vllm.utils.import_utils import has_humming, has_triton_kernels
 from vllm.utils.math_utils import round_up
 
 if TYPE_CHECKING:
@@ -344,7 +344,7 @@ def _get_priority_backends_for_gpt_oss() -> list[Mxfp4MoeBackend]:
 def _get_priority_backends() -> list[Mxfp4MoeBackend]:
     """
     Get available backends in priority order. SM100+ prefers DeepGEMM FP4 /
-    TRTLLM MXFP8; SM90 falls through to Triton_unfused or Marlin (the
+    TRTLLM MXFP8; SM90 falls through to Humming or Marlin (the
     backend-level ``is_supported_config`` check filters by device capability).
     """
     if current_platform.is_rocm():
@@ -360,9 +360,10 @@ def _get_priority_backends() -> list[Mxfp4MoeBackend]:
         # TRITON_UNFUSED has bug with MTP support
         # TODO re-enable after kernel is fixed
         # TRITON_UNFUSED
-        Mxfp4MoeBackend.MARLIN,
-        Mxfp4MoeBackend.BATCHED_MARLIN,
     ]
+    if has_humming():
+        _AVAILABLE_BACKENDS.append(Mxfp4MoeBackend.HUMMING)
+    _AVAILABLE_BACKENDS.extend([Mxfp4MoeBackend.MARLIN, Mxfp4MoeBackend.BATCHED_MARLIN])
     return _AVAILABLE_BACKENDS
 
 

