+++ b/rust/sglang-api-types/testdata/json_parity.json
@@ -0,0 +1,373 @@
+{
+  "_": "Cross-language JSON parity fixtures for sglang.api.v1. Each case: decoding `input` and re-encoding yields `canonical` byte for byte, and `canonical` re-encodes to itself. Checked by rust/sglang-api-types/tests/json_parity.rs and test/registered/unit/api/v1/test_parity.py.",
+  "cases": [
+    {
+      "type": "GenerateRequest",
+      "name": "single text prompt with a sampling object; stream absent",
+      "input": {
+        "text": "hi",
+        "sampling_params": {
+          "temperature": 0.5,
+          "max_new_tokens": 8
+        }
+      },
+      "canonical": "{\"text\":\"hi\",\"stream\":false,\"sampling_params\":{\"max_new_tokens\":8,\"temperature\":0.5,\"top_p\":1.0,\"top_k\":1073741824,\"min_p\":0.0,\"frequency_penalty\":0.0,\"presence_penalty\":0.0,\"repetition_penalty\":1.0,\"min_new_tokens\":0,\"n\":1,\"ignore_eos\":false,\"skip_special_tokens\":true,\"spaces_between_special_tokens\":true,\"no_stop_trim\":false}}"
+    },
+    {
+      "type": "GenerateRequest",
+      "name": "batch form: per-item sampling, broadcast flag, nullable PD columns",
+      "input": {
