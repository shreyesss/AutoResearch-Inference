index e66a162af2c5..7380b8c365d8 100644
--- a/python/sglang/srt/models/deepseek_v4.py
+++ b/python/sglang/srt/models/deepseek_v4.py
@@ -850,6 +850,8 @@ def deepseek_v4_write_tail_source_kv(layer, x, positions) -> None:
     backend = get_attn_backend()
     real_num_tokens = forward_batch.global_num_token_non_padded_cpu
     if real_num_tokens == 0:
+        # Nothing to write, but mark the source layer as write_tail_source_kv does,
+        # so its own pass inside the tail still skips the compressor.
         backend.tail_source_kv_layer_id = layer.layer_id
         return
     backend.write_tail_source_kv(
diff --git a/test/registered/attention/unittests/dsv4/test_deepseek_v4.py b/test/registered/attention/unittests/dsv4/test_deepseek_v4.py
index baf9dd92cac3..76f6230746da 100644
