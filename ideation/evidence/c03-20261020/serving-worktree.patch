+def load_c03_source_manifest(path: Path, image: str) -> dict[str, Any]:
+    """Validate reviewed, per-file overlays without importing serving code."""
+    c03_root = (ROOT / "c03").resolve()
+    path = path.resolve()
+    if not path.is_relative_to(c03_root):
+        raise ValueError("C03 manifest must be inside this worktree's c03 directory")
+    payload = json.loads(path.read_text())
+    if payload.get("schema_version") != 1:
+        raise ValueError("unsupported C03 source manifest schema")
+    if image != C03_IMAGE or payload.get("image") != image:
+        raise ValueError("C03 requires the attested existing image digest")
+    snapshot = json.loads((c03_root / "source/snapshot-manifest.json").read_text())
+    if snapshot.get("image") != image:
+        raise ValueError("C03 source snapshot has a different image")
+    originals = {item["path"]: item["sha256"] for item in snapshot["files"]}
+    files = payload.get("files")
+    if not isinstance(files, list):
+        raise ValueError("C03 files must be a list")
+    mounts = []
+    seen: set[str] = set()
+    for item in files:
+        destination = item.get("path")
+        if destination not in C03_SOURCE_PATHS or destination in seen:
+            raise ValueError(f"unapproved or duplicate C03 destination: {destination!r}")
+        seen.add(destination)
+        source = (path.parent / item["source"]).resolve()
+        if not source.is_relative_to(c03_root) or not source.is_file():
+            raise ValueError("C03 source must be a file inside this worktree's c03 directory")
+        if any(char in str(source) for char in (",", "\n", "\r", "\x00")):
+            raise ValueError("C03 source path cannot contain mount separators")
+        if hashlib.sha256(source.read_bytes()).hexdigest() != item.get("sha256"):
+            raise ValueError(f"C03 source hash mismatch: {destination}")
+        if destination == C03_DIAGNOSTIC_HELPER:
+            if item.get("base_sha256") is not None or destination in originals:
+                raise ValueError("C03 diagnostic helper must be a new module")
+        else:
+            original = c03_root / "source/base" / destination
+            expected = originals.get(destination)
+            if (
+                not expected
+                or item.get("base_sha256") != expected
+                or hashlib.sha256(original.read_bytes()).hexdigest() != expected
+            ):
+                raise ValueError(f"C03 baseline hash mismatch: {destination}")
+        mounts.append(
+            f"type=bind,src={source},dst={C03_PACKAGE_ROOT}/{destination},readonly"
+        )
+
+    environment = payload.get("environment", {})
+    allowed_env = {"C03_DIAGNOSTIC", "C03_DIAGNOSTIC_EPOCH", "C03_DIAGNOSTIC_DIR"}
+    if not isinstance(environment, dict) or set(environment) - allowed_env:
+        raise ValueError("unapproved C03 environment override")
+    if any(not isinstance(value, str) or "\x00" in value for value in environment.values()):
+        raise ValueError("C03 environment values must be strings without NUL bytes")
+    if environment:
+        if set(environment) != allowed_env or environment["C03_DIAGNOSTIC"] != "1":
+            raise ValueError("C03 diagnostic settings must specify enabled, epoch and output")
+        epoch = environment["C03_DIAGNOSTIC_EPOCH"]
+        epoch_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_"
+        if not epoch or any(char not in epoch_chars for char in epoch):
+            raise ValueError("invalid C03 diagnostic epoch")
+        if environment["C03_DIAGNOSTIC_DIR"] != f"/profiles/c03/{epoch}":
+            raise ValueError("C03 diagnostic output must match its epoch under /profiles/c03")
+        if C03_DIAGNOSTIC_HELPER not in seen:
+            raise ValueError("enabled C03 diagnostics require the reviewed helper")
+    return {"mounts": mounts, "environment": environment,
+            "manifest_sha256": hashlib.sha256(path.read_bytes()).hexdigest()}
 
 
