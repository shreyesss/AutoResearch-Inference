+        # Do dispatch
+        (recv_x, recv_sf,
+         recv_topk_idx, recv_topk_weights,
+         cloned_topk_idx,
+         num_recv_tokens_per_expert_list,
+         psum_num_recv_tokens_per_scaleup_rank,
