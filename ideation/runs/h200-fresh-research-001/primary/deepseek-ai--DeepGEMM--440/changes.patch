+        #pragma unroll
+        for (uint32_t i = lane_idx; i < kNumDispatchWarps; i += 32)
+            dispatch_barriers[i]->init(1);
+        if constexpr (kEarlyCombine) {
+            #pragma unroll
+            for (uint32_t i = lane_idx; i < kNumDispatchWarps; i += 32)
