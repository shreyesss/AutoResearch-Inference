+    def test_chunk_handoffs_across_polling_and_retract_pause(self):
+        for enabled, pause_at, blocking_ends in (
+            (True, None, ()),
+            (False, 1, (4,)),
+            (True, 1, (4,)),
+            (True, 2, (8,)),
+            (True, 4, (12,)),
