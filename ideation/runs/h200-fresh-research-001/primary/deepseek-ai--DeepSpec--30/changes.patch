Subject: [PATCH 2/4] Start cosine schedule from warmup peak

---
 deepspec/utils/optim.py | 1 +
 1 file changed, 1 insertion(+)

diff --git a/deepspec/utils/optim.py b/deepspec/utils/optim.py
index 5e4341eb..032e6403 100644
--- a/deepspec/utils/optim.py
+++ b/deepspec/utils/optim.py
@@ -45,6 +45,7 @@ def get_lr(self):
             if not self.finished:
                 self.after_scheduler.base_lrs = self.base_lrs
                 self.finished = True
+                return self.base_lrs
             return self.after_scheduler.get_lr()
 
         return [(self.last_epoch + 1) / self.warmup_epochs * lr for lr in self.base_lrs]

