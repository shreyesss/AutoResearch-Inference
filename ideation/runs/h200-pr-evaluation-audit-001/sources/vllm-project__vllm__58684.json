    "title": "[Perf][Attention] Remove D2H sync from FlashInfer SM90 sparse MLA plan under async scheduling",
    "user": {
      "login": "NickLucche",
      "id": 10706289,
      "node_id": "MDQ6VXNlcjEwNzA2Mjg5",
      "avatar_url": "https://avatars.githubusercontent.com/u/10706289?v=4",
      "gravatar_id": "",
