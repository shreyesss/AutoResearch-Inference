+def _mamba_spec():
+    return MambaSubPoolSpec(
+        name="mamba",
+        layer_num=1,
+        conv_state_shapes=((2, 2),),
+        conv_dtype=torch.float32,
+        temporal_state_shape=(2,),
+        temporal_dtype=torch.float32,
+        grow_direction="up",
+    )
