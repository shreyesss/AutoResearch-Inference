+        b_ptrs += BLOCK_SIZE_K * stride_bk
+        As_ptrs += scale_step_k * stride_As_k
+        Bs_ptrs += scale_step_k * stride_Bs_k
+
+    if SWAP_AB:
+        accumulator = tl.trans(accumulator)
+
+    if C.dtype.element_ty == tl.bfloat16:
