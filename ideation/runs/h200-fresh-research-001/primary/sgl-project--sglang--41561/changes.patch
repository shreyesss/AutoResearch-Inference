+    fn discovery_batch(n: u32, holding_since: Instant) -> ObligationBatch {
+        ObligationBatch {
+            obligations: vec![(worker_id(&format!("http://w{n}:30000"), 0), n as u64)],
+            holding_since,
+            late_join: LateJoin::Permitted,
+        }
+    }
