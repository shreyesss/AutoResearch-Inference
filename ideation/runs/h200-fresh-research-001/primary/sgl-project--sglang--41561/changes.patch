+def _batch(forward_iter, reqs=None):
+    if reqs is None:
+        reqs = [Req(str(forward_iter), "", [1, 2, 3, 4], SamplingParams())]
+    return ScheduleBatch(
+        reqs=reqs,
+        forward_iter=forward_iter,
+        forward_mode=ForwardMode.EXTEND,
+        spec_algorithm=SpeculativeAlgorithm.NONE,
+    )
