+    p.add_argument('--seed', type=int, default=0)
+    p.add_argument('--np', type=int, default=8)
+    p.add_argument('--m', type=int, nargs='+', default=[8, 64, 128, 256, 1024])
+    p.add_argument('--iters', type=int, default=30)
