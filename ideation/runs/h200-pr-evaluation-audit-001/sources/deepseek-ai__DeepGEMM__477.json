    "locked": false,
    "title": "[Fix][Einsum] Reject `c` in SM90 `fp8_einsum(\"bhr,hdr->bhd\")` to prevent silent data corruption in `sm90_fp8_bmm`",
    "user": {
      "login": "arxgy",
      "id": 74357419,
      "node_id": "MDQ6VXNlcjc0MzU3NDE5",
      "avatar_url": "https://avatars.githubusercontent.com/u/74357419?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/arxgy",
      "html_url": "https://github.com/arxgy",
      "followers_url": "https://api.github.com/users/arxgy/followers",
      "following_url": "https://api.github.com/users/arxgy/following{/other_user}",
      "gists_url": "https://api.github.com/users/arxgy/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/arxgy/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/arxgy/subscriptions",
      "organizations_url": "https://api.github.com/users/arxgy/orgs",
      "repos_url": "https://api.github.com/users/arxgy/repos",
      "events_url": "https://api.github.com/users/arxgy/events{/privacy}",
      "received_events_url": "https://api.github.com/users/arxgy/received_events",
