--- /dev/null
+++ b/python/sglang/multimodal_gen/runtime/models/schedulers/kandinsky6_piflow.py
@@ -0,0 +1,221 @@
+# Copyright 2025 The Kandinsky Team and The HuggingFace Team. All rights reserved.
