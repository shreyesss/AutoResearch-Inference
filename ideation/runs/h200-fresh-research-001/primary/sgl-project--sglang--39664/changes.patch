+def _small_page_table(
+    REQ_TO_TOKEN,
+    REQS,
+    LENS,
+    OUT_LENS,
+    POS,
+    PAGES,
+    SWA,
+    STRIDE: tl.constexpr,
+    NUM_PAGES: tl.constexpr,
+    PAGE_SIZE: tl.constexpr,
+    WINDOW: tl.constexpr,
+    BLOCK: tl.constexpr,
