From 08b093b7f2e759b26435cbbaaf4878dd67591d33 Mon Sep 17 00:00:00 2001
From: chaunceyjiang <chaunceyjiang@gmail.com>
Date: Wed, 14 Oct 2026 19:19:31 +0800
Subject: [PATCH 1/3] [Performance] Enable small-head FlashMLA sparse prefill
 for DeepSeek V4.1 on SM90

Signed-off-by: chaunceyjiang <chaunceyjiang@gmail.com>
---
 vllm/models/deepseek_v41/nvidia/flashmla.py | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/vllm/models/deepseek_v41/nvidia/flashmla.py b/vllm/models/deepseek_v41/nvidia/flashmla.py
index d995058216d0..dc758482c2b1 100644
--- a/vllm/models/deepseek_v41/nvidia/flashmla.py
+++ b/vllm/models/deepseek_v41/nvidia/flashmla.py
@@ -22,6 +22,7 @@
     DeepseekV4FlashMLAMetadata,
     DeepseekV41SparseSWAMetadataBuilder,
 )
+from vllm.platforms import current_platform
 from vllm.utils.math_utils import round_up
 from vllm.v1.attention.backend import AttentionCGSupport
 from vllm.v1.attention.backends.mla.sparse_swa import DeepseekSparseSWABackend
@@ -63,6 +64,12 @@ def __init__(self, *args, **kwargs) -> None:
             self._o_proj_block_size
         )
         register_dsv41_o_proj_warmup(self)
+        self._prefill_num_heads = (
+            self.n_local_heads
+            if current_platform.is_device_capability_family(90)
+            and self.n_local_heads in (8, 16, 32)
+            else self.padded_heads
+        )
 
     def _o_proj(self, attn_out: torch.Tensor, positions: torch.Tensor) -> torch.Tensor:
         return dsv41_o_proj(self, attn_out, positions)
@@ -361,11 +368,11 @@ def _forward_prefill(
                 out=(combined_indices_out, combined_lens_out),
             )
             flash_mla_sparse_fwd(
-                q=q[query_start:query_end],
+                q=q[query_start:query_end, : self._prefill_num_heads],
                 kv=kv.view(-1, 1, q.shape[-1]),
                 indices=combined_indices.unsqueeze(1),
                 sm_scale=self.scale,
-                attn_sink=self.attn_sink,
+                attn_sink=self.attn_sink[: self._prefill_num_heads],
                 topk_length=combined_lens,
-                out=output[query_start:query_end],
+                out=output[query_start:query_end, : self._prefill_num_heads],
             )

