+__device__ __forceinline__ void desc_add_lo(SmemDescPair& d, uint32_t inc) {
+  asm volatile(
+      "{\n\t"
+      ".reg .b32 lo, hi;\n\t"
+      "mov.b64 {lo, hi}, %0;\n\t"
+      "add.u32 lo, lo, %1;\n\t"
+      "mov.b64 %0, {lo, hi};\n\t"
+      "}"
+      : "+l"(d.u64)
+      : "r"(inc));
+}
