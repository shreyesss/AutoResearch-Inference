+  ],
+  quantizations: [{ id: "bf16", label: "BF16" }],
+  strategies: [{ id: "balanced", label: "Balanced" }],
+  nodesOptions: [{ id: "single", label: "Single Node" }],
+
+  modelNames: {
+    "default|bf16": "perplexity-ai/pplx-decider-v1.1-27b",
