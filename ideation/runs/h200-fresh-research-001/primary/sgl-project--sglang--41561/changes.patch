+@pytest.mark.parametrize("remainder", [1, 2, 3])
+@pytest.mark.parametrize(
+    "num_experts,num_tokens",
+    [
+        (32, 8),  # small-batch kernel: <= 64 buckets and numel < 1024
+        (128, 640),  # generic kernel: <= 1024 buckets
+        (1025, 640),  # v2 kernel: > 1024 buckets
+    ],
