From 726bee2f0b3bb0dfbb399446cc30f3761c6cb6cc Mon Sep 17 00:00:00 2001
From: stdlibstring <159357369p@gmail.com>
Date: Tue, 20 Oct 2026 23:54:53 +0800
Subject: [PATCH] fix: validate draft acceptance probabilities in Pareto plots

---
 examples/sweep/plot_pareto.py        |  4 +++-
 tests/test_plot_pareto_acceptance.py | 24 ++++++++++++++++++++++++
 2 files changed, 27 insertions(+), 1 deletion(-)
 create mode 100644 tests/test_plot_pareto_acceptance.py

diff --git a/examples/sweep/plot_pareto.py b/examples/sweep/plot_pareto.py
index 633e75d..ae0c0c4 100644
--- a/examples/sweep/plot_pareto.py
+++ b/examples/sweep/plot_pareto.py
@@ -58,6 +58,8 @@ def load_points(path: Path, mode: str) -> list[dict]:
 def decode_tau(points: list[dict], draft_acceptance: float) -> float:
     """τ = 1 + nextn × a：每 step 期望接受 nextn × a 个 draft token，另加 1 个主模型 token。"""
     assert not points[0]["mtp_varlen"], "VARLEN=1 时 avg_SPS 已含接受率，不能再乘 τ；这组数据不能用本口径出图"
+    if not 0.0 <= draft_acceptance <= 1.0:
+        raise ValueError(f"draft_acceptance must be in [0, 1], got {draft_acceptance!r}")
     return 1 + points[0]["nextn"] * draft_acceptance
 
 
@@ -131,7 +133,7 @@ def main() -> None:
         "--draft_acceptance",
         default=1.0,
         type=float,
-        help="decode 的逐 token draft 接受率，τ = 1 + nextn × a；默认 1.0 即满接受口径",
+        help="decode 的逐 token draft 接受率，取值范围 [0, 1]，τ = 1 + nextn × a；默认 1.0 即满接受口径",
     )
     args = parser.parse_args()
 
diff --git a/tests/test_plot_pareto_acceptance.py b/tests/test_plot_pareto_acceptance.py
new file mode 100644
index 0000000..2268460
--- /dev/null
+++ b/tests/test_plot_pareto_acceptance.py
@@ -0,0 +1,24 @@
+import pytest
+
+from examples.sweep.plot_pareto import decode_tau
+
+pytestmark = [pytest.mark.ci, pytest.mark.ci_npu]
+
+
+@pytest.mark.parametrize("nextn", [0, 5])
+@pytest.mark.parametrize("draft_acceptance", [-0.5, 1.5, float("nan"), float("inf"), -float("inf")])
+def test_decode_tau_rejects_invalid_acceptance(nextn: int, draft_acceptance: float) -> None:
+    points = [{"mtp_varlen": False, "nextn": nextn}]
+
+    with pytest.raises(ValueError, match="draft_acceptance must be in"):
+        decode_tau(points, draft_acceptance)
+
+
+@pytest.mark.parametrize(
+    "nextn,draft_acceptance,expected_tau",
+    [(0, 0.0, 1.0), (0, 0.75, 1.0), (0, 1.0, 1.0), (5, 0.0, 1.0), (5, 0.75, 4.75), (5, 1.0, 6.0)],
+)
+def test_decode_tau_accepts_valid_probabilities(nextn: int, draft_acceptance: float, expected_tau: float) -> None:
+    points = [{"mtp_varlen": False, "nextn": nextn}]
+
+    assert decode_tau(points, draft_acceptance) == expected_tau
