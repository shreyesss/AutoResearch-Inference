    "title": "[Bugfix][Spec Decode] Mask prefix-cache-restored tokens out of the DFlash/DSpark draft context",
    "user": {
      "login": "giorgiopiatti-caffeinated",
      "id": 193884371,
      "node_id": "U_kgDOC45w0w",
      "avatar_url": "https://avatars.githubusercontent.com/u/193884371?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/giorgiopiatti-caffeinated",
