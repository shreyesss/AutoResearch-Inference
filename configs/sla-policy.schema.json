{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application SLA policy for an inference workload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "confidence_level", "classes"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "policy_id": {"type": "string", "minLength": 1},
    "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "classes": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["percentile", "ttft_ms", "tpot_ms", "max_error_fraction", "min_eligible_requests"],
        "properties": {
          "percentile": {"enum": ["p50", "p90", "p95", "p99"]},
          "ttft_ms": {"type": "number", "exclusiveMinimum": 0},
          "tpot_ms": {"type": "number", "exclusiveMinimum": 0},
          "max_error_fraction": {"type": "number", "minimum": 0, "maximum": 1},
          "min_eligible_requests": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
