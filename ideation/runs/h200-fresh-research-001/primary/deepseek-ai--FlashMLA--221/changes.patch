+        (bf16*)kv.data_ptr(),
+        (int*)indices.data_ptr(),
+        ku::get_optional_tensor_ptr<int>(topk_length),
+        ku::get_optional_tensor_ptr<float>(attn_sink),
+        (float*)lse.data_ptr(),
