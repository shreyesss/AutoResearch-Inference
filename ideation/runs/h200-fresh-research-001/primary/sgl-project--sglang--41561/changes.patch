+        // The node whose only carrier was the rogue worker is pruned; see
+        // `prune_carrier_less`.
+        assert_eq!(
+            vetted.nodes.len(),
+            1,
+            "carrier-less leaf must be pruned, not retained as structure",
+        );
+    }
