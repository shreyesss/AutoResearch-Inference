-def rope_tail(
-    x: torch.Tensor, freqs: torch.Tensor, rope_dim: int, inverse: bool = False
-) -> torch.Tensor:
-    """Rotate the last rope_dim features of x [T, ..., D] with complex freqs [T, rope_dim // 2]."""
