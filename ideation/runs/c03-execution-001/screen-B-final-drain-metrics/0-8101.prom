vllm:num_requests_waiting_by_reason{engine="2",model_name="deepseek-v4.1-flash",reason="deferred"} 0.0
vllm:num_requests_waiting_by_reason{engine="3",model_name="deepseek-v4.1-flash",reason="deferred"} 0.0
# HELP vllm:engine_sleep_state Engine sleep state; awake = 0 means engine is sleeping; awake = 1 means engine is awake; weights_offloaded = 1 means sleep level 1; discard_all = 1 means sleep level 2.
