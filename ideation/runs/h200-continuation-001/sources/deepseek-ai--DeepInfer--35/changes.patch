diff --git a/tests/engine/test_scheduler_decode_blocks.py b/tests/engine/test_scheduler_decode_blocks.py
new file mode 100644
index 0000000..73ef396
--- /dev/null
+++ b/tests/engine/test_scheduler_decode_blocks.py
@@ -0,0 +1,88 @@
+"""Decode admission must account for blocks already owned by each request."""
+
+from collections.abc import Callable
+
+import pytest
+import torch
+
+from deepinfer._C.engine import BlockManager, Scheduler, Sequence, SequenceData, SequenceMetadataPool, SequenceStatus
+
+
+@pytest.mark.parametrize("nextn", [0, 5])
+@pytest.mark.parametrize("overlap", [False, True])
+@pytest.mark.parametrize("stop_preempted_request", [False, True])
+def test_full_cache_can_decode_with_existing_reservation(
+    scheduler_factory: Callable[..., tuple[Scheduler, BlockManager, BlockManager | None]],
+    sequence_factory: Callable[..., Sequence],
+    metadata_pool: SequenceMetadataPool,
+    nextn: int,
+    overlap: bool,
+    stop_preempted_request: bool,
+) -> None:
+    scheduler, blocks, states = scheduler_factory(
+        num_blocks=4, num_states=2, nextn=nextn, stop_preempted_request=stop_preempted_request
+    )
+    seq = sequence_factory(length=33)
+    scheduler.add_sequence(seq)
+    metadata, output = scheduler.schedule(metadata_pool)
+    assert output.prompt_run
+    scheduler.process_outputs(output, torch.empty(0, dtype=torch.int32), torch.tensor([1], dtype=torch.int32), None)
+    metadata_pool.release(metadata)
+    seq.last_next_n_token = [1] * nextn
+
+    assert blocks.get_num_free_blocks() == 0
+    for _ in range(2 if overlap else 1):
+        # Leaving the previous decode uncommitted models the in-flight
+        # reservation present when zero-overhead scheduling overlaps steps.
+        metadata, output = scheduler.schedule(metadata_pool)
+        assert not output.prompt_run
+        assert output.scheduled_seqs == [seq]
+        assert seq.status == SequenceStatus.RUNNING
+        assert scheduler.get_num_preempted_seqs() == 0
+        assert blocks.get_num_free_blocks() == 0
+        assert states is not None and states.get_num_free_blocks() == 0
+        metadata_pool.release(metadata)
+
+
+@pytest.mark.parametrize("stop_preempted_request", [False, True])
+@pytest.mark.parametrize(
+    ("owned", "required", "usable", "scheduled", "free_after"),
+    [
+        (3, 2, 3, True, 1),  # Rejected drafts leave a surplus, with no free blocks.
+        (2, 4, 4, True, 0),  # More than one block must be appended.
+        (2, 3, 2, False, 2),  # A real deficit still requires preemption.
+    ],
+)
+def test_decode_resizes_to_the_full_block_requirement(
+    scheduler_factory: Callable[..., tuple[Scheduler, BlockManager, BlockManager | None]],
+    sequence_factory: Callable[..., Sequence],
+    metadata_pool: SequenceMetadataPool,
+    stop_preempted_request: bool,
+    owned: int,
+    required: int,
+    usable: int,
+    scheduled: bool,
+    free_after: int,
+) -> None:
+    scheduler, blocks, states = scheduler_factory(
+        num_blocks=usable + 1, num_states=2, stop_preempted_request=stop_preempted_request
+    )
+    seq = sequence_factory(length=owned * 16 - 8)
+    assert scheduler.try_allocate_seq(seq)
+    # Seed an owned reservation before the sequence length changes. This
+    # isolates admission and resizing without executing a model.
+    seq.data = SequenceData([1] * (required * 16 - 8))
+    seq.compressed_data = SequenceData([1] * (required * 16 - 8))
+    seq.status = SequenceStatus.RUNNING
+    scheduler.running = [seq]
+
+    metadata, output = scheduler.schedule(metadata_pool)
+    assert output.scheduled_seqs == ([seq] if scheduled else [])
+    assert scheduler.get_num_preempted_seqs() == (0 if scheduled else 1)
+    assert blocks.get_num_free_blocks() == free_after
+    assert states is not None and states.get_num_free_blocks() == (0 if scheduled else 1)
+    if not scheduled:
+        expected = SequenceStatus.FINISHED_PREEMPTED if stop_preempted_request else SequenceStatus.WAITING
+        assert seq.status == expected
+        assert list(scheduler.waiting) == ([] if stop_preempted_request else [seq])
+    metadata_pool.release(metadata)

From 0e1fc327dc13895fc9fcdf58882a02689dcabb6e Mon Sep 17 00:00:00 2001
From: morluto <76467478+morluto@users.noreply.github.com>
Date: Tue, 20 Oct 2026 18:23:10 +0800
Subject: [PATCH 4/6] fix: reclaim cache references from terminated waiting
 sequences

---
 csrc/engine/scheduler.hpp                  |   4 +
 tests/engine/test_scheduler_reclamation.py | 140 +++++++++++++++++++++
 2 files changed, 144 insertions(+)
 create mode 100644 tests/engine/test_scheduler_reclamation.py

diff --git a/csrc/engine/scheduler.hpp b/csrc/engine/scheduler.hpp
index fec483e..7ff061d 100644
--- a/csrc/engine/scheduler.hpp
+++ b/csrc/engine/scheduler.hpp
@@ -362,6 +362,8 @@ struct Scheduler {
             // 入队前已判死的 seq 不跑 prefill，进 ignored_seqs 带 finish_reason 回传
             if (seq->schedule.status == SequenceStatus::FINISHED_ABORTED || seq->schedule.status == SequenceStatus::FINISHED_VE_FAILED ||
                 seq->schedule.status == SequenceStatus::FINISHED_SO_FAILED) {
+                // A completed prefill chunk (or a fork) can already own cache references.
+                free_seq_nolock(*seq);
                 ignored_seqs.push_back(seq);
                 waiting.pop_front();
                 continue;
@@ -569,6 +571,7 @@ struct Scheduler {
         std::vector<SequencePtr> ignored_seqs;
         for (auto it = waiting.begin(); it != waiting.end();) {
             if ((*it)->is_finished()) {
+                free_seq_nolock(**it);
                 ignored_seqs.push_back(std::move(*it));
                 it = waiting.erase(it);
             } else {
@@ -740,6 +743,7 @@ struct Scheduler {
         release_mtp_info_slot(seq);
         if (seq.cache.state_id != -1) {
             state_manager->free_blocks_nolock({seq.cache.state_id});
+            seq.cache.state_id = -1;
         }
         block_manager->free_blocks_nolock(seq.cache.block_table);
         seq.cache.block_table.clear();
diff --git a/tests/engine/test_scheduler_reclamation.py b/tests/engine/test_scheduler_reclamation.py
new file mode 100644
index 0000000..3bccca3
--- /dev/null
+++ b/tests/engine/test_scheduler_reclamation.py
@@ -0,0 +1,140 @@
+"""Exercise real scheduler allocation ownership without launching a model."""
+
+from collections.abc import Callable
+
+import pytest
+import torch
+
+from deepinfer._C.engine import Scheduler, SequenceData, SequenceMetadataPool, SequenceStatus
+
+pytestmark = [pytest.mark.ci, pytest.mark.ci_npu]
+
+
+def _cleanup_waiting(scheduler: Scheduler, metadata_pool: SequenceMetadataPool, phase: str) -> None:
+    scheduler.decode_step = 0 if phase == "prefill" else 1
+    metadata, outputs = scheduler.schedule(metadata_pool)
+    assert outputs.prompt_run == (phase == "prefill")
+    assert outputs.is_empty()
+    metadata_pool.release(metadata)
+    assert not scheduler.has_unfinished_seqs()
+
+
+@pytest.mark.parametrize("phase", ["prefill", "decode"])
+@pytest.mark.parametrize("num_states", [None, 5])
+@pytest.mark.parametrize("nextn", [0, 5])
+@pytest.mark.parametrize("terminal_status", ["FINISHED_ABORTED", "FINISHED_VE_FAILED", "FINISHED_SO_FAILED"])
+def test_completed_partial_prefill_releases_cache_when_terminated(
+    scheduler_factory: Callable,
+    sequence_factory: Callable,
+    metadata_pool: SequenceMetadataPool,
+    phase: str,
+    num_states: int | None,
+    nextn: int,
+    terminal_status: str,
+) -> None:
+    scheduler, blocks, states = scheduler_factory(num_blocks=17, num_states=num_states, nextn=nextn)
+    # More cancellations than the allocator capacity catch cumulative leaks.
+    for _ in range(20):
+        seq = sequence_factory()
+        scheduler.add_sequence(seq)
+        scheduler.decode_step = 0
+        metadata, outputs = scheduler.schedule(metadata_pool)
+        assert outputs.prompt_run
+        assert outputs.scheduled_seqs == [seq]
+        assert seq.chunked_rest_len == 64
+        assert blocks.get_num_free_blocks() == 8
+        if states is not None:
+            assert states.get_num_free_blocks() == 3
+        # Mirrors the engine's commit after the prefill completion event.
+        scheduler.process_outputs(
+            outputs,
+            torch.empty(0, dtype=torch.int32),
+            torch.tensor([1], dtype=torch.int32),
+            None,
+        )
+        metadata_pool.release(metadata)
+        assert seq.num_cached_tokens == 64
+        assert scheduler.waiting == [seq]
+        if terminal_status == "FINISHED_ABORTED":
+            assert scheduler.abort_sequence([seq.request_id]) == [seq]
+        else:
+            seq.status = getattr(SequenceStatus, terminal_status)
+
+        _cleanup_waiting(scheduler, metadata_pool, phase)
+        assert blocks.get_num_free_blocks() == 16
+        assert seq.state_id == -1
+        if states is not None:
+            assert states.get_num_free_blocks() == 4
+
+
+@pytest.mark.parametrize("phase", ["prefill", "decode"])
+def test_aborting_a_preempted_recompute_does_not_free_state_twice(
+    scheduler_factory: Callable, sequence_factory: Callable, metadata_pool: SequenceMetadataPool, phase: str
+) -> None:
+    scheduler, blocks, states = scheduler_factory(num_blocks=17, num_states=5, stop_preempted_request=False, nextn=0)
+    seq = sequence_factory()
+    assert scheduler.try_allocate_seq(seq)
+    seq.num_cached_tokens = 128
+    # Require a ninth block while owning eight, including after deficit-aware scheduling.
+    seq.data = SequenceData([1] * 129)
+    seq.compressed_data = SequenceData([1] * 129)
+    seq.status = SequenceStatus.RUNNING
+    scheduler.running = [seq]
+    # Leave no free blocks, forcing the existing preemption path.
+    reserved = blocks.allocate_nolock(blocks.get_num_free_blocks())
+    scheduler.decode_step = 1
+    metadata, outputs = scheduler.schedule(metadata_pool)
+    metadata_pool.release(metadata)
+    assert outputs.is_empty()
+    assert seq.status == SequenceStatus.WAITING
+    assert scheduler.waiting == [seq]
+    assert seq.state_id == -1
+    assert states.get_num_free_blocks() == 4
+
+    scheduler.abort_sequence([seq.request_id])
+    _cleanup_waiting(scheduler, metadata_pool, phase)
+    assert states.get_num_free_blocks() == 4
+    assert blocks.get_num_free_blocks() == 8
+    blocks.unpin_blocks(reserved)
+    assert blocks.get_num_free_blocks() == 16
+
+
+@pytest.mark.parametrize("phase", ["prefill", "decode"])
+def test_aborted_fork_releases_only_its_own_references(
+    scheduler_factory: Callable, sequence_factory: Callable, metadata_pool: SequenceMetadataPool, phase: str
+) -> None:
+    scheduler, blocks, states = scheduler_factory(num_blocks=17, num_states=5)
+    parent = sequence_factory(request_id="parent")
+    assert scheduler.try_allocate_seq(parent)
+    parent.num_cached_tokens = 64
+    child = scheduler.fork_seq(parent, None, "_child", parent.sampling_params, None, 1, -1, 2, 0.0)
+    child.request_id = "child"
+    scheduler.abort_sequence(["child"])
+    _cleanup_waiting(scheduler, metadata_pool, phase)
+    assert child.state_id == -1
+    assert parent.state_id != -1
+    assert blocks.get_num_free_blocks() == 8
+    assert states.get_num_free_blocks() == 3
+    scheduler.free_seq(parent)
+    assert blocks.get_num_free_blocks() == 16
+    assert states.get_num_free_blocks() == 4
+
+
+def test_rejected_fork_has_no_stale_state_handle(
+    scheduler_factory: Callable, sequence_factory: Callable, metadata_pool: SequenceMetadataPool
+) -> None:
+    scheduler, blocks, states = scheduler_factory(num_blocks=17, num_states=5, max_model_len=64)
+    parent = sequence_factory(request_id="parent")
+    assert scheduler.try_allocate_seq(parent)
+    parent.num_cached_tokens = 64
+    child = scheduler.fork_seq(parent, None, "_child", parent.sampling_params, None, 1, -1, 2, 0.0)
+    _cleanup_waiting(scheduler, metadata_pool, "prefill")
+    assert child.status == SequenceStatus.FINISHED_IGNORED
+    assert child.state_id == -1
+    # The fork rejection already freed the child's pins; a repeated visit is harmless.
+    scheduler.free_seq(child)
+    assert blocks.get_num_free_blocks() == 8
+    assert states.get_num_free_blocks() == 3
+    scheduler.free_seq(parent)
+    assert blocks.get_num_free_blocks() == 16
+    assert states.get_num_free_blocks() == 4

