+@requires_kernel
+def test_fp16_activations_are_cast_and_returned_in_fp16():
+    config = _jit_config()
+    layer, weight = _quantized_layer(config, 3072, 3072, "attn.to_q", seed=3)
+    x = torch.randn(2, 64, 3072, device="cuda", dtype=torch.float16)
+    out, _ = layer(x)
