+        for (const a of add) if (!names.has(a[0])) b.args.push([...a]);
+        b.args.sort(cmpArgs);
+        for (const [k, v] of Object.entries(env)) if (b.env[k] === undefined) b.env[k] = v;
+        b.env = sortedObj(b.env);
+      }
+      out.push(b);
+    }
