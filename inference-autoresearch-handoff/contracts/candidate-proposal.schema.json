{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CandidateProposal v0.2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "proposal_id": {
      "type": "string"
    },
    "parent_configuration_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "type": "object",
      "properties": {
        "max_num_seqs": {
          "enum": [
            8,
            16,
            32,
            64,
            128
          ]
        },
        "max_num_batched_tokens": {
          "enum": [
            2048,
            4096,
            8192,
            16384
          ]
        },
        "gpu_memory_utilization": {
          "enum": [
            0.85,
            0.9,
            0.93
          ]
        },
        "enable_prefix_caching": {
          "type": "boolean"
        },
        "mtp_draft_tokens": {
          "enum": [
            0,
            1,
            2,
            3,
            5
          ]
        },
        "graph_mode": {
          "enum": [
            "default",
            "eager"
          ]
        },
        "max_cudagraph_capture_size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "hypothesis": {
      "type": "string"
    },
    "expected_tradeoff": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experiment_kind": {
      "enum": [
        "hypothesis",
        "exploration"
      ]
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "observation": {
            "type": "string"
          },
          "expected_change": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        },
        "required": [
          "observation",
          "expected_change",
          "scope"
        ],
        "additionalProperties": false
      }
    },
    "falsification_condition": {
      "type": "string",
      "minLength": 1
    },
    "requested_observations": {
      "type": "array",
      "items": {
        "enum": [
          "resolved_config",
          "queue_batch_summary",
          "token_budget_summary",
          "cache_memory_summary",
          "speculation_summary",
          "graph_summary",
          "targeted_profile"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "proposal_id",
    "parent_configuration_ids",
    "parameters",
    "hypothesis",
    "expected_tradeoff",
    "evidence_ids",
    "experiment_kind",
    "predictions",
    "falsification_condition",
    "requested_observations"
  ],
  "additionalProperties": false
}
