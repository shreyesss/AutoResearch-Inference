+def compute_seq_lens_cpu_lower_bound(
+    seq_lens_cpu_upper_bound_np: np.ndarray,
+    is_prefilling_np: np.ndarray,
+    num_speculative_steps: int,
+    num_reqs: int,
+) -> np.ndarray:
+    """CPU lower bound on seq_lens, as a new array.
+
+    The upper bound counts the drafts of the step in flight as accepted; up to
+    num_speculative_steps of them may be rejected, none on rows still
+    prefilling. Entries past num_reqs are copied as they are.
+    """
+    lower_bound_np = seq_lens_cpu_upper_bound_np.copy()
+    if num_speculative_steps > 0:
+        lower = lower_bound_np[:num_reqs]
+        np.subtract(
+            lower,
+            num_speculative_steps,
+            out=lower,
+            where=~is_prefilling_np[:num_reqs],
+        )
+        np.maximum(lower, 0, out=lower)
+    return lower_bound_np
+
