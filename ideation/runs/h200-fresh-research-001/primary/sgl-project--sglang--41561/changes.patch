--- /dev/null
+++ b/rust/sglang-api-codegen/src/emit.rs
@@ -0,0 +1,1081 @@
+//! Pass 2: render each message's serde implementation from its
+//! [`model::MessageModel`]. String-template emission; the output is checked
+//! in and rustfmt'd, so it is reviewed like hand-written code.
+//!
+//! JSON contracts implemented here (see proto/sglang/json/v1/options.proto):
+//! bare_list, tuple, one_or_many, tagged unions with passthrough, untagged
+//! unions, per-field null/default/presence rules, raw_json passthrough, and
+//! the IGNORE/DENY unknown-key policies with serde's own error texts.
+
+use std::collections::HashMap;
+
+use crate::model::{self, FieldKind, FieldModel, MessageKind, MessageModel, ScalarTy};
+use prost_reflect::DescriptorPool;
+
+pub fn emit_serde(descriptor_bytes: &[u8], package: &str) -> String {
+    let pool = DescriptorPool::decode(descriptor_bytes).expect("decode descriptor set");
+    let models = model::build_models(&pool, package);
+    let by_name: HashMap<&str, &MessageModel> =
+        models.iter().map(|m| (m.rust_name.as_str(), m)).collect();
+
+    let mut out = String::new();
+    out.push_str(
+        "// Generated by sglang-api-codegen from proto/sglang — DO NOT EDIT.\n\
+         // The sglang.json.v1 options in the schema are the JSON contract; edit the\n\
+         // .proto files and `cargo gen-api`.\n\n",
+    );
+    for m in &models {
+        match &m.kind {
+            MessageKind::Skip => {}
+            MessageKind::BareList { item } => emit_bare_list(&mut out, m, item),
+            MessageKind::Tuple { fields } => emit_tuple(&mut out, m, fields),
+            MessageKind::Transparent { field } => emit_transparent(&mut out, m, field),
+            MessageKind::OneOrMany {
+                oneof_mod,
+                one,
+                many,
+            } => emit_one_or_many(&mut out, m, oneof_mod, one, many, &by_name),
+            MessageKind::Untagged {
+                oneof_mod,
+                oneof_ident,
+                variants,
+            } => emit_untagged(&mut out, m, oneof_mod, oneof_ident, variants, &by_name),
+            MessageKind::TaggedUnion {
+                oneof_mod,
+                oneof_ident,
+                tag,
+                variants,
+                passthrough,
+            } => emit_tagged(
+                &mut out,
+                m,
+                oneof_mod,
+                oneof_ident,
+                tag,
+                variants,
+                passthrough.as_ref(),
+            ),
+            MessageKind::Struct {
+                deny_unknown,
+                fields,
+            } => emit_struct(&mut out, m, *deny_unknown, fields),
+        }
+    }
+    out
+}
+
+fn item_rust_ty(kind: &FieldKind) -> String {
+    match kind {
+        FieldKind::RepeatedScalar { ty } => ty.rust().to_string(),
+        FieldKind::RepeatedMessage { rust_path } => rust_path.clone(),
+        other => panic!("bare_list item must be repeated, got {other:?}"),
+    }
+}
+
+fn emit_bare_list(out: &mut String, m: &MessageModel, item: &FieldModel) {
+    let name = &m.rust_name;
+    let field = &item.rust_ident;
+    let item_ty = item_rust_ty(&item.kind);
+    out.push_str(&format!(
+        r#"impl ::serde::Serialize for {name} {{
+    fn serialize<S: ::serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {{
+        serializer.collect_seq(self.{field}.iter())
+    }}
+}}
+
+impl<'de> ::serde::Deserialize<'de> for {name} {{
+    fn deserialize<D: ::serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {{
+        Ok({name} {{
+            {field}: <::prost::alloc::vec::Vec<{item_ty}> as ::serde::Deserialize>::deserialize(deserializer)?,
+        }})
+    }}
+}}
+
+"#
+    ));
+}
+
+fn emit_transparent(out: &mut String, m: &MessageModel, field: &FieldModel) {
+    let name = &m.rust_name;
+    let ident = &field.rust_ident;
+    let ty = match &field.kind {
+        FieldKind::OptScalar { ty, .. } => ty.rust().to_string(),
+        FieldKind::Message { rust_path, .. } => rust_path.clone(),
+        other => panic!(
+            "{name}: transparent field must be an optional scalar or a message, got {other:?}"
+        ),
+    };
+    out.push_str(&format!(
+        r#"impl ::serde::Serialize for {name} {{
+    fn serialize<S: ::serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {{
+        self.{ident}.serialize(serializer)
+    }}
+}}
+
+impl<'de> ::serde::Deserialize<'de> for {name} {{
+    fn deserialize<D: ::serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {{
+        Ok({name} {{
+            {ident}: <Option<{ty}> as ::serde::Deserialize>::deserialize(deserializer)?,
+        }})
+    }}
+}}
+
+"#
+    ));
+}
+
+fn emit_tuple(out: &mut String, m: &MessageModel, fields: &[FieldModel]) {
+    let name = &m.rust_name;
+    let len = fields.len();
+    let mut ser_elems = String::new();
+    let mut de_elems = String::new();
+    for (i, f) in fields.iter().enumerate() {
+        let ident = &f.rust_ident;
+        ser_elems.push_str(&format!(
+            "        ::serde::ser::SerializeSeq::serialize_element(&mut seq, &self.{ident})?;\n"
+        ));
+        let ty = match &f.kind {
+            FieldKind::Scalar { ty, .. } => ty.rust().to_string(),
+            FieldKind::OptScalar { ty, .. } => format!("Option<{}>", ty.rust()),
+            other => panic!("tuple member kind {other:?} unsupported"),
+        };
+        de_elems.push_str(&format!(
+            "                let {ident}: {ty} = seq
+                    .next_element()?
+                    .ok_or_else(|| ::serde::de::Error::invalid_length({i}, &\"a {len}-element tuple\"))?;\n"
+        ));
+    }
+    let build: Vec<String> = fields.iter().map(|f| f.rust_ident.clone()).collect();
+    let build = build.join(", ");
+    out.push_str(&format!(
+        r#"impl ::serde::Serialize for {name} {{
+    fn serialize<S: ::serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {{
+        let mut seq = serializer.serialize_seq(Some({len}))?;
+{ser_elems}        ::serde::ser::SerializeSeq::end(seq)
+    }}
+}}
+
+impl<'de> ::serde::Deserialize<'de> for {name} {{
+    fn deserialize<D: ::serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {{
+        struct V;
+        impl<'de> ::serde::de::Visitor<'de> for V {{
+            type Value = {name};
+            fn expecting(&self, f: &mut ::core::fmt::Formatter) -> ::core::fmt::Result {{
+                f.write_str("a {len}-element tuple")
+            }}
+            fn visit_seq<A: ::serde::de::SeqAccess<'de>>(self, mut seq: A) -> Result<Self::Value, A::Error> {{
+{de_elems}                Ok({name} {{ {build} }})
+            }}
+        }}
+        deserializer.deserialize_seq(V)
+    }}
+}}
+
+"#
+    ));
+}
+
+fn emit_one_or_many(
+    out: &mut String,
+    m: &MessageModel,
+    oneof_mod: &str,
+    one: &model::VariantModel,
+    many: &model::VariantModel,
+    models: &HashMap<&str, &MessageModel>,
+) {
+    let name = &m.rust_name;
+    let one_v = &one.rust_variant;
+    let many_v = &many.rust_variant;
+    let many_ty = match &many.kind {
+        FieldKind::Message { rust_path, .. } => rust_path.clone(),
+        other => panic!("{name}: many arm must be a list message, got {other:?}"),
+    };
+
+    // The scalar-shape visitors the `one` arm answers to.
+    let one_visits = match &one.kind {
+        FieldKind::Scalar {
+            ty: ScalarTy::Str, ..
+        }
+        | FieldKind::OptScalar {
+            ty: ScalarTy::Str, ..
+        } => format!(
+            r#"            fn visit_str<E: ::serde::de::Error>(self, v: &str) -> Result<Self::Value, E> {{
+                Ok({name} {{ value: Some({oneof_mod}::Value::{one_v}(v.to_owned())) }})
+            }}
+            fn visit_string<E: ::serde::de::Error>(self, v: String) -> Result<Self::Value, E> {{
+                Ok({name} {{ value: Some({oneof_mod}::Value::{one_v}(v)) }})
+            }}
+"#
+        ),
+        FieldKind::Scalar {
+            ty: ScalarTy::Bool, ..
+        }
+        | FieldKind::OptScalar {
+            ty: ScalarTy::Bool, ..
+        } => format!(
+            r#"            fn visit_bool<E: ::serde::de::Error>(self, v: bool) -> Result<Self::Value, E> {{
+                Ok({name} {{ value: Some({oneof_mod}::Value::{one_v}(v)) }})
+            }}
+"#
+        ),
+        FieldKind::Scalar {
+            ty: ScalarTy::I64, ..
+        }
+        | FieldKind::OptScalar {
+            ty: ScalarTy::I64, ..
+        } => format!(
+            r#"            fn visit_i64<E: ::serde::de::Error>(self, v: i64) -> Result<Self::Value, E> {{
+                Ok({name} {{ value: Some({oneof_mod}::Value::{one_v}(v)) }})
+            }}
+            fn visit_u64<E: ::serde::de::Error>(self, v: u64) -> Result<Self::Value, E> {{
+                let v = i64::try_from(v).map_err(|_| E::custom("integer out of range"))?;
+                Ok({name} {{ value: Some({oneof_mod}::Value::{one_v}(v)) }})
+            }}
+"#
+        ),
+        // A message-typed `one` (SamplingParams, OptionalString wrappers):
+        // maps go to `one`; bare scalars for the Optional* wrappers arrive as
+        // visit_str/visit_i64 handled below in the wrapper-specific arm.
+        FieldKind::Message { rust_path, .. } => match rust_path.as_str() {
+            "OptionalString" => format!(
+                r#"            fn visit_str<E: ::serde::de::Error>(self, v: &str) -> Result<Self::Value, E> {{
+                Ok({name} {{ value: Some({oneof_mod}::Value::{one_v}(OptionalString {{ value: Some(v.to_owned()) }})) }})
+            }}
+            fn visit_string<E: ::serde::de::Error>(self, v: String) -> Result<Self::Value, E> {{
+                Ok({name} {{ value: Some({oneof_mod}::Value::{one_v}(OptionalString {{ value: Some(v) }})) }})
+            }}
+"#
+            ),
+            "OptionalInt64" => format!(
+                r#"            fn visit_i64<E: ::serde::de::Error>(self, v: i64) -> Result<Self::Value, E> {{
+                Ok({name} {{ value: Some({oneof_mod}::Value::{one_v}(OptionalInt64 {{ value: Some(v) }})) }})
+            }}
+            fn visit_u64<E: ::serde::de::Error>(self, v: u64) -> Result<Self::Value, E> {{
+                let v = i64::try_from(v).map_err(|_| E::custom("integer out of range"))?;
+                Ok({name} {{ value: Some({oneof_mod}::Value::{one_v}(OptionalInt64 {{ value: Some(v) }})) }})
+            }}
+"#
+            ),
+            _ => format!(
+                r#"            fn visit_map<A: ::serde::de::MapAccess<'de>>(self, map: A) -> Result<Self::Value, A::Error> {{
+                let one = <{path} as ::serde::Deserialize>::deserialize(
+                    ::serde::de::value::MapAccessDeserializer::new(map),
+                )?;
+                Ok({name} {{ value: Some({oneof_mod}::Value::{one_v}(one)) }})
+            }}
+"#,
+                path = rust_path
+            ),
+        },
+        other => panic!("{name}: unsupported one arm {other:?}"),
+    };
+
+    // Sequence handling. For a message-typed `one` whose JSON is ITSELF an
+    // array (TokenIds), the outer array is ambiguous: dispatch on the first
+    // element's shape (number => one flat id list, array/other => many).
+    let seq_visit = if let Some((one_ty, first_check)) = bare_scalar_list(&one.kind, models) {
+        format!(
+            r#"            fn visit_seq<A: ::serde::de::SeqAccess<'de>>(self, mut seq: A) -> Result<Self::Value, A::Error> {{
+                let Some(first) = seq.next_element::<::serde_json::Value>()? else {{
+                    // [] is one empty list (the untagged first-arm rule).
+                    return Ok({name} {{ value: Some({oneof_mod}::Value::{one_v}({one_ty}::default())) }});
+                }};
+                let is_number = {first_check};
+                let mut rest = vec![first];
+                while let Some(v) = seq.next_element::<::serde_json::Value>()? {{
+                    rest.push(v);
+                }}
+                let reparse = ::serde_json::Value::Array(rest);
+                if is_number {{
+                    let one: {one_ty} = ::serde_json::from_value(reparse)
+                        .map_err(::serde::de::Error::custom)?;
+                    Ok({name} {{ value: Some({oneof_mod}::Value::{one_v}(one)) }})
+                }} else {{
+                    let many: {many_ty} = ::serde_json::from_value(reparse)
+                        .map_err(::serde::de::Error::custom)?;
+                    Ok({name} {{ value: Some({oneof_mod}::Value::{many_v}(many)) }})
+                }}
+            }}
+"#
+        )
+    } else {
+        format!(
+            r#"            fn visit_seq<A: ::serde::de::SeqAccess<'de>>(self, seq: A) -> Result<Self::Value, A::Error> {{
+                let many = <{many_ty} as ::serde::Deserialize>::deserialize(
+                    ::serde::de::value::SeqAccessDeserializer::new(seq),
+                )?;
+                Ok({name} {{ value: Some({oneof_mod}::Value::{many_v}(many)) }})
+            }}
+"#
+        )
+    };
+
+    let companion = if matches!(&one.kind, FieldKind::Message { rust_path, .. } if rust_path == "SamplingParams")
+    {
+        format!(
+            "impl {name} {{\n    /// Protobuf arrival: recurse the absent-defaults rule into the params.\n    pub fn apply_absent_defaults(&mut self) {{\n        match self.value.as_mut() {{\n            Some({oneof_mod}::Value::{one_v}(p)) => p.apply_absent_defaults(),\n            Some({oneof_mod}::Value::{many_v}(l)) => {{\n                for p in &mut l.items {{\n                    p.apply_absent_defaults();\n                }}\n            }}\n            None => {{}}\n        }}\n    }}\n}}\n\n"
+        )
+    } else {
+        String::new()
+    };
+    out.push_str(&companion);
+    let expecting = format!("a value or an array of values for {name}");
+    out.push_str(&format!(
+        r#"impl ::serde::Serialize for {name} {{
+    fn serialize<S: ::serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {{
+        match &self.value {{
+            Some({oneof_mod}::Value::{one_v}(v)) => v.serialize(serializer),
+            Some({oneof_mod}::Value::{many_v}(v)) => v.serialize(serializer),
+            None => serializer.serialize_none(),
+        }}
+    }}
+}}
+
+impl<'de> ::serde::Deserialize<'de> for {name} {{
+    fn deserialize<D: ::serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {{
+        struct V;
+        impl<'de> ::serde::de::Visitor<'de> for V {{
+            type Value = {name};
+            fn expecting(&self, f: &mut ::core::fmt::Formatter) -> ::core::fmt::Result {{
+                f.write_str({expecting:?})
+            }}
+{one_visits}{seq_visit}        }}
+        deserializer.deserialize_any(V)
+    }}
+}}
+
+"#
+    ));
+}
+
+/// The JSON value shapes a field or message can take; the untagged dispatch
+/// keys on these.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+enum JsonShape {
+    Str,
+    Int,
+    Float,
+    Bool,
+    Map,
+    Seq,
+    Null,
+}
+
+fn scalar_shapes(ty: &ScalarTy) -> Vec<JsonShape> {
+    match ty {
+        ScalarTy::Str => vec![JsonShape::Str],
+        ScalarTy::I32 | ScalarTy::I64 | ScalarTy::U32 | ScalarTy::U64 => vec![JsonShape::Int],
+        ScalarTy::F64 => vec![JsonShape::Int, JsonShape::Float],
+        ScalarTy::Bool => vec![JsonShape::Bool],
+    }
+}
+
+fn kind_shapes(kind: &FieldKind, models: &HashMap<&str, &MessageModel>) -> Vec<JsonShape> {
+    match kind {
+        FieldKind::Scalar { ty, .. } | FieldKind::OptScalar { ty, .. } => scalar_shapes(ty),
+        FieldKind::Message { rust_path, .. } => message_shapes(rust_path, models),
+        FieldKind::RepeatedScalar { .. }
+        | FieldKind::RepeatedMessage { .. }
+        | FieldKind::RepeatedRawJson => vec![JsonShape::Seq],
+        FieldKind::Map { .. } => vec![JsonShape::Map],
+        FieldKind::RawJson { .. } => vec![
+            JsonShape::Str,
+            JsonShape::Int,
+            JsonShape::Float,
+            JsonShape::Bool,
+            JsonShape::Map,
+            JsonShape::Seq,
+            JsonShape::Null,
+        ],
+    }
+}
+
+fn message_shapes(name: &str, models: &HashMap<&str, &MessageModel>) -> Vec<JsonShape> {
+    let m = models
+        .get(name)
+        .unwrap_or_else(|| panic!("unknown message {name}"));
+    match &m.kind {
+        MessageKind::Struct { .. } | MessageKind::TaggedUnion { .. } => vec![JsonShape::Map],
+        MessageKind::Tuple { .. } | MessageKind::BareList { .. } => vec![JsonShape::Seq],
+        MessageKind::Transparent { field } => {
+            let mut s = kind_shapes(&field.kind, models);
+            s.push(JsonShape::Null);
+            s
+        }
+        MessageKind::Untagged { variants, .. } => {
+            let mut s = Vec::new();
+            for v in variants {
+                for shape in kind_shapes(&v.kind, models) {
+                    if !s.contains(&shape) {
+                        s.push(shape);
+                    }
+                }
+            }
+            s
+        }
+        MessageKind::OneOrMany { one, .. } => {
+            let mut s = kind_shapes(&one.kind, models);
+            if !s.contains(&JsonShape::Seq) {
+                s.push(JsonShape::Seq);
+            }
+            s
+        }
+        MessageKind::Skip => panic!("{name}: a gRPC-only message has no JSON shape"),
+    }
+}
+
+/// For a bare-list message: the shapes of one ELEMENT.
+fn element_shapes(name: &str, models: &HashMap<&str, &MessageModel>) -> Vec<JsonShape> {
+    let m = models
+        .get(name)
+        .unwrap_or_else(|| panic!("unknown message {name}"));
+    match &m.kind {
+        MessageKind::BareList { item } => match &item.kind {
+            FieldKind::RepeatedScalar { ty } => scalar_shapes(ty),
+            FieldKind::RepeatedMessage { rust_path } => message_shapes(rust_path, models),
+            other => panic!("{name}: bare_list item must be repeated, got {other:?}"),
+        },
+        other => panic!("{name}: not a bare list ({other:?})"),
+    }
+}
+
+/// A `one` arm that is a bare list of scalars: its Rust type and the
+/// `serde_json::Value` test that recognizes one of its elements.
+fn bare_scalar_list(
+    kind: &FieldKind,
+    models: &HashMap<&str, &MessageModel>,
+) -> Option<(String, &'static str)> {
+    let FieldKind::Message { rust_path, .. } = kind else {
+        return None;
+    };
+    let m = models.get(rust_path.as_str())?;
+    let MessageKind::BareList { item } = &m.kind else {
+        return None;
+    };
+    let FieldKind::RepeatedScalar { ty } = &item.kind else {
+        return None;
+    };
+    let check = match ty {
+        ScalarTy::Str => "first.is_string()",
+        ScalarTy::Bool => "first.is_boolean()",
+        _ => "first.is_number()",
+    };
+    Some((rust_path.clone(), check))
+}
+
+/// A message-typed arm built from a visited scalar `v`: the message's own
+/// `Deserialize` runs over a value deserializer, so its rules (unknown-key
+/// policy, nested unions) apply unchanged.
+fn via_value_deserializer(ty: &str, de: &str) -> String {
+    format!("<{ty} as ::serde::Deserialize>::deserialize(::serde::de::value::{de}::<E>::new(v))?")
+}
+
+fn emit_untagged(
+    out: &mut String,
+    m: &MessageModel,
+    oneof_mod: &str,
+    oneof_ident: &str,
+    variants: &[model::VariantModel],
+    models: &HashMap<&str, &MessageModel>,
+) {
+    let name = &m.rust_name;
+    let wrap = |var: &str, expr: &str| {
+        format!("Ok({name} {{ value: Some({oneof_mod}::{oneof_ident}::{var}({expr})) }})")
+    };
+    let mut ser_arms = String::new();
+    // shape -> the arms claiming it, in declaration order.
+    let mut claims: Vec<(JsonShape, Vec<&model::VariantModel>)> = Vec::new();
+    for v in variants {
+        ser_arms.push_str(&format!(
+            "            Some({oneof_mod}::{oneof_ident}::{}(v)) => v.serialize(serializer),\n",
+            v.rust_variant
+        ));
+        for shape in kind_shapes(&v.kind, models) {
+            match claims.iter_mut().find(|(s, _)| *s == shape) {
+                Some((_, arms)) => arms.push(v),
+                None => claims.push((shape, vec![v])),
+            }
+        }
+    }
+
+    let mut visits = String::new();
+    for (shape, arms) in &claims {
+        if *shape != JsonShape::Seq && arms.len() > 1 {
+            panic!(
+                "{name}: untagged arms {:?} all accept a JSON {shape:?}; the value's shape cannot pick one",
+                arms.iter().map(|a| &a.json_name).collect::<Vec<_>>()
+            );
+        }
+        let arm = arms[0];
+        let var = &arm.rust_variant;
+        // A scalar arm takes the value as-is; a message arm runs the message's
+        // own deserializer over it.
+        let scalar_arm = matches!(
+            arm.kind,
+            FieldKind::Scalar { .. } | FieldKind::OptScalar { .. }
+        );
+        let msg_ty = match &arm.kind {
+            FieldKind::Message { rust_path, .. } => Some(rust_path.as_str()),
+            _ => None,
+        };
+        let build = |de: &str, direct: &str| -> String {
+            if scalar_arm {
+                wrap(var, direct)
+            } else {
+                wrap(
+                    var,
+                    &via_value_deserializer(msg_ty.expect("message arm"), de),
+                )
+            }
+        };
+        let unit = |var: &str| {
+            wrap(
+                var,
+                &format!(
+                    "<{} as ::serde::Deserialize>::deserialize(::serde::de::value::UnitDeserializer::<E>::new())?",
+                    msg_ty.expect("null arm is a message")
+                ),
+            )
+        };
+        match shape {
+            JsonShape::Str => visits.push_str(&format!(
+                r#"            fn visit_str<E: ::serde::de::Error>(self, v: &str) -> Result<Self::Value, E> {{
+                {}
+            }}
+            fn visit_string<E: ::serde::de::Error>(self, v: String) -> Result<Self::Value, E> {{
+                {}
+            }}
+"#,
+                build("StrDeserializer", "v.to_owned()"),
+                build("StringDeserializer", "v")
+            )),
+            JsonShape::Int => visits.push_str(&format!(
+                r#"            fn visit_i64<E: ::serde::de::Error>(self, v: i64) -> Result<Self::Value, E> {{
+                {}
+            }}
+            fn visit_u64<E: ::serde::de::Error>(self, v: u64) -> Result<Self::Value, E> {{
+                let v = i64::try_from(v).map_err(|_| E::custom("integer out of range"))?;
+                {}
+            }}
+"#,
+                build("I64Deserializer", "v"),
+                build("I64Deserializer", "v")
+            )),
+            JsonShape::Float => visits.push_str(&format!(
+                r#"            fn visit_f64<E: ::serde::de::Error>(self, v: f64) -> Result<Self::Value, E> {{
+                {}
+            }}
+"#,
+                build("F64Deserializer", "v")
+            )),
+            JsonShape::Bool => visits.push_str(&format!(
+                r#"            fn visit_bool<E: ::serde::de::Error>(self, v: bool) -> Result<Self::Value, E> {{
+                {}
+            }}
+"#,
+                build("BoolDeserializer", "v")
+            )),
+            JsonShape::Null => visits.push_str(&format!(
+                r#"            fn visit_unit<E: ::serde::de::Error>(self) -> Result<Self::Value, E> {{
+                {}
+            }}
+            fn visit_none<E: ::serde::de::Error>(self) -> Result<Self::Value, E> {{
+                {}
+            }}
+"#,
+                unit(var),
+                unit(var)
+            )),
+            JsonShape::Map => visits.push_str(&format!(
+                r#"            fn visit_map<A: ::serde::de::MapAccess<'de>>(self, map: A) -> Result<Self::Value, A::Error> {{
+                let v = <{ty} as ::serde::Deserialize>::deserialize(
+                    ::serde::de::value::MapAccessDeserializer::new(map),
+                )?;
+                {}
+            }}
+"#,
+                wrap(var, "v"),
+                ty = msg_ty.expect("map arm is a message")
+            )),
+            JsonShape::Seq => {
+                if arms.len() == 1 {
+                    visits.push_str(&format!(
+                        r#"            fn visit_seq<A: ::serde::de::SeqAccess<'de>>(self, seq: A) -> Result<Self::Value, A::Error> {{
+                let v = <{ty} as ::serde::Deserialize>::deserialize(
+                    ::serde::de::value::SeqAccessDeserializer::new(seq),
+                )?;
+                {}
+            }}
+"#,
+                        wrap(var, "v"),
+                        ty = msg_ty.expect("seq arm is a message")
+                    ));
+                } else {
+                    // Two array-shaped arms: the one whose ELEMENTS are arrays
+                    // is the nested form; the first element decides, and `[]`
+                    // is the flat form.
+                    assert_eq!(arms.len(), 2, "{name}: more than two array-shaped untagged arms");
+                    let elem_is_seq = |a: &model::VariantModel| match &a.kind {
+                        FieldKind::Message { rust_path, .. } => {
+                            element_shapes(rust_path, models).contains(&JsonShape::Seq)
+                        }
+                        _ => false,
+                    };
+                    let (nested, flat) = match (elem_is_seq(arms[0]), elem_is_seq(arms[1])) {
+                        (true, false) => (arms[0], arms[1]),
+                        (false, true) => (arms[1], arms[0]),
+                        _ => panic!(
+                            "{name}: array-shaped arms {} and {} cannot be told apart by their first element",
+                            arms[0].json_name, arms[1].json_name
+                        ),
+                    };
+                    let ty_of = |a: &model::VariantModel| match &a.kind {
+                        FieldKind::Message { rust_path, .. } => rust_path.clone(),
+                        _ => unreachable!(),
+                    };
+                    visits.push_str(&format!(
+                        r#"            fn visit_seq<A: ::serde::de::SeqAccess<'de>>(self, mut seq: A) -> Result<Self::Value, A::Error> {{
+                let mut items: Vec<::serde_json::Value> = Vec::new();
+                while let Some(v) = seq.next_element::<::serde_json::Value>()? {{
+                    items.push(v);
+                }}
+                let nested = items.first().is_some_and(|f| f.is_array());
+                let reparse = ::serde_json::Value::Array(items);
+                if nested {{
+                    let v: {nested_ty} = ::serde_json::from_value(reparse)
+                        .map_err(::serde::de::Error::custom)?;
+                    {nested_ok}
+                }} else {{
+                    let v: {flat_ty} = ::serde_json::from_value(reparse)
+                        .map_err(::serde::de::Error::custom)?;
+                    {flat_ok}
+                }}
+            }}
+"#,
+                        nested_ty = ty_of(nested),
+                        flat_ty = ty_of(flat),
+                        nested_ok = wrap(&nested.rust_variant, "v"),
+                        flat_ok = wrap(&flat.rust_variant, "v"),
+                    ));
+                }
+            }
+        }
+    }
+    out.push_str(&format!(
+        r#"impl ::serde::Serialize for {name} {{
+    fn serialize<S: ::serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {{
+        match &self.value {{
+{ser_arms}            None => serializer.serialize_none(),
+        }}
+    }}
+}}
+
+impl<'de> ::serde::Deserialize<'de> for {name} {{
+    fn deserialize<D: ::serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {{
+        struct V;
+        impl<'de> ::serde::de::Visitor<'de> for V {{
+            type Value = {name};
+            fn expecting(&self, f: &mut ::core::fmt::Formatter) -> ::core::fmt::Result {{
+                f.write_str("one of the {name} shapes")
+            }}
+{visits}        }}
+        deserializer.deserialize_any(V)
+    }}
+}}
+
+"#
+    ));
+}
+
+/// Serialize one struct/payload field into `map` (a SerializeMap), honoring
+/// the field's presence/null rules. `always_emit_null` = tagged-union payload
+/// semantics: optional members emit null instead of being skipped.
+fn ser_field(f: &FieldModel, receiver: &str, always_emit_null: bool) -> String {
+    let key = &f.json_name;
+    let ident = &f.rust_ident;
+    let get = format!("{receiver}{ident}");
+    match &f.kind {
+        FieldKind::Scalar { .. } => format!(
+            "        ::serde::ser::SerializeMap::serialize_entry(&mut map, {key:?}, &{get})?;\n"
+        ),
+        FieldKind::OptScalar {
+            emit_null,
+            null_is_none_default,
+            ..
+        } => {
+            // null_is_none: None means "explicit null", distinct from absent
+            // (the default), so it must serialize as null to round-trip.
+            if *emit_null || always_emit_null || null_is_none_default.is_some() {
+                format!(
+                    "        ::serde::ser::SerializeMap::serialize_entry(&mut map, {key:?}, &{get})?;\n"
+                )
+            } else {
+                format!(
+                    "        if let Some(v) = &{get} {{\n            ::serde::ser::SerializeMap::serialize_entry(&mut map, {key:?}, v)?;\n        }}\n"
+                )
+            }
+        }
+        FieldKind::Message { emit_null, .. } => {
+            if *emit_null || always_emit_null {
+                format!(
+                    "        ::serde::ser::SerializeMap::serialize_entry(&mut map, {key:?}, &{get})?;\n"
+                )
+            } else {
+                format!(
+                    "        if let Some(v) = &{get} {{\n            ::serde::ser::SerializeMap::serialize_entry(&mut map, {key:?}, v)?;\n        }}\n"
+                )
+            }
+        }
+        FieldKind::RepeatedScalar { .. } | FieldKind::RepeatedMessage { .. } => format!(
+            "        if !{get}.is_empty() {{\n            ::serde::ser::SerializeMap::serialize_entry(&mut map, {key:?}, &{get})?;\n        }}\n"
+        ),
+        FieldKind::RepeatedRawJson => format!(
+            "        if !{get}.is_empty() {{\n            let rows: Vec<::serde_json::Value> = {get}\n                .iter()\n                .map(|s| ::serde_json::from_str(s).unwrap_or(::serde_json::Value::Null))\n                .collect();\n            ::serde::ser::SerializeMap::serialize_entry(&mut map, {key:?}, &rows)?;\n        }}\n"
+        ),
+        FieldKind::Map { .. } => format!(
+            "        if !{get}.is_empty() {{\n            ::serde::ser::SerializeMap::serialize_entry(&mut map, {key:?}, &{get})?;\n        }}\n"
+        ),
+        FieldKind::RawJson { emit_null } => {
+            let body = format!(
+                "::serde::ser::SerializeMap::serialize_entry(&mut map, {key:?}, &::serde_json::from_str::<::serde_json::Value>(v).unwrap_or(::serde_json::Value::Null))?;"
+            );
+            if *emit_null || always_emit_null {
+                format!(
+                    "        match &{get} {{\n            Some(v) => {{ {body} }}\n            None => {{ ::serde::ser::SerializeMap::serialize_entry(&mut map, {key:?}, &::serde_json::Value::Null)?; }}\n        }}\n"
+                )
+            } else {
+                format!("        if let Some(v) = &{get} {{\n            {body}\n        }}\n")
+            }
+        }
+    }
+}
+
+/// The visitor-arm statements deserializing one field's value into its local
+/// `Option<...>` slot named `f_<ident>` (positioned errors preserved via
+/// `map.next_value`).
+fn de_field_arm(f: &FieldModel) -> String {
+    let key = &f.json_name;
+    let ident = &f.rust_ident;
+    let slot = format!("f_{}", ident.trim_start_matches("r#"));
+    let dup = format!(
+        "                        if {slot}.is_some() {{\n                            return Err(::serde::de::Error::duplicate_field({key:?}));\n                        }}\n"
+    );
+    let read = match &f.kind {
+        FieldKind::Scalar { ty, null_default } => match null_default {
+            // Explicit null resets to the default (Python __post_init__
+            // parity); the value type still errors on shape mismatch.
+            Some(default) => format!(
+                "                        {slot} = Some(map.next_value::<Option<{ty}>>()?.unwrap_or_else(|| {default}));\n",
+                ty = ty.rust(),
+                default = default.rust()
+            ),
+            None => format!(
+                "                        {slot} = Some(map.next_value::<{ty}>()?);\n",
+                ty = ty.rust()
+            ),
+        },
+        FieldKind::OptScalar {
+            ty, null_default, ..
+        } => match null_default {
+            // null_resets_default: explicit null is the schema default.
+            Some(default) => format!(
+                "                        {slot} = Some(Some(map.next_value::<Option<{ty}>>()?.unwrap_or_else(|| {default})));\n",
+                ty = ty.rust(),
+                default = default.rust()
+            ),
+            None => format!(
+                "                        {slot} = Some(map.next_value::<Option<{ty}>>()?);\n",
+                ty = ty.rust()
+            ),
+        },
+        FieldKind::Message { rust_path, .. } => format!(
+            "                        {slot} = Some(map.next_value::<Option<{rust_path}>>()?);\n"
+        ),
+        FieldKind::RepeatedScalar { ty } => format!(
+            "                        {slot} = Some(map.next_value::<Option<Vec<{ty}>>>()?.unwrap_or_default());\n",
+            ty = ty.rust()
+        ),
+        FieldKind::RepeatedMessage { rust_path } => format!(
+            "                        {slot} = Some(map.next_value::<Option<Vec<{rust_path}>>>()?.unwrap_or_default());\n"
+        ),
+        FieldKind::RepeatedRawJson => format!(
+            "                        {slot} = Some(map.next_value::<Option<Vec<::serde_json::Value>>>()?.unwrap_or_default().into_iter().map(|v| v.to_string()).collect());\n"
+        ),
+        FieldKind::Map { value } => format!(
+            "                        {slot} = Some(map.next_value::<Option<::std::collections::HashMap<String, {ty}>>>()?.unwrap_or_default());\n",
+            ty = value.rust()
+        ),
+        FieldKind::RawJson { .. } => format!(
+            "                        {slot} = Some(map.next_value::<Option<::serde_json::Value>>()?.map(|v| v.to_string()));\n"
+        ),
+    };
+    format!("                    {key:?} => {{\n{dup}{read}                    }}\n")
+}
+
+/// The absent-key fallback expression building the struct field from its
+/// visitor slot.
+fn de_field_finish(f: &FieldModel) -> String {
+    let ident = &f.rust_ident;
+    let slot = format!("f_{}", ident.trim_start_matches("r#"));
+    let expr = match &f.kind {
+        FieldKind::Scalar { null_default, .. } => match null_default {
+            Some(default) => format!(
+                "{slot}.unwrap_or_else(|| {default})",
+                default = default.rust()
+            ),
+            None => format!("{slot}.unwrap_or_default()"),
+        },
+        FieldKind::OptScalar {
+            null_is_none_default,
+            null_default,
+            ..
+        } => match (null_is_none_default, null_default) {
+            // Absent => the default; explicit null => None (already in the
+            // slot as Some(None)).
+            (Some(default), _) | (_, Some(default)) => format!(
+                "{slot}.unwrap_or_else(|| Some({default}))",
+                default = default.rust()
+            ),
+            (None, None) => format!("{slot}.flatten()"),
+        },
+        FieldKind::Message { .. } => format!("{slot}.flatten()"),
+        FieldKind::RepeatedScalar { .. }
+        | FieldKind::RepeatedMessage { .. }
+        | FieldKind::RepeatedRawJson
+        | FieldKind::Map { .. } => format!("{slot}.unwrap_or_default()"),
+        FieldKind::RawJson { .. } => format!("{slot}.flatten()"),
+    };
+    format!("                    {ident}: {expr},\n")
+}
+
+/// Companion impl for a struct message: `*_or_default` accessors for every
+/// schema-defaulted field (protobuf arrival has presence but no baked
+/// defaults), and `apply_absent_defaults` filling every unset defaulted slot —
+/// the gRPC entry's "proto unset = JSON absent" rule, recursing into
+/// defaulted children.
+fn emit_struct_companion(out: &mut String, m: &MessageModel, fields: &[FieldModel]) {
+    let name = &m.rust_name;
+    let mut accessors = String::new();
+    let mut fills = String::new();
+    for f in fields {
+        let ident = &f.rust_ident;
+        let plain = ident.trim_start_matches("r#");
+        match &f.kind {
+            FieldKind::OptScalar {
+                ty,
+                null_default: Some(default),
+                ..
+            }
+            | FieldKind::OptScalar {
+                ty,
+                null_is_none_default: Some(default),
+                ..
+            } => {
+                let ty = ty.rust();
+                let default = default.rust();
+                accessors.push_str(&format!(
+                    "    /// The schema default when unset (protobuf arrival).\n    pub fn {plain}_or_default(&self) -> {ty} {{\n        self.{ident}.clone().unwrap_or_else(|| {default})\n    }}\n"
+                ));
+                fills.push_str(&format!(
+                    "        if self.{ident}.is_none() {{\n            self.{ident} = Some({default});\n        }}\n"
+                ));
+            }
+            FieldKind::Message { rust_path, .. }
+                if matches!(rust_path.as_str(), "SamplingParamsOrList") =>
+            {
+                fills.push_str(&format!(
+                    "        if let Some(v) = self.{ident}.as_mut() {{\n            v.apply_absent_defaults();\n        }}\n"
+                ));
+            }
+            _ => {}
+        }
+    }
+    if accessors.is_empty() && fills.is_empty() {
+        return;
+    }
+    out.push_str(&format!(
+        "impl {name} {{\n{accessors}    /// Protobuf arrival: unset defaulted fields become their schema\n    /// defaults (JSON arrival already baked them at deserialization).\n    pub fn apply_absent_defaults(&mut self) {{\n{fills}    }}\n}}\n\n"
+    ));
+}
+
+fn emit_struct(out: &mut String, m: &MessageModel, deny_unknown: bool, fields: &[FieldModel]) {
+    emit_struct_companion(out, m, fields);
+    let name = &m.rust_name;
+    let map_binding = if fields.is_empty() { "map" } else { "mut map" };
+    let mut ser_body = String::new();
+    for f in fields {
+        ser_body.push_str(&ser_field(f, "self.", false));
+    }
+    let mut arms = String::new();
+    let mut slots = String::new();
+    let mut finish = String::new();
+    let mut field_names = String::new();
+    for f in fields {
+        arms.push_str(&de_field_arm(f));
+        let slot = format!("f_{}", f.rust_ident.trim_start_matches("r#"));
+        slots.push_str(&format!("                let mut {slot} = None;\n"));
+        finish.push_str(&de_field_finish(f));
+        field_names.push_str(&format!("{:?}, ", f.json_name));
+    }
+    let unknown_arm = if deny_unknown {
+        "                    other => {\n                        return Err(::serde::de::Error::unknown_field(other, FIELDS));\n                    }\n"
+            .to_string()
+    } else {
+        "                    _ => {\n                        map.next_value::<::serde::de::IgnoredAny>()?;\n                    }\n"
+            .to_string()
+    };
+    let fields_const = if deny_unknown {
+        format!("        const FIELDS: &[&str] = &[{field_names}];\n")
+    } else {
+        String::new()
+    };
+    out.push_str(&format!(
+        r#"impl ::serde::Serialize for {name} {{
+    fn serialize<S: ::serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {{
+        let {map_binding} = serializer.serialize_map(None)?;
+{ser_body}        ::serde::ser::SerializeMap::end(map)
+    }}
+}}
+
+impl<'de> ::serde::Deserialize<'de> for {name} {{
+    fn deserialize<D: ::serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {{
+{fields_const}        struct V;
+        impl<'de> ::serde::de::Visitor<'de> for V {{
+            type Value = {name};
+            fn expecting(&self, f: &mut ::core::fmt::Formatter) -> ::core::fmt::Result {{
+                f.write_str("struct {name}")
+            }}
+            fn visit_map<A: ::serde::de::MapAccess<'de>>(self, mut map: A) -> Result<Self::Value, A::Error> {{
+{slots}                while let Some(key) = map.next_key::<::std::borrow::Cow<'_, str>>()? {{
+                    match key.as_ref() {{
+{arms}{unknown_arm}                    }}
+                }}
+                Ok({name} {{
+{finish}                }})
+            }}
+        }}
+        deserializer.deserialize_map(V)
+    }}
+}}
+
+"#
+    ));
+}
+
+fn emit_tagged(
+    out: &mut String,
+    m: &MessageModel,
+    oneof_mod: &str,
+    oneof_ident: &str,
+    tag: &str,
+    variants: &[model::VariantModel],
+    passthrough: Option<&model::VariantModel>,
+) {
+    let name = &m.rust_name;
+
+    // Serialize: {tag: variant_name, ...payload fields inlined (optional
+    // members as explicit nulls, matching serde's tagged-enum output)}.
+    let mut ser_arms = String::new();
+    for v in variants {
+        let var = &v.rust_variant;
+        let tag_value = &v.json_name;
+        let mut payload = String::new();
+        for f in &v.payload_fields {
+            payload.push_str(&ser_field(f, "v.", true));
+        }
+        ser_arms.push_str(&format!(
+            r#"            Some({oneof_mod}::{oneof_ident}::{var}(v)) => {{
+        let mut map = serializer.serialize_map(None)?;
+        ::serde::ser::SerializeMap::serialize_entry(&mut map, {tag:?}, {tag_value:?})?;
+{payload}        ::serde::ser::SerializeMap::end(map)
+            }}
+"#
+        ));
+    }
+    if let Some(p) = passthrough {
+        let var = &p.rust_variant;
+        ser_arms.push_str(&format!(
+            r#"            Some({oneof_mod}::{oneof_ident}::{var}(v)) => {{
+        ::serde::Serialize::serialize(&::serde_json::from_str::<::serde_json::Value>(v).unwrap_or(::serde_json::Value::Null), serializer)
+            }}
+"#
+        ));
+    }
+
+    // Deserialize: buffer the map (the tag can appear anywhere; a known tag
+    // whose payload fails to parse falls back to the passthrough arm, the
+    // hand-written FinishReason contract).
+    let mut de_arms = String::new();
+    for v in variants {
+        let var = &v.rust_variant;
+        let tag_value = &v.json_name;
+        let mut fields = String::new();
+        for f in &v.payload_fields {
+            let ident = &f.rust_ident;
+            let key = &f.json_name;
+            let read = match &f.kind {
+                FieldKind::OptScalar { ty, .. } => format!(
+                    "match raw.get({key:?}) {{ None | Some(::serde_json::Value::Null) => None, Some(v) => match ::serde_json::from_value::<{ty}>(v.clone()) {{ Ok(v) => Some(v), Err(_) => return fallback(raw) }} }}",
+                    ty = ty.rust()
+                ),
+                FieldKind::Message { rust_path, .. } => format!(
+                    "match raw.get({key:?}) {{ None | Some(::serde_json::Value::Null) => None, Some(v) => match ::serde_json::from_value::<{rust_path}>(v.clone()) {{ Ok(v) => Some(v), Err(_) => return fallback(raw) }} }}"
+                ),
+                other => panic!("{name}: tagged payload field kind {other:?} unsupported"),
+            };
+            fields.push_str(&format!("                    {ident}: {read},\n"));
+        }
+        de_arms.push_str(&format!(
+            r#"            Some({tag_value:?}) => {{
+                let payload = {payload_ty} {{
+{fields}                }};
+                Ok({name} {{ kind: Some({oneof_mod}::{oneof_ident}::{var}(payload.into())) }})
+            }}
+"#,
+            payload_ty = match &v.kind {
+                FieldKind::Message { rust_path, .. } => rust_path.clone(),
+                other => panic!("{name}: tagged variant must be message-typed, got {other:?}"),
+            }
+        ));
+    }
+    let fallback = match passthrough {
+        Some(p) => {
+            let var = &p.rust_variant;
+            format!(
+                r#"        fn fallback<E: ::serde::de::Error>(raw: ::serde_json::Map<String, ::serde_json::Value>) -> Result<{name}, E> {{
+            Ok({name} {{ kind: Some({oneof_mod}::{oneof_ident}::{var}(::serde_json::Value::Object(raw).to_string())) }})
+        }}
+"#
+            )
+        }
+        None => format!(
+            r#"        fn fallback<E: ::serde::de::Error>(_raw: ::serde_json::Map<String, ::serde_json::Value>) -> Result<{name}, E> {{
+            Err(E::custom("unknown {tag} for {name}"))
+        }}
+"#
+        ),
+    };
+
+    out.push_str(&format!(
+        r#"impl ::serde::Serialize for {name} {{
+    fn serialize<S: ::serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {{
+        match &self.kind {{
+{ser_arms}            None => serializer.serialize_none(),
+        }}
+    }}
+}}
+
+impl<'de> ::serde::Deserialize<'de> for {name} {{
+    fn deserialize<D: ::serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {{
+{fallback}        let raw = ::serde_json::Map::<String, ::serde_json::Value>::deserialize(deserializer)?;
+        let tag = raw.get({tag:?}).and_then(::serde_json::Value::as_str);
+        #[allow(clippy::redundant_closure_call)]
+        (|raw: ::serde_json::Map<String, ::serde_json::Value>| match tag {{
+{de_arms}            _ => fallback(raw),
+        }})(raw.clone())
+    }}
+}}
+
+"#
+    ));
+}
diff --git a/rust/sglang-api-codegen/src/emit_py.rs b/rust/sglang-api-codegen/src/emit_py.rs
new file mode 100644
index 000000000000..a9dd76d8c680
--- /dev/null
+++ b/rust/sglang-api-codegen/src/emit_py.rs
@@ -0,0 +1,1172 @@
+//! Pass 2 (Python): render the Python interface definition from the same
+//! [`model::MessageModel`]s the Rust serde emitter consumes, so both languages
+//! implement one JSON contract from one schema.
+//!
+//! The output is a single module over `typing` + `msgspec`. Each message maps
+//! to the Python shape its JSON contract implies rather than to a 1:1 mirror
+//! of the proto struct: plain objects and positional tuples are frozen
+//! `msgspec.Struct`s; bare lists are `List[T]`; one-or-many carriers are
+//! `Union[T, List[T]]`; transparent wrappers are `Optional[T]`; untagged
+//! unions are a `Union` of their arms; tagged unions are a `Union` of their
+//! payload Structs plus `Dict[str, Any]` for the passthrough arm. Every
+//! message gets `decode_<Name>` / `encode_<Name>` functions over parsed JSON
+//! values; Structs expose them as `from_json_value` / `to_json_value`.
+//! Contract violations raise `JsonContractError` carrying serde's error texts,
+//! so a 400 body reads the same from either server.
+
+use std::collections::{HashMap, HashSet};
+
+use crate::model::{
+    self, DefaultLit, FieldKind, FieldModel, MessageKind, MessageModel, ScalarTy, VariantModel,
+};
+use prost_reflect::DescriptorPool;
+
+const HEADER: &str = "# Generated by sglang-api-codegen from proto/sglang -- DO NOT EDIT.
+# The sglang.json.v1 options in the schema are the JSON contract; edit the
+# .proto files and `cargo gen-api`.
+\"\"\"Generated SGLang API types: the HTTP JSON interface of package {package}.
+
+Frozen msgspec Structs for JSON objects and tuples, type aliases for the other
+JSON shapes, and `decode_*` / `encode_*` codecs implementing the sglang.json.v1
+options exactly as the Rust server does. Decode with
+`X.from_json_value(json.loads(s))` and encode with `json.dumps(x.to_json_value())`.
+\"\"\"
+
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional, Tuple, Union
+
+import msgspec
+
+";
+
+const PRELUDE: &str = r#"class JsonContractError(ValueError):
+    """The JSON value violates the schema contract (an HTTP 400 in the server)."""
+
+
+def _is_number(v: Any) -> bool:
+    return isinstance(v, (int, float)) and not isinstance(v, bool)
+
+
+def _is_int(v: Any) -> bool:
+    return isinstance(v, int) and not isinstance(v, bool)
+
+
+def _unexpected(v: Any) -> str:
+    """serde's `Unexpected` display, so both languages report one text."""
+    if v is None:
+        return "null"
+    if isinstance(v, bool):
+        return f"boolean `{'true' if v else 'false'}`"
+    if isinstance(v, int):
+        return f"integer `{v}`"
+    if isinstance(v, float):
+        return f"floating point `{v}`"
+    if isinstance(v, str):
+        return f'string "{v}"'
+    if isinstance(v, list):
+        return "sequence"
+    if isinstance(v, dict):
+        return "map"
+    return type(v).__name__
+
+
+def _invalid_type(v: Any, expected: str) -> JsonContractError:
+    return JsonContractError(f"invalid type: {_unexpected(v)}, expected {expected}")
+
+
+def _expect_bool(v: Any, expected: str) -> bool:
+    if isinstance(v, bool):
+        return v
+    raise _invalid_type(v, expected=expected)
+
+
+def _expect_int(v: Any, expected: str) -> int:
+    if _is_int(v):
+        return v
+    raise _invalid_type(v, expected=expected)
+
+
+def _expect_uint(v: Any, expected: str) -> int:
+    if _is_int(v):
+        if v < 0:
+            raise JsonContractError(f"invalid value: integer `{v}`, expected {expected}")
+        return v
+    raise _invalid_type(v, expected=expected)
+
+
+def _expect_float(v: Any, expected: str) -> float:
+    if _is_number(v):
+        return float(v)
+    raise _invalid_type(v, expected=expected)
+
+
+def _expect_str(v: Any, expected: str) -> str:
+    if isinstance(v, str):
+        return v
+    raise _invalid_type(v, expected=expected)
+
+
+def _expect_seq(v: Any, expected: str) -> List[Any]:
+    if isinstance(v, list):
+        return v
+    raise _invalid_type(v, expected=expected)
+
+
+def _expect_map(v: Any, expected: str) -> Dict[str, Any]:
+    if isinstance(v, dict):
+        return v
+    raise _invalid_type(v, expected=expected)
+
+
+def _unknown_field(key: str, fields: Tuple[str, ...]) -> JsonContractError:
+    """serde's `unknown_field` text: the DENY policy's 400 body."""
+    if not fields:
+        return JsonContractError(f"unknown field `{key}`, there are no fields")
+    if len(fields) == 1:
+        return JsonContractError(f"unknown field `{key}`, expected `{fields[0]}`")
+    if len(fields) == 2:
+        return JsonContractError(
+            f"unknown field `{key}`, expected `{fields[0]}` or `{fields[1]}`"
+        )
+    listed = ", ".join(f"`{f}`" for f in fields)
+    return JsonContractError(f"unknown field `{key}`, expected one of {listed}")
+
+
+"#;
+
+/// The Python runtime shape a message name resolves to, for `isinstance`
+/// dispatch in union codecs and for ordering alias definitions.
+#[derive(Clone, Copy, PartialEq, Debug)]
+enum Shape {
+    /// A msgspec Struct class (Struct, Tuple).
+    Class,
+    /// A `List[...]` alias (BareList).
+    List,
+    /// Any other alias (Transparent, OneOrMany, unions): no single runtime type.
+    Value,
+}
+
+struct Ctx<'a> {
+    package: &'a str,
+    shapes: HashMap<&'a str, Shape>,
+    models: HashMap<&'a str, &'a MessageModel>,
+}
+
+impl<'a> Ctx<'a> {
+    fn new(models: &'a [MessageModel], package: &'a str) -> Self {
+        let mut shapes = HashMap::new();
+        let mut by_name = HashMap::new();
+        for m in models {
+            let shape = match &m.kind {
+                MessageKind::Struct { .. } | MessageKind::Tuple { .. } => Shape::Class,
+                MessageKind::BareList { .. } => Shape::List,
+                _ => Shape::Value,
+            };
+            shapes.insert(m.rust_name.as_str(), shape);
+            by_name.insert(m.rust_name.as_str(), m);
+        }
+        Ctx {
+            package,
+            shapes,
+            models: by_name,
+        }
+    }
+
+    fn shape(&self, name: &str) -> Shape {
+        *self
+            .shapes
+            .get(name)
+            .unwrap_or_else(|| panic!("unknown message {name}"))
+    }
+
+    fn model(&self, name: &str) -> &MessageModel {
+        self.models
+            .get(name)
+            .unwrap_or_else(|| panic!("unknown message {name}"))
+    }
+
+    fn full_name(&self, name: &str) -> String {
+        format!("{}.{name}", self.package)
+    }
+}
+
+pub fn emit_python(descriptor_bytes: &[u8], package: &str) -> String {
+    let pool = DescriptorPool::decode(descriptor_bytes).expect("decode descriptor set");
+    let models = model::build_models(&pool, package);
+    let ctx = Ctx::new(&models, package);
+
+    let mut out = String::new();
+    out.push_str(&HEADER.replace("{package}", package));
+    out.push_str(PRELUDE);
+
+    out.push_str("# ---- Structs: JSON objects and positional tuples ----\n\n\n");
+    for m in &models {
+        match &m.kind {
+            MessageKind::Struct {
+                deny_unknown,
+                fields,
+            } => emit_struct_class(&mut out, &ctx, m, *deny_unknown, fields),
+            MessageKind::Tuple { fields } => emit_tuple_class(&mut out, &ctx, m, fields),
+            _ => {}
+        }
+    }
+
+    out.push_str("# ---- type aliases: JSON shapes without an object of their own ----\n\n");
+    emit_aliases(&mut out, &ctx, &models);
+
+    out.push_str("\n# ---- codecs: parsed JSON value <-> Python value ----\n\n\n");
+    for m in &models {
+        match &m.kind {
+            MessageKind::Skip => {}
+            MessageKind::Struct {
+                deny_unknown,
+                fields,
+            } => emit_struct_codec(&mut out, m, *deny_unknown, fields),
+            MessageKind::Tuple { fields } => emit_tuple_codec(&mut out, m, fields),
+            MessageKind::BareList { item } => emit_bare_list_codec(&mut out, m, item),
+            MessageKind::Transparent { field } => emit_transparent_codec(&mut out, m, field),
+            MessageKind::OneOrMany { one, many, .. } => {
+                emit_one_or_many_codec(&mut out, &ctx, m, one, many)
+            }
+            MessageKind::Untagged { variants, .. } => {
+                emit_untagged_codec(&mut out, &ctx, m, variants)
+            }
+            MessageKind::TaggedUnion {
+                tag,
+                variants,
+                passthrough,
+                ..
+            } => emit_tagged_codec(&mut out, m, tag, variants, passthrough.as_ref()),
+        }
+    }
+    // One trailing newline: the end-of-file hook must not rewrite the output.
+    out.trim_end().to_string() + "\n"
+}
+
+// ---- naming and typing -------------------------------------------------
+
+/// Python keyword escaping for attribute names (the JSON key is unaffected).
+fn py_ident(name: &str) -> String {
+    const KEYWORDS: &[&str] = &[
+        "False", "None", "True", "and", "as", "assert", "async", "await", "break", "class",
+        "continue", "def", "del", "elif", "else", "except", "finally", "for", "from", "global",
+        "if", "import", "in", "is", "lambda", "nonlocal", "not", "or", "pass", "raise", "return",
+        "try", "while", "with", "yield",
+    ];
+    if KEYWORDS.contains(&name) {
+        format!("{name}_")
+    } else {
+        name.to_string()
+    }
+}
+
+fn py_scalar(ty: &ScalarTy) -> &'static str {
+    match ty {
+        ScalarTy::F64 => "float",
+        ScalarTy::I32 | ScalarTy::I64 | ScalarTy::U32 | ScalarTy::U64 => "int",
+        ScalarTy::Bool => "bool",
+        ScalarTy::Str => "str",
+    }
+}
+
+fn py_lit(d: &DefaultLit) -> String {
+    match d {
+        DefaultLit::F64(v) => format!("{v:?}"),
+        DefaultLit::I64(v) => v.to_string(),
+        DefaultLit::Bool(v) => if *v { "True" } else { "False" }.to_string(),
+        DefaultLit::Str(v) => format!("{v:?}"),
+    }
+}
+
+fn type_default(ty: &ScalarTy) -> &'static str {
+    match ty {
+        ScalarTy::F64 => "0.0",
+        ScalarTy::I32 | ScalarTy::I64 | ScalarTy::U32 | ScalarTy::U64 => "0",
+        ScalarTy::Bool => "False",
+        ScalarTy::Str => "\"\"",
+    }
+}
+
+/// The element type of a field: what a list holds, what an Optional wraps.
+fn inner_ty(kind: &FieldKind) -> String {
+    match kind {
+        FieldKind::Scalar { ty, .. }
+        | FieldKind::OptScalar { ty, .. }
+        | FieldKind::RepeatedScalar { ty } => py_scalar(ty).to_string(),
+        FieldKind::Message { rust_path, .. } | FieldKind::RepeatedMessage { rust_path } => {
+            rust_path.clone()
+        }
+        FieldKind::RepeatedRawJson | FieldKind::RawJson { .. } => "Any".to_string(),
+        FieldKind::Map { value } => format!("Dict[str, {}]", py_scalar(value)),
+    }
+}
+
+/// The Struct attribute annotation.
+fn field_ty(kind: &FieldKind) -> String {
+    match kind {
+        FieldKind::Scalar { .. } => inner_ty(kind),
+        FieldKind::OptScalar { .. } | FieldKind::Message { .. } | FieldKind::RawJson { .. } => {
+            format!("Optional[{}]", inner_ty(kind))
+        }
+        FieldKind::RepeatedScalar { .. }
+        | FieldKind::RepeatedMessage { .. }
+        | FieldKind::RepeatedRawJson => format!("List[{}]", inner_ty(kind)),
+        FieldKind::Map { .. } => inner_ty(kind),
+    }
+}
+
+/// The Struct default: the value an ABSENT JSON key yields.
+fn field_default(kind: &FieldKind) -> String {
+    match kind {
+        FieldKind::Scalar { ty, null_default } => null_default
+            .as_ref()
+            .map(py_lit)
+            .unwrap_or_else(|| type_default(ty).to_string()),
+        FieldKind::OptScalar {
+            null_is_none_default,
+            null_default,
+            ..
+        } => null_is_none_default
+            .as_ref()
+            .or(null_default.as_ref())
+            .map(py_lit)
+            .unwrap_or_else(|| "None".to_string()),
+        FieldKind::Message { .. } | FieldKind::RawJson { .. } => "None".to_string(),
+        FieldKind::RepeatedScalar { .. }
+        | FieldKind::RepeatedMessage { .. }
+        | FieldKind::RepeatedRawJson => "[]".to_string(),
+        FieldKind::Map { .. } => "{}".to_string(),
+    }
+}
+
+// ---- scalar codecs -----------------------------------------------------
+
+/// `_expect_*(var, "expected")` validating one scalar; `expected` defaults to
+/// serde's own type name for that scalar.
+fn expect_call(ty: &ScalarTy, var: &str, expected: Option<&str>) -> String {
+    let (func, default_expected) = match ty {
+        ScalarTy::F64 => ("_expect_float", "f64"),
+        ScalarTy::I32 => ("_expect_int", "i32"),
+        ScalarTy::I64 => ("_expect_int", "i64"),
+        ScalarTy::U32 => ("_expect_uint", "u32"),
+        ScalarTy::U64 => ("_expect_uint", "u64"),
+        ScalarTy::Bool => ("_expect_bool", "a boolean"),
+        ScalarTy::Str => ("_expect_str", "a string"),
+    };
+    format!(
+        "{func}({var}, expected={:?})",
+        expected.unwrap_or(default_expected)
+    )
+}
+
+/// Encoding a scalar: identity, except doubles are normalized to float so an
+/// int-valued temperature serializes as `1.0` like the Rust side.
+fn enc_scalar(ty: &ScalarTy, var: &str) -> String {
+    match ty {
+        ScalarTy::F64 => format!("float({var})"),
+        _ => var.to_string(),
+    }
+}
+
+/// The decode expression for one present key's value `x` (null handling per
+/// the field's presence/default rules; absent keys never reach here).
+fn de_expr(kind: &FieldKind, x: &str) -> String {
+    match kind {
+        FieldKind::Scalar { ty, null_default } => match null_default {
+            // null_resets_default: explicit null is the schema default.
+            Some(d) => format!(
+                "{} if {x} is None else {}",
+                py_lit(d),
+                expect_call(ty, x, None)
+            ),
+            None => expect_call(ty, x, None),
+        },
+        FieldKind::OptScalar {
+            ty, null_default, ..
+        } => match null_default {
+            Some(d) => format!(
+                "{} if {x} is None else {}",
+                py_lit(d),
+                expect_call(ty, x, None)
+            ),
+            None => format!("None if {x} is None else {}", expect_call(ty, x, None)),
+        },
+        FieldKind::Message { rust_path, .. } => {
+            format!("None if {x} is None else decode_{rust_path}({x})")
+        }
+        FieldKind::RepeatedScalar { ty } => format!(
+            "[] if {x} is None else [{} for e in _expect_seq({x}, expected=\"a sequence\")]",
+            expect_call(ty, "e", None)
+        ),
+        FieldKind::RepeatedMessage { rust_path } => format!(
+            "[] if {x} is None else [decode_{rust_path}(e) for e in _expect_seq({x}, expected=\"a sequence\")]"
+        ),
+        FieldKind::RepeatedRawJson => {
+            format!("[] if {x} is None else list(_expect_seq({x}, expected=\"a sequence\"))")
+        }
+        FieldKind::Map { value } => format!(
+            "{{}} if {x} is None else {{k: {} for k, e in _expect_map({x}, expected=\"a map\").items()}}",
+            expect_call(value, "e", None)
+        ),
+        // raw_json: the value passes through verbatim.
+        FieldKind::RawJson { .. } => x.to_string(),
+    }
+}
+
+/// The encode expression for a non-None value `x` of this field.
+fn enc_expr(kind: &FieldKind, x: &str) -> String {
+    match kind {
+        FieldKind::Scalar { ty, .. } | FieldKind::OptScalar { ty, .. } => enc_scalar(ty, x),
+        FieldKind::Message { rust_path, .. } => format!("encode_{rust_path}({x})"),
+        FieldKind::RepeatedScalar { ty } => match ty {
+            ScalarTy::F64 => format!("[float(e) for e in {x}]"),
+            _ => format!("list({x})"),
+        },
+        FieldKind::RepeatedMessage { rust_path } => {
+            format!("[encode_{rust_path}(e) for e in {x}]")
+        }
+        FieldKind::RepeatedRawJson => format!("list({x})"),
+        FieldKind::Map { value } => match value {
+            ScalarTy::F64 => format!("{{k: float(e) for k, e in {x}.items()}}"),
+            _ => format!("dict({x})"),
+        },
+        FieldKind::RawJson { .. } => x.to_string(),
+    }
+}
+
+/// Statements storing one field into the dict `d`, honoring its presence and
+/// null rules. `always_emit_null` = tagged-union payload semantics.
+fn ser_stmts(f: &FieldModel, receiver: &str, always_emit_null: bool, indent: &str) -> String {
+    let key = &f.json_name;
+    let get = format!("{receiver}{}", py_ident(&f.json_name));
+    let enc = enc_expr(&f.kind, &get);
+    let nullable = |emit_null: bool| -> String {
+        if emit_null || always_emit_null {
+            if enc == get {
+                format!("{indent}d[{key:?}] = {get}\n")
+            } else {
+                format!("{indent}d[{key:?}] = None if {get} is None else {enc}\n")
+            }
+        } else {
+            format!("{indent}if {get} is not None:\n{indent}    d[{key:?}] = {enc}\n")
+        }
+    };
+    match &f.kind {
+        FieldKind::Scalar { .. } => format!("{indent}d[{key:?}] = {enc}\n"),
+        // null_is_none: None means "explicit null", distinct from absent
+        // (the default), so it must encode as null to round-trip.
+        FieldKind::OptScalar {
+            emit_null,
+            null_is_none_default,
+            ..
+        } => nullable(*emit_null || null_is_none_default.is_some()),
+        FieldKind::Message { emit_null, .. } | FieldKind::RawJson { emit_null } => {
+            nullable(*emit_null)
+        }
+        FieldKind::RepeatedScalar { .. }
+        | FieldKind::RepeatedMessage { .. }
+        | FieldKind::RepeatedRawJson
+        | FieldKind::Map { .. } => {
+            format!("{indent}if {get}:\n{indent}    d[{key:?}] = {enc}\n")
+        }
+    }
+}
+
+// ---- Structs ---------------------------------------------------------
+
+fn emit_methods(out: &mut String, name: &str, ret: &str) {
+    out.push_str(&format!(
+        r#"    @classmethod
+    def from_json_value(cls, value: Any) -> "{name}":
+        """Decode a parsed JSON value; raises JsonContractError on a contract violation."""
+        return decode_{name}(value)
+
+    def to_json_value(self) -> {ret}:
+        """Encode to a JSON-ready value (json.dumps-compatible)."""
+        return encode_{name}(self)
+
+
+"#
+    ));
+}
+
+fn emit_struct_class(
+    out: &mut String,
+    ctx: &Ctx,
+    m: &MessageModel,
+    deny_unknown: bool,
+    fields: &[FieldModel],
+) {
+    let name = &m.rust_name;
+    let policy = if deny_unknown { "rejected" } else { "ignored" };
+    out.push_str(&format!(
+        "class {name}(msgspec.Struct, kw_only=True, frozen=True):\n    \"\"\"{}: JSON object (unknown keys {policy}).\"\"\"\n\n",
+        ctx.full_name(name)
+    ));
+    for f in fields {
+        out.push_str(&format!(
+            "    {}: {} = {}\n",
+            py_ident(&f.json_name),
+            field_ty(&f.kind),
+            field_default(&f.kind)
+        ));
+    }
+    if !fields.is_empty() {
+        out.push('\n');
+    }
+    emit_methods(out, name, "Dict[str, Any]");
+}
+
+fn emit_tuple_class(out: &mut String, ctx: &Ctx, m: &MessageModel, fields: &[FieldModel]) {
+    let name = &m.rust_name;
+    let members: Vec<&str> = fields.iter().map(|f| f.json_name.as_str()).collect();
+    out.push_str(&format!(
+        "class {name}(msgspec.Struct, kw_only=True, frozen=True):\n    \"\"\"{}: JSON positional array [{}].\"\"\"\n\n",
+        ctx.full_name(name),
+        members.join(", ")
+    ));
+    for f in fields {
+        out.push_str(&format!(
+            "    {}: {} = {}\n",
+            py_ident(&f.json_name),
+            field_ty(&f.kind),
+            field_default(&f.kind)
+        ));
+    }
+    if !fields.is_empty() {
+        out.push('\n');
+    }
+    emit_methods(out, name, "List[Any]");
+}
+
+// ---- aliases -----------------------------------------------------------
+
+/// The alias definition (Python type expression, JSON note, referenced
+/// message names) for a non-Struct message.
+fn alias_def(m: &MessageModel) -> Option<(String, &'static str, Vec<String>)> {
+    let refs = |kinds: &[&FieldKind]| -> Vec<String> {
+        kinds
+            .iter()
+            .filter_map(|k| match k {
+                FieldKind::Message { rust_path, .. } | FieldKind::RepeatedMessage { rust_path } => {
+                    Some(rust_path.clone())
+                }
+                _ => None,
+            })
+            .collect()
+    };
+    match &m.kind {
+        MessageKind::BareList { item } => Some((
+            format!("List[{}]", inner_ty(&item.kind)),
+            "JSON bare array",
+            refs(&[&item.kind]),
+        )),
+        MessageKind::Transparent { field } => Some((
+            format!("Optional[{}]", inner_ty(&field.kind)),
+            "JSON: the wrapped value itself, null when unset",
+            refs(&[&field.kind]),
+        )),
+        MessageKind::OneOrMany { one, many, .. } => Some((
+            format!("Union[{}, {}]", inner_ty(&one.kind), inner_ty(&many.kind)),
+            "JSON: one value or an array of values",
+            refs(&[&one.kind, &many.kind]),
+        )),
+        MessageKind::Untagged { variants, .. } => {
+            let arms: Vec<String> = variants.iter().map(|v| inner_ty(&v.kind)).collect();
+            let kinds: Vec<&FieldKind> = variants.iter().map(|v| &v.kind).collect();
+            Some((
+                format!("Union[{}]", arms.join(", ")),
+                "JSON: the value's shape picks the arm",
+                refs(&kinds),
+            ))
+        }
+        MessageKind::TaggedUnion {
+            variants,
+            passthrough,
+            ..
+        } => {
+            let mut arms: Vec<String> = variants.iter().map(|v| inner_ty(&v.kind)).collect();
+            let note = if passthrough.is_some() {
+                arms.push("Dict[str, Any]".to_string());
+                "JSON object tagged by its type key; unknown tags pass through as a dict"
+            } else {
+                "JSON object tagged by its type key"
+            };
+            let kinds: Vec<&FieldKind> = variants.iter().map(|v| &v.kind).collect();
+            Some((format!("Union[{}]", arms.join(", ")), note, refs(&kinds)))
+        }
+        MessageKind::Struct { .. } | MessageKind::Tuple { .. } | MessageKind::Skip => None,
+    }
+}
+
+/// Aliases are evaluated at import time, so each is emitted after the aliases
+/// it references (Struct classes are already defined above them).
+fn emit_aliases(out: &mut String, ctx: &Ctx, models: &[MessageModel]) {
+    let mut pending: Vec<&MessageModel> =
+        models.iter().filter(|m| alias_def(m).is_some()).collect();
+    let mut done: HashSet<String> = HashSet::new();
+    while !pending.is_empty() {
+        let before = pending.len();
+        let mut i = 0;
+        while i < pending.len() {
+            let m = pending[i];
+            let (ty, note, refs) = alias_def(m).expect("alias");
+            let ready = refs
+                .iter()
+                .all(|r| ctx.shape(r) == Shape::Class || done.contains(r));
+            if ready {
+                out.push_str(&format!(
+                    "# {}: {note}.\n{} = {ty}\n\n",
+                    ctx.full_name(&m.rust_name),
+                    m.rust_name
+                ));
+                done.insert(m.rust_name.clone());
+                pending.remove(i);
+            } else {
+                i += 1;
+            }
+        }
+        assert!(
+            pending.len() < before,
+            "type alias cycle among {:?}",
+            pending.iter().map(|m| &m.rust_name).collect::<Vec<_>>()
+        );
+    }
+}
+
+// ---- codecs ------------------------------------------------------------
+
+fn emit_struct_codec(
+    out: &mut String,
+    m: &MessageModel,
+    deny_unknown: bool,
+    fields: &[FieldModel],
+) {
+    let name = &m.rust_name;
+    if deny_unknown {
+        let names: Vec<String> = fields
+            .iter()
+            .map(|f| format!("{:?},", f.json_name))
+            .collect();
+        out.push_str(&format!("_FIELDS_{name} = ({})\n\n\n", names.join(" ")));
+    }
+
+    out.push_str(&format!(
+        "def decode_{name}(value: Any) -> {name}:\n    m = _expect_map(value, expected=\"struct {name}\")\n"
+    ));
+    if fields.is_empty() {
+        if deny_unknown {
+            out.push_str("    for key in m:\n        raise _unknown_field(key, fields=())\n");
+        }
+        out.push_str(&format!("    return {name}()\n\n\n"));
+    } else {
+        out.push_str("    kw: Dict[str, Any] = {}\n    for key, x in m.items():\n");
+        for (i, f) in fields.iter().enumerate() {
+            let kw = if i == 0 { "if" } else { "elif" };
+            out.push_str(&format!(
+                "        {kw} key == {:?}:\n            kw[{:?}] = {}\n",
+                f.json_name,
+                py_ident(&f.json_name),
+                de_expr(&f.kind, "x")
+            ));
+        }
+        if deny_unknown {
+            out.push_str(&format!(
+                "        else:\n            raise _unknown_field(key, fields=_FIELDS_{name})\n"
+            ));
+        }
+        out.push_str(&format!("    return {name}(**kw)\n\n\n"));
+    }
+
+    out.push_str(&format!(
+        "def encode_{name}(v: {name}) -> Dict[str, Any]:\n    d: Dict[str, Any] = {{}}\n"
+    ));
+    for f in fields {
+        out.push_str(&ser_stmts(f, "v.", false, "    "));
+    }
+    out.push_str("    return d\n\n\n");
+}
+
+fn emit_tuple_codec(out: &mut String, m: &MessageModel, fields: &[FieldModel]) {
+    let name = &m.rust_name;
+    let len = fields.len();
+    let expected = format!("a {len}-element tuple");
+    out.push_str(&format!(
+        "def decode_{name}(value: Any) -> {name}:\n    s = _expect_seq(value, expected={expected:?})\n    if len(s) != {len}:\n        raise JsonContractError(f\"invalid length {{len(s)}}, expected {expected}\")\n    return {name}(\n"
+    ));
+    for (i, f) in fields.iter().enumerate() {
+        let x = format!("s[{i}]");
+        let expr = match &f.kind {
+            FieldKind::Scalar { .. } | FieldKind::OptScalar { .. } => de_expr(&f.kind, &x),
+            other => panic!("{name}: tuple member kind {other:?} unsupported"),
+        };
+        out.push_str(&format!("        {}={expr},\n", py_ident(&f.json_name)));
+    }
+    out.push_str("    )\n\n\n");
+
+    out.push_str(&format!(
+        "def encode_{name}(v: {name}) -> List[Any]:\n    return [\n"
+    ));
+    for f in fields {
+        let get = format!("v.{}", py_ident(&f.json_name));
+        let expr = match &f.kind {
+            FieldKind::Scalar { .. } => enc_expr(&f.kind, &get),
+            FieldKind::OptScalar { .. } => {
+                let enc = enc_expr(&f.kind, &get);
+                if enc == get {
+                    get
+                } else {
+                    format!("None if {get} is None else {enc}")
+                }
+            }
+            other => panic!("{name}: tuple member kind {other:?} unsupported"),
+        };
+        out.push_str(&format!("        {expr},\n"));
+    }
+    out.push_str("    ]\n\n\n");
+}
+
+fn emit_bare_list_codec(out: &mut String, m: &MessageModel, item: &FieldModel) {
+    let name = &m.rust_name;
+    let elem = match &item.kind {
+        FieldKind::RepeatedScalar { ty } => expect_call(ty, "e", None),
+        FieldKind::RepeatedMessage { rust_path } => format!("decode_{rust_path}(e)"),
+        other => panic!("{name}: bare_list item must be repeated, got {other:?}"),
+    };
+    out.push_str(&format!(
+        "def decode_{name}(value: Any) -> {name}:\n    return [{elem} for e in _expect_seq(value, expected=\"a sequence\")]\n\n\n"
+    ));
+    out.push_str(&format!(
+        "def encode_{name}(v: {name}) -> List[Any]:\n    return {}\n\n\n",
+        enc_expr(&item.kind, "v")
+    ));
+}
+
+fn emit_transparent_codec(out: &mut String, m: &MessageModel, field: &FieldModel) {
+    let name = &m.rust_name;
+    let (de, en) = match &field.kind {
+        FieldKind::OptScalar { ty, .. } => (expect_call(ty, "value", None), enc_scalar(ty, "v")),
+        FieldKind::Message { rust_path, .. } => (
+            format!("decode_{rust_path}(value)"),
+            format!("encode_{rust_path}(v)"),
+        ),
+        other => panic!(
+            "{name}: transparent field must be an optional scalar or a message, got {other:?}"
+        ),
+    };
+    out.push_str(&format!(
+        "def decode_{name}(value: Any) -> {name}:\n    return None if value is None else {de}\n\n\n"
+    ));
+    out.push_str(&format!(
+        "def encode_{name}(v: {name}) -> Any:\n    return None if v is None else {en}\n\n\n"
+    ));
+}
+
+/// How the `one` arm of a one-or-many carrier is recognized and decoded.
+enum OneArm {
+    Scalar(ScalarTy),
+    /// The `one` is itself a bare list of scalars (TokenIds, StringList): the
+    /// outer array is ambiguous, so dispatch on the first element's shape.
+    ListOfScalar(String, ScalarTy),
+    Class(String),
+}
+
+/// The Python test recognizing one element of a bare scalar list.
+fn first_elem_check(ty: &ScalarTy) -> &'static str {
+    match ty {
+        ScalarTy::Str => "isinstance(value[0], str)",
+        ScalarTy::Bool => "isinstance(value[0], bool)",
+        _ => "_is_number(value[0])",
+    }
+}
+
+fn one_arm(ctx: &Ctx, name: &str, one: &VariantModel) -> OneArm {
+    match &one.kind {
+        FieldKind::Scalar { ty, .. } | FieldKind::OptScalar { ty, .. } => {
+            OneArm::Scalar(ty.clone())
+        }
+        FieldKind::Message { rust_path, .. } => match &ctx.model(rust_path).kind {
+            // A presence wrapper's JSON is its bare scalar.
+            MessageKind::Transparent {
+                field:
+                    FieldModel {
+                        kind: FieldKind::OptScalar { ty, .. },
+                        ..
+                    },
+            } => OneArm::Scalar(ty.clone()),
+            MessageKind::BareList {
+                item:
+                    FieldModel {
+                        kind: FieldKind::RepeatedScalar { ty },
+                        ..
+                    },
+            } => OneArm::ListOfScalar(rust_path.clone(), ty.clone()),
+            MessageKind::Struct { .. } => OneArm::Class(rust_path.clone()),
+            other => panic!("{name}: unsupported one arm {rust_path} ({other:?})"),
+        },
+        other => panic!("{name}: unsupported one arm {other:?}"),
+    }
+}
+
+fn emit_one_or_many_codec(
+    out: &mut String,
+    ctx: &Ctx,
+    m: &MessageModel,
+    one: &VariantModel,
+    many: &VariantModel,
+) {
+    let name = &m.rust_name;
+    let many_p = match &many.kind {
+        FieldKind::Message { rust_path, .. } => rust_path.clone(),
+        other => panic!("{name}: many arm must be a list message, got {other:?}"),
+    };
+    let expected = format!("a value or an array of values for {name}");
+    let (de_body, en_body) = match one_arm(ctx, name, one) {
+        OneArm::ListOfScalar(one_p, ty) => (
+            format!(
+                "    if isinstance(value, list):\n        # [] and [scalar, ...] are one flat list; anything else is a batch.\n        if not value or {check}:\n            return decode_{one_p}(value)\n        return decode_{many_p}(value)\n    raise _invalid_type(value, expected={expected:?})\n",
+                check = first_elem_check(&ty)
+            ),
+            format!(
+                "    if v and isinstance(v[0], list):\n        return encode_{many_p}(v)\n    return encode_{one_p}(v)\n"
+            ),
+        ),
+        OneArm::Scalar(ty) => (
+            format!(
+                "    if isinstance(value, list):\n        return decode_{many_p}(value)\n    return {}\n",
+                expect_call(&ty, "value", Some(&expected))
+            ),
+            format!(
+                "    if isinstance(v, list):\n        return encode_{many_p}(v)\n    return {}\n",
+                enc_scalar(&ty, "v")
+            ),
+        ),
+        OneArm::Class(one_p) => (
+            format!(
+                "    if isinstance(value, list):\n        return decode_{many_p}(value)\n    return decode_{one_p}(_expect_map(value, expected={expected:?}))\n"
+            ),
+            format!(
+                "    if isinstance(v, list):\n        return encode_{many_p}(v)\n    return encode_{one_p}(v)\n"
+            ),
+        ),
+    };
+    out.push_str(&format!(
+        "def decode_{name}(value: Any) -> {name}:\n{de_body}\n\ndef encode_{name}(v: {name}) -> Any:\n{en_body}\n\n"
+    ));
+}
+
+/// The Python runtime shapes a field or message's JSON can take.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum PyShape {
+    Str,
+    Int,
+    Float,
+    Bool,
+    Dict,
+    List,
+    NoneT,
+}
+
+fn py_scalar_shapes(ty: &ScalarTy) -> Vec<PyShape> {
+    match ty {
+        ScalarTy::Str => vec![PyShape::Str],
+        ScalarTy::I32 | ScalarTy::I64 | ScalarTy::U32 | ScalarTy::U64 => vec![PyShape::Int],
+        ScalarTy::F64 => vec![PyShape::Int, PyShape::Float],
+        ScalarTy::Bool => vec![PyShape::Bool],
+    }
+}
+
+/// `(JSON shapes, runtime class names)` of a kind: the shapes drive the decode
+/// dispatch, the classes the encode dispatch (a decoded dict is a Struct).
+fn py_shapes(ctx: &Ctx, kind: &FieldKind) -> (Vec<PyShape>, Vec<String>) {
+    match kind {
+        FieldKind::Scalar { ty, .. } | FieldKind::OptScalar { ty, .. } => {
+            (py_scalar_shapes(ty), vec![])
+        }
+        FieldKind::Message { rust_path, .. } => py_message_shapes(ctx, rust_path),
+        FieldKind::RepeatedScalar { .. }
+        | FieldKind::RepeatedMessage { .. }
+        | FieldKind::RepeatedRawJson => (vec![PyShape::List], vec![]),
+        FieldKind::Map { .. } => (vec![PyShape::Dict], vec![]),
+        FieldKind::RawJson { .. } => panic!("raw_json has no fixed shape"),
+    }
+}
+
+fn py_message_shapes(ctx: &Ctx, name: &str) -> (Vec<PyShape>, Vec<String>) {
+    let mut shapes: Vec<PyShape> = Vec::new();
+    let mut classes: Vec<String> = Vec::new();
+    let mut add = |(s, c): (Vec<PyShape>, Vec<String>)| {
+        for x in s {
+            if !shapes.contains(&x) {
+                shapes.push(x);
+            }
+        }
+        for x in c {
+            if !classes.contains(&x) {
+                classes.push(x);
+            }
+        }
+    };
+    match &ctx.model(name).kind {
+        MessageKind::Struct { .. } | MessageKind::TaggedUnion { .. } => {
+            add((vec![PyShape::Dict], vec![name.to_string()]))
+        }
+        MessageKind::Tuple { .. } | MessageKind::BareList { .. } => {
+            add((vec![PyShape::List], vec![]))
+        }
+        MessageKind::Transparent { field } => {
+            add(py_shapes(ctx, &field.kind));
+            add((vec![PyShape::NoneT], vec![]));
+        }
+        MessageKind::Untagged { variants, .. } => {
+            for v in variants {
+                add(py_shapes(ctx, &v.kind));
+            }
+        }
+        MessageKind::OneOrMany { one, .. } => {
+            add(py_shapes(ctx, &one.kind));
+            add((vec![PyShape::List], vec![]));
+        }
+        MessageKind::Skip => panic!("{name}: a gRPC-only message has no JSON shape"),
+    }
+    (shapes, classes)
+}
+
+/// Whether a bare-list message's elements are themselves arrays.
+fn py_elements_are_lists(ctx: &Ctx, name: &str) -> bool {
+    match &ctx.model(name).kind {
+        MessageKind::BareList { item } => match &item.kind {
+            FieldKind::RepeatedMessage { rust_path } => {
+                py_message_shapes(ctx, rust_path).0.contains(&PyShape::List)
+            }
+            _ => false,
+        },
+        _ => false,
+    }
+}
+
+fn emit_untagged_codec(out: &mut String, ctx: &Ctx, m: &MessageModel, variants: &[VariantModel]) {
+    let name = &m.rust_name;
+    let mut de = format!("def decode_{name}(value: Any) -> {name}:\n");
+    let mut en = format!("def encode_{name}(v: {name}) -> Any:\n");
+
+    struct Arm<'a> {
+        v: &'a VariantModel,
+        shapes: Vec<PyShape>,
+        classes: Vec<String>,
+    }
+    let arms: Vec<Arm> = variants
+        .iter()
+        .map(|v| {
+            let (shapes, classes) = py_shapes(ctx, &v.kind);
+            Arm { v, shapes, classes }
+        })
+        .collect();
+    let decode_expr = |a: &Arm| match &a.v.kind {
+        FieldKind::Scalar { .. } | FieldKind::OptScalar { .. } => "value".to_string(),
+        FieldKind::Message { rust_path, .. } => format!("decode_{rust_path}(value)"),
+        other => panic!("{name}: untagged variant kind {other:?} unsupported"),
+    };
+    let encode_expr = |a: &Arm| match &a.v.kind {
+        FieldKind::Scalar { .. } | FieldKind::OptScalar { .. } => "v".to_string(),
+        FieldKind::Message { rust_path, .. } => format!("encode_{rust_path}(v)"),
+        _ => unreachable!(),
+    };
+    // Two list-shaped arms: the one whose elements are lists is the nested
+    // form, told apart by the first element (`[]` is the flat form).
+    let list_arms: Vec<&Arm> = arms
+        .iter()
+        .filter(|a| a.shapes.contains(&PyShape::List))
+        .collect();
+    let nested_arm: Option<String> = match list_arms.len() {
+        0 | 1 => None,
+        2 => {
+            let is_nested = |a: &Arm| match &a.v.kind {
+                FieldKind::Message { rust_path, .. } => py_elements_are_lists(ctx, rust_path),
+                _ => false,
+            };
+            match (is_nested(list_arms[0]), is_nested(list_arms[1])) {
+                (true, false) => Some(list_arms[0].v.json_name.clone()),
+                (false, true) => Some(list_arms[1].v.json_name.clone()),
+                _ => panic!("{name}: two list-shaped arms cannot be told apart"),
+            }
+        }
+        _ => panic!("{name}: more than two list-shaped untagged arms"),
+    };
+
+    // Decode: one test per shape, bool before int (a Python bool is an int).
+    for shape in [
+        PyShape::NoneT,
+        PyShape::Bool,
+        PyShape::Str,
+        PyShape::Int,
+        PyShape::Float,
+        PyShape::Dict,
+        PyShape::List,
+    ] {
+        let claimants: Vec<&Arm> = arms.iter().filter(|a| a.shapes.contains(&shape)).collect();
+        if claimants.is_empty() {
+            continue;
+        }
+        if shape != PyShape::List && claimants.len() > 1 {
+            panic!(
+                "{name}: untagged arms {:?} all accept a JSON {shape:?}",
+                claimants.iter().map(|a| &a.v.json_name).collect::<Vec<_>>()
+            );
+        }
+        if shape == PyShape::List && claimants.len() == 2 {
+            let nested = nested_arm.as_deref().expect("nested arm");
+            let (n, f) = if claimants[0].v.json_name == nested {
+                (claimants[0], claimants[1])
+            } else {
+                (claimants[1], claimants[0])
+            };
+            de.push_str(&format!(
+                "    if isinstance(value, list):\n        if value and isinstance(value[0], list):\n            return {}\n        return {}\n",
+                decode_expr(n),
+                decode_expr(f)
+            ));
+            continue;
+        }
+        let check = match shape {
+            PyShape::NoneT => "value is None",
+            PyShape::Bool => "isinstance(value, bool)",
+            PyShape::Str => "isinstance(value, str)",
+            PyShape::Int => "_is_int(value)",
+            PyShape::Float => "_is_number(value)",
+            PyShape::Dict => "isinstance(value, dict)",
+            PyShape::List => "isinstance(value, list)",
+        };
+        de.push_str(&format!(
+            "    if {check}:\n        return {}\n",
+            decode_expr(claimants[0])
+        ));
+    }
+    de.push_str(&format!(
+        "    raise _invalid_type(value, expected=\"one of the {name} shapes\")\n\n\n"
+    ));
+
+    // Encode: the runtime value's type picks the arm (a decoded object is its
+    // Struct class); list arms by first element.
+    for a in &arms {
+        let mut types: Vec<String> = Vec::new();
+        for s in &a.shapes {
+            let t = match s {
+                PyShape::Str => "str",
+                PyShape::Bool => "bool",
+                PyShape::Int => "int",
+                PyShape::Float => "float",
+                PyShape::List => "list",
+                PyShape::Dict | PyShape::NoneT => continue,
+            };
+            if !types.iter().any(|x| x == t) {
+                types.push(t.to_string());
+            }
+        }
+        types.extend(a.classes.iter().cloned());
+        let mut check = if types.is_empty() {
+            "False".to_string()
+        } else {
+            format!("isinstance(v, ({},))", types.join(", "))
+        };
+        if a.shapes.contains(&PyShape::NoneT) {
+            check = format!("v is None or {check}");
+        }
+        if a.shapes.contains(&PyShape::List) && list_arms.len() == 2 {
+            let elem = if nested_arm.as_deref() == Some(a.v.json_name.as_str()) {
+                "(v and isinstance(v[0], list))"
+            } else {
+                "not (v and isinstance(v[0], list))"
+            };
+            check = format!("isinstance(v, list) and {elem}");
+        }
+        en.push_str(&format!(
+            "    if {check}:\n        return {}\n",
+            encode_expr(a)
+        ));
+    }
+    en.push_str("    return v\n\n\n");
+    out.push_str(&de);
+    out.push_str(&en);
+}
+
+fn emit_tagged_codec(
+    out: &mut String,
+    m: &MessageModel,
+    tag: &str,
+    variants: &[VariantModel],
+    passthrough: Option<&VariantModel>,
+) {
+    let name = &m.rust_name;
+    // Decode: a known tag builds its payload from the declared keys; a payload
+    // that fails to parse, or an unknown tag, falls back to the passthrough
+    // (or errors when the schema declares none).
+    let fallback = if passthrough.is_some() {
+        "return dict(raw)".to_string()
+    } else {
+        format!("raise JsonContractError(\"unknown {tag} for {name}\")")
+    };
+    let mut de = format!(
+        "def decode_{name}(value: Any) -> {name}:\n    raw = _expect_map(value, expected=\"map\")\n    tag = raw.get({tag:?})\n"
+    );
+    for (i, v) in variants.iter().enumerate() {
+        let payload = match &v.kind {
+            FieldKind::Message { rust_path, .. } => rust_path.clone(),
+            other => panic!("{name}: tagged variant must be message-typed, got {other:?}"),
+        };
+        let kw = if i == 0 { "if" } else { "elif" };
+        de.push_str(&format!(
+            "    {kw} tag == {:?}:\n        try:\n            return {payload}(\n",
+            v.json_name
+        ));
+        for f in &v.payload_fields {
+            let key = &f.json_name;
+            let read = match &f.kind {
+                FieldKind::OptScalar { ty, .. } => expect_call(ty, &format!("raw[{key:?}]"), None),
+                FieldKind::Message { rust_path, .. } => {
+                    format!("decode_{rust_path}(raw[{key:?}])")
+                }
+                other => panic!("{name}: tagged payload field kind {other:?} unsupported"),
+            };
+            de.push_str(&format!(
+                "                {}=None if raw.get({key:?}) is None else {read},\n",
+                py_ident(key)
+            ));
+        }
+        let on_error = if passthrough.is_some() {
+            "return dict(raw)"
+        } else {
+            "raise"
+        };
+        de.push_str(&format!(
+            "            )\n        except JsonContractError:\n            {on_error}\n"
+        ));
+    }
+    de.push_str(&format!("    {fallback}\n\n\n"));
+
+    // Encode: {tag: variant name, ...payload fields with explicit nulls}.
+    let mut en = format!("def encode_{name}(v: {name}) -> Any:\n");
+    for v in variants {
+        let payload = match &v.kind {
+            FieldKind::Message { rust_path, .. } => rust_path.clone(),
+            other => panic!("{name}: tagged variant must be message-typed, got {other:?}"),
+        };
+        en.push_str(&format!(
+            "    if isinstance(v, {payload}):\n        d: Dict[str, Any] = {{{tag:?}: {:?}}}\n",
+            v.json_name
+        ));
+        for f in &v.payload_fields {
+            en.push_str(&ser_stmts(f, "v.", true, "        "));
+        }
+        en.push_str("        return d\n");
+    }
+    if passthrough.is_some() {
+        en.push_str("    if isinstance(v, dict):\n        return dict(v)\n");
+    }
+    en.push_str(&format!(
+        "    raise TypeError(f\"{name}: unsupported value {{type(v).__name__}}\")\n\n\n"
+    ));
+    out.push_str(&de);
+    out.push_str(&en);
+}
