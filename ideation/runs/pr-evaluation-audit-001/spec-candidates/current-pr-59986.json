    "subscriptions_url": "https://api.github.com/users/he-yufeng/subscriptions",
    "organizations_url": "https://api.github.com/users/he-yufeng/orgs",
    "repos_url": "https://api.github.com/users/he-yufeng/repos",
    "events_url": "https://api.github.com/users/he-yufeng/events{/privacy}",
    "received_events_url": "https://api.github.com/users/he-yufeng/received_events",
