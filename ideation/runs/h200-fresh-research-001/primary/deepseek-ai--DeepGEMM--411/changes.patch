+                BlockPhaseTag::value == sched::BlockPhase::Linear1 or
+                BlockPhaseTag::value == sched::BlockPhase::SharedLinear1;
+            constexpr bool is_shared_phase =
+                BlockPhaseTag::value == sched::BlockPhase::SharedLinear1 or
