+        "_class_name": "Kandinsky6SRLatentUpscalerBank",
+        "models": models,
+        "scaling_factor": 0.5,
+    }
+    if include_scales:
+        config["scales"] = list(scales)
+    _write_component(
+        directory,
+        config,
+        {k: v.contiguous() for k, v in bank.state_dict().items()},
+    )
+    return directory
+
