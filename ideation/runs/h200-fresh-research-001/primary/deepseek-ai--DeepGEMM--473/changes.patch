+                        const uint32_t tag = scheduler.load_tile_entry(tile_table + ec_table_pos);
+                        if (tag == 0u) {   // end marker: every tile is accounted
+                            ec_table_done = true;
+                            break;
+                        }
+                        ++ ec_table_pos;
+                        if (tag != 2u)
+                            continue;
+                        ++ ec_tiles_published;
