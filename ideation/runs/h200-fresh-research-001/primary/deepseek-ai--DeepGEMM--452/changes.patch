From ee53a16b089d441cbfc4020cd558c1f05f623d97 Mon Sep 17 00:00:00 2001
From: "yibin.ma" <chthollyboss@qq.com>
Date: Fri, 18 Sep 2026 16:55:30 +0800
Subject: [PATCH] Use full-rate FADD relu in SM90 FP8 MQA logits epilogue

FMNMX (fmaxf(x, 0)) issues at 64 ops/clk/SM on SM90, half the rate of
FADD/FFMA (128 ops/clk/SM), while the abs operand modifier is a free
encoding bit on FADD. Since x + |x| == 2 * relu(x) exactly for finite
floats, the compensating 0.5f is folded into the existing scale_kv
multiply: zero extra instructions, bit-exact numerics.

NaN semantics differ (x + |x| propagates NaN; fmaxf(NaN, 0) returns 0),
matching the existing SM100 kernel (sm100_mqa_logits.cuh).

Measured on H200: +7.4% on the production indexer shape
(H=32, D=128, SQ=512, SKV=140k), avg +3.7% over the 192-case
test_attention.py sweep.
---
 deep_gemm/include/deep_gemm/impls/sm90_fp8_mqa_logits.cuh | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/deep_gemm/include/deep_gemm/impls/sm90_fp8_mqa_logits.cuh b/deep_gemm/include/deep_gemm/impls/sm90_fp8_mqa_logits.cuh
index 0c12cc69b..134ee0a6b 100644
--- a/deep_gemm/include/deep_gemm/impls/sm90_fp8_mqa_logits.cuh
+++ b/deep_gemm/include/deep_gemm/impls/sm90_fp8_mqa_logits.cuh
@@ -283,7 +283,7 @@ void sm90_fp8_mqa_logits(const uint32_t seq_len, const uint32_t seq_len_kv,
                 for (uint32_t i = 0; i < BLOCK_Q; ++ i) {
                     auto shifted_accum = accum + i * kNumAccumPerReduce;
                     const auto transform = [&](const uint32_t& j) {
-                        return fmaxf(shifted_accum[j], 0) * weights[i][(j / 4) * 2 + (j & 1)];
+                        return (shifted_accum[j] + fabsf(shifted_accum[j])) * weights[i][(j / 4) * 2 + (j & 1)];
                     };
 
                     // Intra-thread reduction
@@ -294,8 +294,8 @@ void sm90_fp8_mqa_logits(const uint32_t seq_len, const uint32_t seq_len_kv,
                         for (uint32_t k = 0; k < 4; k ++)
                             sum[k] += transform(j * 4 + k);
                     }
-                    float v_0 = (sum[0] + sum[1]) * scale_kv_0;
-                    float v_1 = (sum[2] + sum[3]) * scale_kv_1;
+                    float v_0 = (sum[0] + sum[1]) * (scale_kv_0 * 0.5f);
+                    float v_1 = (sum[2] + sum[3]) * (scale_kv_1 * 0.5f);
 
                     // Inter-thread reduction
                     #pragma unroll
