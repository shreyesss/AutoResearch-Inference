+if _use_aiter and _is_gfx95_supported:
+    from sglang.kernels.ops.gemm.gfx95_batched_gemm_bf16_fp8_grid import (
+        batched_gemm_bf16_fp8_grid as _wo_a_fp8_grid_gemm,
