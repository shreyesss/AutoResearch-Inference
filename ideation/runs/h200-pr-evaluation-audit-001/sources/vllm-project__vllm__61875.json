      "blob_url": "https://github.com/vllm-project/vllm/blob/a3bcf3ae00b75a2954a7a2331f05e8b13bbe3b6c/vllm%2Fmodel_executor%2Flayers%2Fquantization%2Fmxfp4.py",
      "raw_url": "https://github.com/vllm-project/vllm/raw/a3bcf3ae00b75a2954a7a2331f05e8b13bbe3b6c/vllm%2Fmodel_executor%2Flayers%2Fquantization%2Fmxfp4.py",
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Flayers%2Fquantization%2Fmxfp4.py?ref=a3bcf3ae00b75a2954a7a2331f05e8b13bbe3b6c",
      "patch": "@@ -17,6 +17,7 @@\n )\n from vllm.model_executor.layers.fused_moe import modular_kernel as mk\n from vllm.model_executor.layers.fused_moe.config import (\n+    RoutingMethodType,\n     mxfp4_w4a16_moe_quant_config,\n )\n from vllm.model_executor.layers.fused_moe.moe_output import UnfinalizedMoEOutput\n@@ -41,6 +42,7 @@\n from vllm.model_executor.layers.quantization.utils.quant_utils import (\n     QuantKey,\n     is_layer_skipped,\n+    kFp8Dynamic128Sym,\n )\n from vllm.model_executor.utils import (\n     is_weights_pre_processed,\n@@ -576,6 +578,16 @@ def __init__(self, moe: FusedMoEConfig, activation_key: QuantKey | None = None):\n             self.mxfp4_backend, self.experts_cls = select_deepseek_v4_mxfp4_moe_backend(\n                 moe\n             )\n+        if (\n+            self.activation_key is None\n+            and self.mxfp4_backend == Mxfp4MoeBackend.HUMMING\n+            and moe.routing_method == RoutingMethodType.DeepseekV4\n+            and moe.moe_parallel_config.use_ep\n+            and current_platform.is_device_capability_family(90)\n+        ):\n+            # Full-size DeepSeek V4 experts under EP run faster on Hopper with\n+            # block FP8 activations than with Humming's default BF16.\n+            self.activation_key = kFp8Dynamic128Sym\n \n         self.max_capture_size = moe.max_capture_size\n "
    }
