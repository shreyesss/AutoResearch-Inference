      "organizations_url": "https://api.github.com/users/qescccczmr/orgs",
      "repos_url": "https://api.github.com/users/qescccczmr/repos",
      "events_url": "https://api.github.com/users/qescccczmr/events{/privacy}",
      "received_events_url": "https://api.github.com/users/qescccczmr/received_events",
