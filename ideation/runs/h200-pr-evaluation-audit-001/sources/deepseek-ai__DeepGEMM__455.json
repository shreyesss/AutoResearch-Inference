    "title": "[Fix] SM90 heuristic offers block M 16/32 to the FP8 1D1D kernel (JIT failure for M <= 32)",
    "user": {
      "login": "LiRunGuo",
      "id": 121242164,
      "node_id": "U_kgDOBzoCNA",
      "avatar_url": "https://avatars.githubusercontent.com/u/121242164?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/LiRunGuo",
      "html_url": "https://github.com/LiRunGuo",
