+                                float2 sf_pair, sf_inv_pair;
+                                sm90_fp8_mega_moe_get_e4m3_sf_and_sf_inv(
+                                    amax_pair, sf_pair, sf_inv_pair);
+                                swap_scale_scratch[token] = sf_pair.x;
+                                swap_scale_scratch[BLOCK_M + token] =
+                                    sf_inv_pair.x;
+                            }
+                        }
+                    }
+                    ptx::sync_aligned(
+                        kNumEpilogueThreads,
+                        kEpilogueWGBarrierStartIdx);
+
