+@pytest.mark.skipif(not current_platform.is_cuda(), reason="CUDA graph coverage")
+@pytest.mark.parametrize("compress_ratio", [1, 2])
+@pytest.mark.parametrize("use_graph", [False, True])
+@pytest.mark.parametrize(
