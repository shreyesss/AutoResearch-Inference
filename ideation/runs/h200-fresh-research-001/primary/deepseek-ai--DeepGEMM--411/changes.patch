+                        elem_idx * sizeof(nv_bfloat16));
+                    *reinterpret_cast<uint32_t*>(
+                        static_cast<uint8_t*>(smem_cd_base) +
+                            storage_byte_idx) =
+                            math::cast_into_bf16_and_pack(value0, value1);
