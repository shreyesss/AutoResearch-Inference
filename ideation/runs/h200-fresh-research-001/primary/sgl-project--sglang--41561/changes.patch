+    def test_swa_composite_forwards_the_mark(self):
+        b = init_unified_swa_pools(
+            device=_DEV,
+            kv_cache_dtype=_DTYPE,
+            head_num=_H,
+            head_dim=_D,
+            v_head_dim=_D,
+            swa_head_num=_H,
+            swa_head_dim=_D,
+            swa_v_head_dim=_D,
+            page_size=1,
+            start_layer=0,
+            end_layer=4,
+            swa_attention_layer_ids=[1, 3],
+            full_attention_layer_ids=[0, 2],
