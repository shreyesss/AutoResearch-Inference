+        residual = ops.attn_readout.init_residual(self.hidden)
+        ops.attn_readout.read(residual, None)
+        attn_out = torch.full((2, HIDDEN), 5.0)
+        _, residual = ops.ffn_readout.update_and_read(
+            ops.attn_update, attn_out, residual, None
+        )
