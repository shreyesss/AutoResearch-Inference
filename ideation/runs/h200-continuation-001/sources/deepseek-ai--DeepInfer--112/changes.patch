diff --git a/examples/sweep/plot_pareto.py b/examples/sweep/plot_pareto.py
index 633e75d..1d414be 100644
--- a/examples/sweep/plot_pareto.py
+++ b/examples/sweep/plot_pareto.py
@@ -37,7 +37,7 @@
 def load_points(path: Path, mode: str) -> list[dict]:
     """按扫描参数排序；同一扫描点重复出现（重跑）时取最后一条。"""
     key = SWEEP_KEY[mode]
-    latest: dict[int, dict] = {}
+    points: list[dict] = []
     for line in path.read_text(encoding="utf-8").splitlines():
         if not line.strip():
             continue
@@ -45,14 +45,15 @@ def load_points(path: Path, mode: str) -> list[dict]:
         if f"{mode}_tokens_per_s_per_gpu" not in record:
             print(f"跳过 {key}={record.get(key)}：没有 {mode} 指标（稳态窗口全被 LB flush 污染？）")
             continue
-        latest[record[key]] = record
-    assert latest, f"{path} 里没有可用的 {mode} 记录"
-    points = [latest[value] for value in sorted(latest)]
+        points.append(record)
+    assert points, f"{path} 里没有可用的 {mode} 记录"
     for field in FIXED_FIELDS[mode]:
         # 用 get：早期 jsonl 没记 num_extra_experts，全缺算一致、新旧混存才报
         values = {point.get(field) for point in points}
         assert len(values) == 1, f"扫描点 {field} 不一致：{values}；同一个 jsonl 混了不同配置，按 tag 分开存"
-    return points
+    # Validate before deduplication, which could hide conflicting reruns of the same point.
+    latest = {point[key]: point for point in points}
+    return [latest[value] for value in sorted(latest)]
 
 
 def decode_tau(points: list[dict], draft_acceptance: float) -> float:
diff --git a/tests/test_plot_pareto_config.py b/tests/test_plot_pareto_config.py
new file mode 100644
index 0000000..a193dc9
--- /dev/null
+++ b/tests/test_plot_pareto_config.py
@@ -0,0 +1,57 @@
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from examples.sweep.plot_pareto import load_points
+
+pytestmark = [pytest.mark.ci, pytest.mark.ci_npu]
+
+
+def _point(mode: str, batch: int, throughput: float = 100.0) -> dict:
+    return {
+        "model_name": "model-a",
+        "ep_size": 8,
+        "cp": 1,
+        "context_length": 32768,
+        "nextn": 5,
+        "mtp_varlen": False,
+        "yoco_clip": 140,
+        "num_gpus": 1,
+        "best_width": 224,
+        "best_height": 224,
+        "decode_num_requests": batch,
+        "prefill_batch_size": batch,
+        "num_images": batch,
+        f"{mode}_tokens_per_s_per_gpu": throughput,
+    }
+
+
+@pytest.mark.parametrize(
+    ("mode", "field", "different"),
+    [("decode", "model_name", "model-b"), ("prefill", "cp", 2), ("encoder", "best_width", 448)],
+)
+@pytest.mark.parametrize("reverse", [False, True])
+@pytest.mark.parametrize("same_batch", [False, True])
+def test_rejects_mixed_fixed_configs(tmp_path: Path, mode: str, field: str, different: str | int, reverse: bool, same_batch: bool) -> None:
+    rows = [_point(mode, 8), _point(mode, 8 if same_batch else 16) | {field: different}]
+    if reverse:
+        rows.reverse()
+    path = tmp_path / "results.jsonl"
+    path.write_text("".join(json.dumps(row) + "\n" for row in rows), encoding="utf-8")
+
+    with pytest.raises(AssertionError, match=field):
+        load_points(path, mode)
+
+
+@pytest.mark.parametrize("mode", ["decode", "prefill", "encoder"])
+def test_same_config_reruns_keep_latest_and_sort(tmp_path: Path, mode: str) -> None:
+    first = _point(mode, 8)
+    larger = _point(mode, 16)
+    rerun = _point(mode, 8, throughput=200.0)
+    path = tmp_path / "results.jsonl"
+    path.write_text("".join(json.dumps(row) + "\n" for row in [larger, first, rerun]), encoding="utf-8")
+
+    assert load_points(path, mode) == [rerun, larger]
