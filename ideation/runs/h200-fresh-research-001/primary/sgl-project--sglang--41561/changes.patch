+            block_size,
+            is_bigram: false,
+            producer_ready: true,
+            workers: vec![WireWorker {
+                url: carrier.into(),
+                dp_rank: 0,
+            }],
+            cursors: vec![(0, 5)],
+            nodes: vec![SnapshotNode {
+                parent: None,
+                block_hash: 111,
+                workers: vec![0],
+                tiers: vec![],
+            }],
+            empty_ranks: vec![],
+        }
+    }
