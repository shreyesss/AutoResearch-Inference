+    if runs:
+        backend, _ = _select_with(monkeypatch, "humming", name)
+        assert backend == Mxfp4MoeBackend.HUMMING
+    else:
+        with pytest.raises(ValueError, match="Humming MoE cannot run"):
+            _select_with(monkeypatch, "humming", name)
