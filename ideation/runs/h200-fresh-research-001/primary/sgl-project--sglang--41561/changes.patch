+        kwargs = dict(sparsity=0.8, softmax_scale=HEAD_DIM**-0.5)
+        index = router.route(q, k, **kwargs).index[:, tail].sort(dim=-1).values
+        q, k = q[:, :, tail].contiguous(), k[:, :, tail].contiguous()
+        ref = router.route(q, k, **kwargs).index.sort(dim=-1).values
