+            ((1, 4), "swa_edges", 5),
+            ((4, 1), "paired", 7),
+            ((1, 1), "swa_internal", 7),
+        ):
+            with self.subTest(ratio=ratio, pattern=pattern):
+                a, kv, mk = build_geometry(1, ratio, True, pattern, True)
