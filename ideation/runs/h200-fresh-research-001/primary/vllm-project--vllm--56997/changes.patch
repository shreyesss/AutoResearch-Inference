-        HummingNvFp4LinearKernel,
         MarlinNvFp4LinearKernel,
         FlashInferTrtllmNvFp4LinearKernel,
         FlashInferCudnnNvFp4LinearKernel,
@@ -564,6 +580,7 @@ def _resolve_backend_kernels(
         B12xNvFp4LinearKernel,
