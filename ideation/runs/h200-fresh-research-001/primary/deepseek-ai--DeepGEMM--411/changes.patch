+
+                float weight_r0 = 0.0f, weight_r1 = 0.0f;
+                if constexpr (kNumMaxTokensPerRank <= 1024) {
+                    const int topk_weight_src_lane = static_cast<int>(lane_idx - col_idx);
+                    if (col_idx == 0) {
