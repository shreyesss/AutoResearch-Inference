+def prepare_draft_extend_layout(seq_lens, num_draft_tokens, with_mrope):
+    bs = seq_lens.numel()
+    prefix = torch.empty((bs,), dtype=torch.int32, device=seq_lens.device)
+    extend = torch.empty_like(prefix)
